import "Media/AsyncMediaPlayerStateChangedEventArgs.idl";
import "Media/AsyncMediaPlayerDurationChangedEventArgs.idl";
import "Media/AsyncMediaPlayerPositionChangedEventArgs.idl";
import "Media/AsyncMediaPlayerStreamSelectedEventArgs.idl";
import "Media/AsyncMediaPlayerBufferingEventArgs.idl";
import "Media/AsyncMediaPlayerSwapChain.idl";
import "Media/AsyncMediaPlayerOptions.idl";
import "VideoAnimation.idl";

namespace Telegram.Native.Media
{
    interface IAsyncMediaPlayerSource requires Telegram.Native.IVideoAnimationSource
    {
        void Open();
        void Close();
    };

    interface IAsyncMediaPlayerRendition
    {
        Int32 Width{ get; };
        Int32 Height{ get; };
        Int64 Size{ get; };

        Boolean HasPlaylist{ get; };

        // Called on a player thread, and expected to block until the playlist is downloaded.
        // Empty when there is none.
        String LoadPlaylist();

        // Called on another thread when the player closes, to end a LoadPlaylist still waiting.
        void CancelPlaylist();

        IAsyncMediaPlayerSource CreateSource();

        // Bytes per second the source last created has been downloading at, zero while unknown.
        Double DownloadSpeed{ get; };
    };


    [default_interface]
    runtimeclass AsyncMediaPlayer
    {
        AsyncMediaPlayer(AsyncMediaPlayerOptions options);
        AsyncMediaPlayer(AsyncMediaPlayerOptions options, AsyncMediaPlayerSwapChain context);

        AsyncMediaPlayerSwapChain Context{ get; };

        void Play(IAsyncMediaPlayerSource stream);
        //[default_overload]
        //void Play(IAsyncMediaPlayerSource stream, Double position);
        void Play(Windows.Foundation.Collections.IVectorView<IAsyncMediaPlayerRendition> renditions, Int32 rendition, Boolean automatic, Double position);
        void Play();
        void Stop();
        void Pause();
        void Pause(Boolean pause);
        void Toggle();
        void Close();

        AsyncMediaPlayerState State{ get; };
        Boolean IsPlaying{ get; };

        Double Duration{ get; };
        Double Position;

        void Seek(Double value, Boolean relative);

        // Reaching the end goes back to the start, from the frame past it rather than once the
        // next position is reported. An end not past the start turns it off.
        void SetLoop(Double start, Double end);

        Double Rate;
        Double Volume;
        Boolean Mute;

        Int32 Rendition{ get; };
        Boolean IsRenditionAutomatic{ get; };

        // -1 hands the choice back to the player.
        void SelectRendition(Int32 rendition);

        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, AsyncMediaPlayerStateChangedEventArgs> StateChanged;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> VideoOut;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, AsyncMediaPlayerStreamSelectedEventArgs> StreamSelected;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> EndReached;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, AsyncMediaPlayerBufferingEventArgs> Buffering;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, AsyncMediaPlayerPositionChangedEventArgs> PositionChanged;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, AsyncMediaPlayerDurationChangedEventArgs> DurationChanged;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> Playing;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> Paused;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> Stopped;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> VolumeChanged;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> EncounteredError;
        event Windows.Foundation.TypedEventHandler<AsyncMediaPlayer, IInspectable> RenditionChanged;
    }
}
