    runtimeclass AsyncMediaPlayerSwapChain : Windows.Foundation.IClosable
    {
        AsyncMediaPlayerSwapChain();
        AsyncMediaPlayerSwapChain(Boolean create);

        Boolean IsLoaded{ get; };

        void Clear();

        Boolean Create();
