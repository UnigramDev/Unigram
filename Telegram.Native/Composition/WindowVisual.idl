namespace Telegram.Native.Composition
{
    [default_interface]
    runtimeclass WindowVisual
    {
        static Boolean IsValid(Windows.UI.WindowId windowId, out String title);
        static WindowVisual Create(Windows.UI.WindowId windowId, Windows.UI.WindowId destinationId, UIComposition.Compositor compositor, Single rasterizationScale);

        static UInt32 GetWindowProcessId(Windows.UI.WindowId windowId);
        // The top-level window one belongs to: a CoreWindow's frame, a WinUI window itself.
        static Windows.UI.WindowId GetRootWindowId(Windows.UI.WindowId windowId);

#ifdef WINUI3
        // The shared thumbnail Create builds needs a DirectComposition device, which the Windows
        // App SDK compositor is not, so the WinUI picker shows a still of the window instead,
        // scaled to fit maxWidth by maxHeight physical pixels. Null if the window cannot be drawn.
        static Windows.Graphics.Imaging.SoftwareBitmap CaptureSnapshot(Windows.UI.WindowId windowId, Int32 maxWidth, Int32 maxHeight);
#endif

        UIComposition.Visual Child{ get; };
        // Z carries the rasterization scale of the element showing the thumbnail: DWM
        // rasterizes it in physical pixels, and the visual has no way of asking.
        Windows.Foundation.Numerics.Vector3 Size;
    }
}
