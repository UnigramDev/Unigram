import "VideoAnimation.idl";

namespace Telegram.Native
{
    [default_interface]
    runtimeclass CachedVideoAnimation : Windows.Foundation.IClosable
    {
		static CachedVideoAnimation LoadFromFile(IVideoAnimationSource file, Int32 width, Int32 height, Boolean fit, Boolean precache, Boolean limitFps);

        // No Cache/IsReadyToCache: the animation queues its own build after the first frame it
        // decodes itself. IsCaching stays, because that build walks the decoder a direct render
        // would use, so the caller does have to stand aside.
        void RenderSync(Windows.Storage.Streams.IBuffer bitmap, out Double seconds, out Boolean completed);
        void Stop();

        void Seek(Double seconds);

        Double FrameRate{ get; };
        Int32 TotalFrame{ get; };
        Boolean IsCaching{ get; };

        Int32 PixelWidth{ get; };
        Int32 PixelHeight{ get; };
        Int32 Rotation{ get; };
    }
}
