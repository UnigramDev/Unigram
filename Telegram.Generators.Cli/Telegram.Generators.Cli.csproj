<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MSBuild half of TdSchemaMode: the same emitter SchemaGenerator uses, run before
       CoreCompile so the schema is compiled as ordinary source. An exe rather than an MSBuild
       task on purpose - a task assembly is loaded and locked by the build node, so rebuilding
       this project fails until the nodes are killed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <IsPublishable>false</IsPublishable>
    <!-- NETSDK1150: the app is self-contained, and a self-contained executable may not reference a
         non self-contained one. That rule is about an exe the app would carry and run; this one is
         a build tool the app only invokes through Exec, so it opts out of the check the same way
         the SDK opts out for a Blazor wasm exe. Flows to the referencing project because it is an
         AdditionalTargetFrameworkInfoProperty. -->
    <ShouldBeValidatedAsExecutableReference>false</ShouldBeValidatedAsExecutableReference>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not PrivateAssets, unlike the analyzer project: SchemaGenerator implements
         IIncrementalGenerator, so loading the type needs Roslyn present at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <ProjectReference Include="..\Telegram.Generators\Telegram.Generators.csproj" />
  </ItemGroup>

</Project>
