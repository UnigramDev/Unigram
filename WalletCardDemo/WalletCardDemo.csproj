  <!-- ==================================================================
       Win2D's PixelShaderEffect takes a shader compiled for the D2D custom
       effect ABI, which fxc has to produce. There is no MSBuild item type
       for that, so drive fxc directly and let it run before the packaging
       step that copies Content in.

       ps_4_0 is deliberate: it is the floor D2D custom effects run on, and
       PixelShaderEffect.IsSupported is false below feature level 10, which
       WalletCardView already falls back for.
       ================================================================== -->
  <PropertyGroup>
    <!-- WindowsSdkDir is not set for a UAP C# project, so go to the kit root
         the same way the SDK targets do. -->
    <WindowsKitsRoot10 Condition="'$(WindowsKitsRoot10)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry32, RegistryView.Default))</WindowsKitsRoot10>
    <FxcPath Condition="'$(FxcPath)' == ''">$(WindowsKitsRoot10)bin\$(TargetPlatformVersion)\x64\fxc.exe</FxcPath>
    <D2DShaderIncludePath Condition="'$(D2DShaderIncludePath)' == ''">$(WindowsKitsRoot10)Include\$(TargetPlatformVersion)\um</D2DShaderIncludePath>
  </PropertyGroup>
  <Target Name="CompileCardShaders"
          BeforeTargets="BeforeBuild"
          Inputs="Shaders\CardFront.hlsl"
          Outputs="Shaders\CardFront.bin">
    <!-- D2D_ENTRY/D2D_FULL_SHADER are what make d2d1effecthelpers emit the
         SV_TARGET wrapper around D2D_PS_ENTRY; without them fxc reports
         "entrypoint not found". -->
    <Exec Command="&quot;$(FxcPath)&quot; /nologo /T ps_4_0 /E main /D D2D_ENTRY=main /D D2D_FULL_SHADER /I &quot;$(D2DShaderIncludePath)&quot; /Fo &quot;Shaders\CardFront.bin&quot; &quot;Shaders\CardFront.hlsl&quot;" />
  </Target>
</Project>
