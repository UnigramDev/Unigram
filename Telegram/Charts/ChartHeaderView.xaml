<UserControl x:Class="Telegram.Charts.ChartHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Telegram.Charts"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Label1"
                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                   TextAlignment="Center"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="0,8,0,8"
                   Grid.Column="1" />
        <TextBlock x:Name="Label2"
                   Style="{StaticResource BaseTextBlockStyle}"
                   TextAlignment="Center"
                   Margin="0,8,8,8" />

        <HyperlinkButton x:Name="Back"
                         Click="Back_Click"
                         Visibility="Collapsed"
                         HorizontalAlignment="Left"
                         BorderThickness="0"
                         Padding="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71F;"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="{StaticResource GlyphMediumFontSize}"
                           Margin="0,0,8,-2"
                           VerticalAlignment="Center" />
                <TextBlock Text="{CustomResource ZoomOut}"
                           FontWeight="SemiBold"
                           Margin="0,8,8,8" />
            </StackPanel>
        </HyperlinkButton>
    </Grid>
</UserControl>
