<local:HostedPage x:Class="Telegram.Views.Chats.ChatStatisticsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:cells="using:Telegram.Controls.Cells"
                  xmlns:selectors="using:Telegram.Selectors"
                  xmlns:td="using:Telegram.Td.Api"
                  xmlns:local="using:Telegram.Views"
                  mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SlideNavigationTransitionInfo Effect="FromRight" />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Page.Resources>
        <DataTemplate x:Key="PostTemplate">
            <Grid Padding="12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Stretch="UniformToFill"
                       Width="36"
                       Height="36"
                       Margin="0,0,12,0"
                       Grid.RowSpan="2" />
                <controls:ProfilePicture Size="36"
                                         Margin="0,0,12,0"
                                         Grid.RowSpan="2" />

                <controls:FormattedTextBlock FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                             TextWrapping="NoWrap"
                                             TextTrimming="CharacterEllipsis"
                                             MaxLines="1"
                                             AutoFontSize="False"
                                             IsTextSelectionEnabled="False"
                                             VerticalAlignment="Bottom"
                                             Grid.Column="1" />
                <TextBlock VerticalAlignment="Top"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Grid.Column="1"
                           Grid.Row="1"
                           MaxLines="1" />

                <TextBlock VerticalAlignment="Bottom"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           TextAlignment="Right"
                           Margin="12,0,0,0"
                           Grid.Column="2"
                           MaxLines="1" />
                <TextBlock VerticalAlignment="Top"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           TextAlignment="Right"
                           Margin="12,0,0,0"
                           Grid.Column="2"
                           Grid.Row="1"
                           MaxLines="1" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserTemplate">
            <Grid Padding="12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:ProfilePicture Size="36"
                                         Margin="0,0,12,0"
                                         Grid.RowSpan="2" />

                <TextBlock FontFamily="{ThemeResource EmojiThemeFontFamily}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Bottom"
                           Grid.Column="1" />
                <TextBlock VerticalAlignment="Top"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Grid.Column="1"
                           Grid.Row="1"
                           MaxLines="1" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChannelOverviewTemplate"
                      x:DataType="td:ChatStatisticsChannel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:ChatStatisticsOverview Title="{CustomResource FollowersChartTitle}"
                                                 Value="{x:Bind MemberCount}" />

                <controls:ChatStatisticsOverview Title="{CustomResource EnabledNotifications}"
                                                 Percentage="{x:Bind EnabledNotificationsPercentage}"
                                                 Grid.Column="1" />

                <controls:ChatStatisticsOverview Title="{CustomResource ViewsPerPost}"
                                                 Value="{x:Bind MeanMessageViewCount}"
                                                 Grid.Row="1" />

                <controls:ChatStatisticsOverview Title="{CustomResource SharesPerPost}"
                                                 Value="{x:Bind MeanMessageShareCount}"
                                                 Grid.Column="1"
                                                 Grid.Row="1" />

                <controls:ChatStatisticsOverview Title="{CustomResource ReactionsPerPost}"
                                                 Value="{x:Bind MeanMessageReactionCount}"
                                                 Grid.Row="2" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SupergroupOverviewTemplate"
                      x:DataType="td:ChatStatisticsSupergroup">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:ChatStatisticsOverview Title="{CustomResource MembersOverviewTitle}"
                                                 Value="{x:Bind MemberCount}" />

                <controls:ChatStatisticsOverview Title="{CustomResource MessagesOverview}"
                                                 Value="{x:Bind MessageCount}"
                                                 Grid.Column="1" />

                <controls:ChatStatisticsOverview Title="{CustomResource ViewingMembers}"
                                                 Value="{x:Bind ViewerCount}"
                                                 Grid.Row="1" />

                <controls:ChatStatisticsOverview Title="{CustomResource PostingMembers}"
                                                 Value="{x:Bind SenderCount}"
                                                 Grid.Column="1"
                                                 Grid.Row="1" />
            </Grid>
        </DataTemplate>

        <ControlTemplate x:Key="NestedListViewTemplate"
                         TargetType="ListView">
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                <ItemsPresenter Header="{TemplateBinding Header}"
                                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                HeaderTransitions="{TemplateBinding HeaderTransitions}"
                                Footer="{TemplateBinding Footer}"
                                FooterTemplate="{TemplateBinding FooterTemplate}"
                                FooterTransitions="{TemplateBinding FooterTransitions}"
                                Padding="{TemplateBinding Padding}" />
            </Border>
        </ControlTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <controls:TableListView x:Name="ScrollingHost"
                                ItemsSource="{x:Bind ViewModel.TopInviters}"
                                ItemTemplate="{StaticResource UserTemplate}"
                                IsItemClickEnabled="True"
                                ItemClick="OnItemClick"
                                ContainerContentChanging="OnContainerContentChanging"
                                SelectionMode="None"
                                Padding="0,0,0,62">
            <ListView.Header>
                <controls:TableListView ItemsSource="{x:Bind ViewModel.TopAdministrators}"
                                        ItemTemplate="{StaticResource UserTemplate}"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnItemClick"
                                        ContainerContentChanging="OnContainerContentChanging"
                                        SelectionMode="None"
                                        Template="{StaticResource NestedListViewTemplate}">
                    <controls:TableListView.Header>
                        <controls:TableListView ItemsSource="{x:Bind ViewModel.TopSenders}"
                                                ItemTemplate="{StaticResource UserTemplate}"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnItemClick"
                                                ContainerContentChanging="OnContainerContentChanging"
                                                SelectionMode="None"
                                                Template="{StaticResource NestedListViewTemplate}">
                            <controls:TableListView.Header>
                                <controls:TableListView ItemsSource="{x:Bind ViewModel.Interactions}"
                                                        ItemTemplate="{StaticResource PostTemplate}"
                                                        IsItemClickEnabled="True"
                                                        ItemClick="OnItemClick"
                                                        ContainerContentChanging="OnContainerContentChanging"
                                                        SelectionMode="None"
                                                        Template="{StaticResource NestedListViewTemplate}">
                                    <controls:TableListView.Header>
                                        <ListView ItemsSource="{x:Bind ViewModel.Items}"
                                                  ContainerContentChanging="OnContainerContentChanging"
                                                  SelectionMode="None"
                                                  Template="{StaticResource NestedListViewTemplate}">
                                            <ListView.Header>
                                                <controls:SettingsPanel IsHeader="True"
                                                                        HasTopPadding="False">
                                                    <controls:StickyHeader x:Name="Header"
                                                                           Text="{CustomResource Statistics}" />

                                                    <controls:HeaderedControl Header="{CustomResource StatisticOverview}"
                                                                              Footer="{x:Bind ConvertPeriod(ViewModel.Period.StartDate, ViewModel.Period.EndDate), Mode=OneWay}"
                                                                              Background="{ThemeResource SettingsItemBackground}"
                                                                              BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                                                              BorderThickness="1"
                                                                              CornerRadius="4"
                                                                              IsFooterAtBottom="False">
                                                        <ContentControl Content="{x:Bind ViewModel.Statistics, Mode=OneWay, FallbackValue=''}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        VerticalContentAlignment="Stretch">
                                                            <ContentControl.ContentTemplateSelector>
                                                                <selectors:ChatStatisticsOverviewTemplateSelector ChannelTemplate="{StaticResource ChannelOverviewTemplate}"
                                                                                                                  SupergroupTemplate="{StaticResource SupergroupOverviewTemplate}" />
                                                            </ContentControl.ContentTemplateSelector>
                                                        </ContentControl>
                                                    </controls:HeaderedControl>
                                                </controls:SettingsPanel>
                                            </ListView.Header>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <cells:ChartCell Margin="24,16,24,0" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                            <ListView.Footer>
                                                <Grid>
                                                    <Grid Visibility="{x:Bind ViewModel.Interactions.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          MaxWidth="1000"
                                                          Margin="24,16,24,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{CustomResource RecentPosts}"
                                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                                   Margin="0,8,8,8" />
                                                        <TextBlock Text="{x:Bind ConvertPeriod(ViewModel.Period.StartDate, ViewModel.Period.EndDate), Mode=OneWay}"
                                                                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="0,8,0,8"
                                                                   Grid.Column="1" />
                                                    </Grid>
                                                    <Grid Visibility="{x:Bind ViewModel.TopSenders.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          MaxWidth="1000"
                                                          Margin="24,16,24,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{CustomResource TopMembers}"
                                                                   Style="{StaticResource BaseTextBlockStyle}"
                                                                   Margin="0,8,8,8" />
                                                        <TextBlock Text="{x:Bind ConvertPeriod(ViewModel.Period.StartDate, ViewModel.Period.EndDate), Mode=OneWay}"
                                                                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                                                                   VerticalAlignment="Bottom"
                                                                   HorizontalAlignment="Left"
                                                                   Margin="0,8,0,8"
                                                                   Grid.Column="1" />
                                                    </Grid>
                                                </Grid>
                                            </ListView.Footer>
                                        </ListView>
                                    </controls:TableListView.Header>
                                </controls:TableListView>
                            </controls:TableListView.Header>
                            <controls:TableListView.Footer>
                                <Grid Visibility="{x:Bind ViewModel.TopAdministrators.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      MaxWidth="1000"
                                      Margin="24,16,24,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{CustomResource TopAdmins}"
                                               Style="{StaticResource BaseTextBlockStyle}"
                                               Margin="0,8,8,8" />
                                    <TextBlock Text="{x:Bind ConvertPeriod(ViewModel.Period.StartDate, ViewModel.Period.EndDate), Mode=OneWay}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}"
                                               VerticalAlignment="Bottom"
                                               HorizontalAlignment="Left"
                                               Margin="0,8,0,8"
                                               Grid.Column="1" />
                                </Grid>
                            </controls:TableListView.Footer>
                        </controls:TableListView>
                    </controls:TableListView.Header>
                    <controls:TableListView.Footer>
                        <Grid Visibility="{x:Bind ViewModel.TopInviters.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              MaxWidth="1000"
                              Margin="24,16,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{CustomResource TopInviters}"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       Margin="0,8,8,8" />
                            <TextBlock Text="{x:Bind ConvertPeriod(ViewModel.Period.StartDate, ViewModel.Period.EndDate), Mode=OneWay}"
                                       Style="{StaticResource InfoCaptionTextBlockStyle}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"
                                       Margin="0,8,0,8"
                                       Grid.Column="1" />
                        </Grid>
                    </controls:TableListView.Footer>
                </controls:TableListView>
            </ListView.Header>
        </controls:TableListView>

        <Grid Background="{ThemeResource PageBackgroundDarkBrush}"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <muxc:ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                               Width="48"
                               Height="48" />
        </Grid>

        <controls:StickyHeaderChrome Header="{x:Bind Header}" />
    </Grid>
</local:HostedPage>
