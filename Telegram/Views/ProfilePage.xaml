<local:HostedPage x:Class="Telegram.Views.ProfilePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:messages="using:Telegram.Controls.Messages"
                  xmlns:local="using:Telegram.Views"
                  xmlns:chats="using:Telegram.Controls.Chats"
                  mc:Ignorable="d"
                  ShowHeader="False"
                  NavigationMode="Root">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <EntranceNavigationTransitionInfo />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <chats:ChatBackgroundControl x:Name="BackgroundRoot" />

        <ScrollViewer x:Name="ScrollingHost"
                      SizeChanged="OnSizeChanged"
                      DirectManipulationStarted="OnDirectManipulationStarted"
                      ViewChanged="OnViewChanged">
            <Grid>
                <StackPanel x:Name="Header"
                            SizeChanged="ProfileHeader_SizeChanged"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="1">
                    <controls:ProfileHeader x:Name="ProfileHeader"
                                            Margin="0,0,0,16"
                                            Canvas.ZIndex="2" />

                    <Grid x:Name="HeaderPanel"
                          Opacity="{x:Bind ViewModel.Items.Count, Mode=OneWay}"
                          Canvas.ZIndex="2">
                        <Grid x:Name="TabsPanel"
                              HorizontalAlignment="Center"
                              CornerRadius="20"
                              MaxWidth="1000"
                              Height="40"
                              Margin="24,0,24,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CardBackground"
                                    Background="{ThemeResource SettingsItemBackground}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Grid.ColumnSpan="2" />
                            <controls:TopNavView x:Name="Navigation"
                                                 IsItemClickEnabled="True"
                                                 ItemClick="Navigation_ItemClick"
                                                 SelectionChanged="Navigation_SelectionChanged"
                                                 PrepareContainerForItem="Navigation_PrepareContainerForItem"
                                                 ItemContextRequested="Navigation_ItemContextRequested"
                                                 ItemsSource="{x:Bind ViewModel.Items}"
                                                 SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                                 Height="48"
                                                 Padding="8,0,8,4"
                                                 Margin="-4">
                                <controls:TopNavView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,8,0" />
                                    </ItemsPanelTemplate>
                                </controls:TopNavView.ItemsPanel>
                            </controls:TopNavView>

                            <!-- Outside the strip rather than its footer, so it stays in view when the tabs overflow and scroll. -->
                            <StackPanel x:Name="SearchSlot"
                                        Orientation="Horizontal"
                                        Grid.Column="1">
                                <Border Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        Width="1"
                                        Height="20"
                                        Margin="-12,0,0,0"
                                        VerticalAlignment="Center" />

                                <controls:GlyphButton x:Name="SearchButton"
                                                      Click="Search_Click"
                                                      Glyph="&#xE721;"
                                                      AutomationProperties.Name="{CustomResource Search}"
                                                      ToolTipService.ToolTip="{CustomResource Search}"
                                                      Width="48"
                                                      Height="40"
                                                      CornerRadius="16"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="False" />
                            </StackPanel>

                            <Grid x:Name="SearchRoot"
                                  x:Load="False"
                                  Margin="4,0"
                                  Grid.ColumnSpan="2">
                                <TextBox x:Name="SearchField"
                                         TextChanged="SearchField_TextChanged"
                                         BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                         Style="{StaticResource NoDeleteTextBoxStyle}"
                                         InputScope="Search"
                                         Padding="34,3,36,6"
                                         CornerRadius="16"
                                         Height="32"
                                         VerticalAlignment="Center" />

                                <controls:GlyphButton Glyph="&#xE721;"
                                                      FontSize="16"
                                                      Width="36"
                                                      Height="32"
                                                      IsTabStop="False"
                                                      IsHitTestVisible="False"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center" />

                                <controls:GlyphButton Click="SearchClose_Click"
                                                      Glyph="&#xE711;"
                                                      FontSize="16"
                                                      AutomationProperties.Name="{CustomResource AccDescrCloseSearch}"
                                                      ToolTipService.ToolTip="{CustomResource AccDescrCloseSearch}"
                                                      Width="32"
                                                      Height="32"
                                                      CornerRadius="12"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <messages:MessageService x:Name="DateHeader"
                                                 Visibility="Collapsed"
                                                 VerticalAlignment="Bottom"
                                                 Margin="0,0,0,-30">
                            <TextBlock x:Name="DateHeaderLabel"
                                       Text="31 dicembre 2017"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </messages:MessageService>
                    </Grid>
                </StackPanel>

                <Frame x:Name="MediaFrame"
                       Navigating="OnNavigating"
                       Navigated="OnNavigated" />
            </Grid>
        </ScrollViewer>

        <Grid MaxWidth="1000"
              Margin="24,0">
            <controls:BackButton x:Name="BackButton"
                                 Margin="-20,18,0,0"
                                 CornerRadius="20"
                                 Glyph="&#xE93E;"
                                 Width="48"
                                 Height="48" />

            <Border x:Name="MenuRoot"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <controls:MoreButton x:Name="Menu"
                                     Click="Menu_ContextRequested" />
            </Border>
            <Grid x:Name="EditRoot"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Height="48"
                  Margin="0,16,0,0"
                  Visibility="Collapsed">
                <Button Click="Edit_Click"
                        Content="{CustomResource Edit}" />
            </Grid>
        </Grid>

        <ToolTip x:Name="ToolTip"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Visibility="Collapsed"
                 Margin="0,88,16,0">
            <controls:AnimatedTextBlock x:Name="ToolTipContent"
                                        TextAlignment="Right"
                                        TextWrapping="WrapWholeWords" />
        </ToolTip>

        <Grid x:Name="ManagePanel"
              VerticalAlignment="Bottom"
              Visibility="Collapsed"
              Margin="24,0,24,8"
              Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ManageCard"
                    Background="{ThemeResource PageSubHeaderBackgroundBrush2}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Grid.ColumnSpan="5" />

            <controls:GlyphButton x:Name="ButtonManage"
                                  Glyph="&#xE711;"
                                  Click="{x:Bind ViewModel.UnselectMessages}"
                                  CornerRadius="20" />

            <controls:AnimatedTextBlock x:Name="ManageCount"
                                        Text="{x:Bind ConvertSelection(ViewModel.SelectedItems.Count), Mode=OneWay}"
                                        TextStyle="{StaticResource BaseTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        Margin="0,-2,0,0"
                                        Grid.Column="1" />

            <controls:GlyphButton x:Name="ButtonForward"
                                  Glyph="&#xE72D;"
                                  Content="{CustomResource Forward}"
                                  Click="{x:Bind ViewModel.ForwardSelectedMessages}"
                                  IsEnabled="{x:Bind ViewModel.CanForwardSelectedMessages, Mode=OneWay}"
                                  Style="{StaticResource GlyphButtonWithLabelStyle}"
                                  CornerRadius="20"
                                  Grid.Column="3" />

            <controls:GlyphButton x:Name="ButtonDelete"
                                  Glyph="&#xE74D;"
                                  Content="{CustomResource Delete}"
                                  Foreground="#df3f40"
                                  Click="{x:Bind ViewModel.DeleteSelectedMessages}"
                                  IsEnabled="{x:Bind ViewModel.CanDeleteSelectedMessages, Mode=OneWay}"
                                  Style="{StaticResource GlyphButtonWithLabelStyle}"
                                  CornerRadius="20"
                                  Grid.Column="4" />
        </Grid>
    </Grid>
</local:HostedPage>
