<local:WalletPopup x:Class="Telegram.Views.Wallet.Popups.WalletSendPopup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:Telegram.Views.Wallet.Popups"
                   xmlns:controls="using:Telegram.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   Padding="24,0,24,24"
                   IsDismissButtonVisible="True"
                   IsOptionsButtonVisible="True"
                   OptionsRequested="More_ContextRequested"
                   PrimaryButtonClick="OnPrimaryButtonClick"
                   ButtonsLayout="Vertical">

    <Grid MinHeight="320">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center"
                    Margin="0,48,0,0">
            <!-- The amount sizes itself to what is typed: a horizontal StackPanel measures its
                 children against infinity, so the field asks for the width of its text and the
                 three parts stay centred together as it grows. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="Prefix"
                           Text="&#xEA7E;"
                           Foreground="{ThemeResource SystemColorControlAccentBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito, ms-appx:///Assets/Fonts/Telegram.ttf#Telegram"
                           FontSize="32"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <!-- Not a TextBox: see AmountTextBlock for why an amount is better drawn than
                     edited. The fraction is two thirds of the whole part, which is the same ratio
                     the card's balance uses. -->
                <controls:AmountTextBlock x:Name="Amount"
                                          TextChanged="Amount_TextChanged"
                                          Placeholder="0"
                                          FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                          FontWeight="SemiBold"
                                          FontSize="32"
                                          FractionFontSize="21"
                                          VerticalAlignment="Center" />

                <TextBlock x:Name="Suffix"
                           Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"
                           FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                           FontWeight="SemiBold"
                           FontSize="32"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>

            <Button x:Name="SwapButton"
                    Click="Swap_Click"
                    CornerRadius="14"
                    Padding="12,4"
                    MinHeight="28"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Converted"
                               Style="{StaticResource InfoBodyTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="SwapGlyph"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               Style="{StaticResource InfoBodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="Validation"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,8,0,0" />

            <!-- The comment as it will travel, in the bubble a message would be in. -->
            <Border x:Name="CommentRoot"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    MinHeight="30"
                    MaxWidth="280"
                    Visibility="Collapsed"
                    Margin="0,12,0,0">
                <TextBlock x:Name="Comment"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="3"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="BalanceLabel"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       TextAlignment="Center" />

            <TextBlock x:Name="FeeLabel"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</local:WalletPopup>
