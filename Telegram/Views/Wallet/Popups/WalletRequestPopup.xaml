<local:WalletPopup x:Class="Telegram.Views.Wallet.Popups.WalletRequestPopup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:controls="using:Telegram.Controls"
                   xmlns:local="using:Telegram.Views.Wallet.Popups"
                   xmlns:wallet="using:Telegram.Services.Wallet"
                   mc:Ignorable="d"
                   Padding="0"
                   PrimaryButtonClick="OnPrimaryButtonClick"
                   SecondaryButtonClick="OnSecondaryButtonClick"
                   IsDismissButtonVisible="True">

    <Grid>
        <Grid.Resources>
            <!-- Here rather than looked up from the app, the way WalletTransactionCell does it: a
                 ThemeResource on the colour keeps it following the theme. -->
            <SolidColorBrush x:Key="AmountReceivedBrush"
                             Color="{ThemeResource SystemFillColorSuccess}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One header for both pages rather than two: the pieces move and resize between them,
             and swapping whole headers would lose the continuity that says it is the same sheet. -->
        <Grid x:Name="Header"
              Padding="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <controls:GlyphButton x:Name="BackButton"
                                  Glyph="&#xE72B;"
                                  Click="Back_Click"
                                  CornerRadius="20"
                                  VerticalAlignment="Top"
                                  Visibility="Collapsed" />

            <StackPanel x:Name="Identity"
                        HorizontalAlignment="Center"
                        Grid.Column="1">
                <controls:ProfilePicture x:Name="Photo"
                                         Size="96"
                                         Margin="0,4,0,12" />

                <TextBlock x:Name="TitleLabel"
                           Text="{CustomResource WalletConfirmAction}"
                           Style="{StaticResource PopupTextBlockStyle}"
                           TextAlignment="Center" />

                <TextBlock x:Name="Domain"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Before anything is loaded. The service message names the dApp and nothing else,
                 so this is all there is to show until the user asks for the rest - and asking is
                 what unlocks the wallet, which is the reason it is a separate step. -->
            <TextBlock x:Name="ReviewLabel"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Padding="24,8,24,16" />

            <!-- Page one: the card is the wallet, so what is about to leave it is drawn on it. -->
            <Grid x:Name="SummaryPage"
                  Padding="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:WalletCard x:Name="Card" />

                <controls:GlyphButton x:Name="DetailsButton"
                                      Glyph="&#xE946;"
                                      Click="Details_Click"
                                      Background="{ThemeResource ContentDialogBackground}"
                                      Width="32"
                                      Height="32"
                                      CornerRadius="8"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,16,16,0" />
            </Grid>

            <!-- Page two: what the request actually says, and what the chain would do with it. -->
            <StackPanel x:Name="DetailsPage"
                        Visibility="Collapsed"
                        Padding="24,8,24,0">
                <TextBlock Text="{CustomResource WalletTransfer}"
                           Style="{StaticResource InfoBodyTextBlockStyle}"
                           Margin="12,0,0,4" />

                <Border Background="{ThemeResource ContentDialogBackground}"
                        CornerRadius="10"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="{ThemeResource PageHeaderHighlightBrush}"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Grid.RowSpan="2" />

                        <TextBlock x:Name="TransferAmount"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   Grid.Column="1" />
                        <TextBlock x:Name="TransferRecipient"
                                   Style="{StaticResource InfoBodyTextBlockStyle}"
                                   Grid.Column="1"
                                   Grid.Row="1" />
                    </Grid>
                </Border>

                <TextBlock x:Name="PreviewHeader"
                           Text="{CustomResource WalletPreview}"
                           Style="{StaticResource InfoBodyTextBlockStyle}"
                           Margin="12,16,0,4" />

                <Border x:Name="PreviewRoot"
                        Background="{ThemeResource ContentDialogBackground}"
                        CornerRadius="10"
                        Padding="12,4">
                    <ItemsControl x:Name="PreviewPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="wallet:WalletRequestAction">
                                <Grid Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Two badges rather than one with a bound brush: which way it
                                         went is the only thing that differs, and a converter to say
                                         so would be more machinery than the difference. -->
                                    <Border Background="{StaticResource AmountReceivedBrush}"
                                            Visibility="{x:Bind IsDeposit}"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            VerticalAlignment="Top"
                                            Margin="0,0,12,0"
                                            Grid.RowSpan="3">
                                        <TextBlock Text="&#xE118;"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <Border Background="{ThemeResource PageHeaderHighlightBrush}"
                                            Visibility="{x:Bind IsWithdraw}"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            VerticalAlignment="Top"
                                            Margin="0,0,12,0"
                                            Grid.RowSpan="3">
                                        <TextBlock Text="&#xE119;"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="{x:Bind ShortAddress}"
                                               Style="{StaticResource BaseTextBlockStyle}"
                                               Grid.Column="1" />

                                    <TextBlock Text="{x:Bind AmountText}"
                                               Style="{StaticResource BaseTextBlockStyle}"
                                               Foreground="{StaticResource AmountReceivedBrush}"
                                               Visibility="{x:Bind IsDeposit}"
                                               VerticalAlignment="Top"
                                               Grid.Column="2" />
                                    <TextBlock Text="{x:Bind AmountText}"
                                               Style="{StaticResource BaseTextBlockStyle}"
                                               Visibility="{x:Bind IsWithdraw}"
                                               VerticalAlignment="Top"
                                               Grid.Column="2" />

                                    <TextBlock Text="[Deposit]"
                                               Style="{StaticResource InfoBodyTextBlockStyle}"
                                               Visibility="{x:Bind IsDeposit}"
                                               Grid.Column="1"
                                               Grid.Row="1" />
                                    <TextBlock Text="[Withdraw]"
                                               Style="{StaticResource InfoBodyTextBlockStyle}"
                                               Visibility="{x:Bind IsWithdraw}"
                                               Grid.Column="1"
                                               Grid.Row="1" />

                                    <!-- The only part of the row the dApp wrote, and the only part
                                         that is not a fact about the chain. -->
                                    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                            Visibility="{x:Bind HasComment}"
                                            CornerRadius="10"
                                            Padding="10,4,10,6"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Grid.Row="2">
                                        <TextBlock Text="{x:Bind Comment}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <TextBlock x:Name="FeeLabel"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       TextAlignment="Center"
                       Margin="24,16,24,8"
                       Grid.Row="1" />
        </Grid>
    </Grid>
</local:WalletPopup>
