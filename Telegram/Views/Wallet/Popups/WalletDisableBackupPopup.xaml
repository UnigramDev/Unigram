<local:WalletPopup x:Class="Telegram.Views.Wallet.Popups.WalletDisableBackupPopup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:local="using:Telegram.Views.Wallet.Popups"
                   mc:Ignorable="d">

    <StackPanel>
        <TextBlock Text="{CustomResource WalletDisableBackupInfo}"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <CheckBox x:Name="UpdatePhrase"
                  Content="{CustomResource WalletUpdateSecretPhrase}"
                  Checked="UpdatePhrase_Toggled"
                  Unchecked="UpdatePhrase_Toggled"
                  Margin="0,16,0,-4" />

        <Border x:Name="PhraseInfo"
                Background="{ThemeResource ContentDialogBackground}"
                CornerRadius="8"
                Visibility="Collapsed"
                Padding="12,8,12,10"
                Margin="0,22,0,0">
            <TextBlock x:Name="PhraseInfoLabel"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>
    </StackPanel>
</local:WalletPopup>
