<local:WalletPopup x:Class="Telegram.Views.Wallet.Popups.WalletConnectedAppsPopup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:Telegram.Views.Wallet.Popups"
                   xmlns:controls="using:Telegram.Controls"
                   xmlns:cells="using:Telegram.Controls.Cells"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   IsDismissButtonVisible="True"
                   Padding="0,24,0,0">

    <controls:TableListView x:Name="ScrollingHost"
                            ItemClick="OnItemClick"
                            IsItemClickEnabled="True"
                            ChoosingItemContainer="OnChoosingItemContainer"
                            ContainerContentChanging="OnContainerContentChanging"
                            SelectionMode="None">
        <ListView.Header>
            <TextBlock Text="{CustomResource WalletActiveConnections}"
                       Style="{StaticResource BaseTextBlockStyle}"
                       MaxWidth="1000"
                       Margin="24,0,24,6" />
        </ListView.Header>
        <ListView.ItemTemplate>
            <DataTemplate>
                <cells:ProfileCell />
            </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.Footer>
            <controls:SettingsFooter Text="{CustomResource WalletConnectedAppsInfo}"
                                     Margin="24,6,24,24" />
        </ListView.Footer>
    </controls:TableListView>
</local:WalletPopup>
