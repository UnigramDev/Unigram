<local:WalletPopup x:Class="Telegram.Views.Wallet.Popups.WalletOAuthPopup"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:Telegram.Views.Wallet.Popups"
                   xmlns:controls="using:Telegram.Controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   Padding="24,0,24,24"
                   IsDismissButtonVisible="True"
                   PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel>
        <controls:ProfilePicture x:Name="Photo"
                                 Size="96"
                                 Margin="0,8,0,0" />

        <TextBlock x:Name="Title"
                   Style="{StaticResource PopupTextBlockStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />

        <TextBlock x:Name="Domain"
                   Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <TextBlock x:Name="Subtitle"
                   Style="{StaticResource BodyTextBlockStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />

        <controls:WalletCard x:Name="Card"
                             MaxWidth="360"
                             Margin="0,16,0,0" />

        <TextBlock Text="{CustomResource WalletConnectPermissionInfo}"
                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />
    </StackPanel>
</local:WalletPopup>
