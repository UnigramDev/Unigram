<controls:ModalPopup x:Class="Telegram.Views.Wallet.Popups.WalletTransactionPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="using:Telegram.Views.Wallet.Popups"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     Padding="24,0,24,24"
                     IsDismissButtonVisible="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- No picture above the amount: the receipt this follows shows what was bought, and a
             transfer has nothing to show but its own numbers. -->
        <StackPanel HorizontalAlignment="Center"
                    Margin="24,24,24,0">
            <TextBlock x:Name="Amount"
                       Style="{StaticResource PopupTextBlockStyle}"
                       TextAlignment="Center" />

            <TextBlock x:Name="Converted"
                       Style="{StaticResource InfoBodyTextBlockStyle}"
                       TextAlignment="Center"
                       Margin="0,-2,0,0" />
        </StackPanel>

        <!-- Beside the dismiss button the template draws at the card's corner: the content is
             inset by the popup's 24 of padding and the button it sits next to is 40 wide, so 16
             of margin is what puts the two side by side. -->
        <controls:MoreButton x:Name="MoreButton"
                             Click="More_ContextRequested"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             CornerRadius="20"
                             Margin="0,0,16,0" />

        <!-- The comment the transfer carried, in the bubble a message would be in. An encrypted
             one is a link under the spoiler rather than a tap on the bubble: a link is reachable
             by keyboard and announced by a screen reader, and a Tapped handler is neither. -->
        <Border x:Name="CommentRoot"
                Background="{ThemeResource MessageBackgroundBrush}"
                CornerRadius="15"
                Padding="12,6"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                Visibility="Collapsed"
                Grid.Row="1">
            <controls:FormattedTextBlock x:Name="Comment"
                                         TextEntityClick="Comment_TextEntityClick"
                                         TextAlignment="Center" />
        </Border>

        <controls:TableView Margin="-8,16,-8,0"
                            Grid.Row="2">
            <!-- Recipient or Sender: only one of the two is true of any transfer, so the header is
                 set with the value rather than being two rows one of which is always empty. -->
            <controls:TableViewItem x:Name="PeerRow"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ProfilePicture x:Name="PeerPhoto"
                                             IsEnabled="False"
                                             Margin="8,4,0,4"
                                             Size="24" />

                    <TextBlock Margin="8,5,4,6"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Grid.Column="1"><Hyperlink UnderlineStyle="None"
                                                          Click="Peer_Click"><Run x:Name="PeerTitle" /></Hyperlink></TextBlock>

                    <Button x:Name="SendCommand"
                            Click="Send_Click"
                            Content="[Send]"
                            Style="{StaticResource BadgeControlButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="4"
                            Grid.Column="2" />
                </Grid>
            </controls:TableViewItem>

            <controls:TableViewItem x:Name="AddressRow"
                                    Header="[Address]"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Twelve groups of four, four to a line: an address is 48 characters, and
                         that is what makes one comparable by eye. The alternation keeps the eye
                         from losing its place between two groups that look alike, and it is
                         declared here so the dimmed half is the theme's own brush. -->
                    <TextBlock x:Name="Address"
                               FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                               FontSize="13"
                               LineHeight="18"
                               Margin="8,5,8,6"><Run x:Name="AddressGroup0" /><Run Text=" " /><Run x:Name="AddressGroup1"
                                                                                                   Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /><Run Text=" " /><Run x:Name="AddressGroup2" /><Run Text=" " /><Run x:Name="AddressGroup3"
                                                                                                                                                                                                                                             Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /><LineBreak /><Run x:Name="AddressGroup4"
                                                                                                                                                                                                                                                                                                                                      Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /><Run Text=" " /><Run x:Name="AddressGroup5" /><Run Text=" " /><Run x:Name="AddressGroup6"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /><Run Text=" " /><Run x:Name="AddressGroup7" /><LineBreak /><Run x:Name="AddressGroup8" /><Run Text=" " /><Run x:Name="AddressGroup9"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /><Run Text=" " /><Run x:Name="AddressGroup10" /><Run Text=" " /><Run x:Name="AddressGroup11"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /></TextBlock>

                    <!-- Where the Send pill lands when there is no Telegram user to put it beside. -->
                    <Button x:Name="AddressSendCommand"
                            Click="Send_Click"
                            Content="[Send]"
                            Style="{StaticResource BadgeControlButtonStyle}"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Margin="0,8,4,0"
                            Grid.Column="1" />
                </Grid>
            </controls:TableViewItem>

            <controls:TableViewItem x:Name="FeeRow"
                                    Header="[Fee]">
                <!-- Three runs, always the same three, so the colours are set here and the code
                     only fills in the text. -->
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"><Run x:Name="FeeGlyph"
                                                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                            Foreground="{ThemeResource SystemColorControlAccentBrush}" /><Run x:Name="FeeAmount" /><Run x:Name="FeeConverted"
                                                                                                                                                                        Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}" /></TextBlock>
            </controls:TableViewItem>

            <controls:TableViewItem x:Name="DateRow"
                                    Header="[Date]" />
        </controls:TableView>
    </Grid>
</controls:ModalPopup>
