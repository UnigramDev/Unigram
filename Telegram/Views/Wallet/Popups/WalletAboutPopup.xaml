<controls:ModalPopup x:Class="Telegram.Views.Wallet.Popups.WalletAboutPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:common="using:Telegram.Common"
                     xmlns:controls="using:Telegram.Controls"
                     mc:Ignorable="d"
                     Padding="0"
                     IsDismissButtonVisible="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
        <StackPanel>
            <controls:AnimatedImage Source="ms-appx:///Assets/Animations/WalletAbout.tgs"
                                    IsCachingEnabled="False"
                                    AutoPlay="True"
                                    FrameSize="120,120"
                                    DecodeFrameType="Logical"
                                    LoopCount="1"
                                    Width="120"
                                    Height="120"
                                    Margin="0,12,0,8" />

            <TextBlock Text="[How It Works]"
                       Style="{StaticResource PopupTextBlockStyle}"
                       TextAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="12,0,12,4" />

            <TextBlock common:TextBlockHelper.Markdown="[Only you control your funds -&#x0a;no one else has access.]"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center"
                       Grid.Row="2" />

            <controls:PopupInfo Title="[Send Money Instantly]"
                                Subtitle="[Send Grams in any chat, just like sharing a photo.]"
                                Glyph="&#xEB2B;"
                                Margin="0,12,0,0" />
            <controls:PopupInfo Title="[No Fees]"
                                Subtitle="[First 5 transfers each day are free, the rest cost almost nothing.]"
                                Glyph="&#xEA9D;" />
            <controls:PopupInfo Title="[Blockchain Verified]"
                                Subtitle="[All transactions are recorded and verifiable on a public ledger.]"
                                Glyph="&#xEA8B;" />

            <controls:SettingsFooter x:Name="Footer"
                                     Click="Footer_Click"
                                     TextAlignment="Center"
                                     Margin="12,8,12,24" />
        </StackPanel>
    </ScrollViewer>
</controls:ModalPopup>
