<views:HostedPage x:Class="Telegram.Views.Wallet.WalletPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:Telegram.Views.Wallet"
                  xmlns:views="using:Telegram.Views"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  NavigationMode="Root">

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <controls:TableListView x:Name="ScrollingHost">
            <ListView.Header>
                <controls:SettingsPanel IsHeader="True">
                    <controls:SettingsPanel.Transform3D>
                        <PerspectiveTransform3D Depth="800" />
                    </controls:SettingsPanel.Transform3D>

                    <controls:AspectView x:Name="Card"
                                         Background="#0079FF"
                                         Margin="24,0"
                                         MaxWidth="360">
                        <!-- Carries the conic gradient so it can rotate on its own
                             while the card tilts. Oversized and clipped by AttachTilt. -->
                        <Rectangle x:Name="Sheen"
                                   Visibility="Visible" />
                        <!--<Image Source="ms-appx:///Views/Wallet/Card.png"
                               VerticalAlignment="Bottom"
                               Visibility="Collapsed" />
                        <Image Source="ms-appx:///Views/Wallet/Card.png"
                               VerticalAlignment="Top"
                               Visibility="Collapsed" />-->
                        <Viewbox>
                            <!--<Grid Width="360"
                                  Height="227.333">-->
                            <Grid Width="360"
                                  Height="220">
                                <Grid HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Opacity="0.3">
                                    <!-- box-shadow: 0px 1px 0px 0px rgba(255, 255, 255, 0.06)
                                         is applied in OnLoaded — it needs the glyph
                                         alpha mask, which markup cannot express. -->
                                    <Border x:Name="CardAddressShadow"
                                            RenderTransformOrigin="0.5,0.5"
                                            Opacity="0.6">
                                        <!--<Border.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Border.RenderTransform>-->
                                    </Border>
                                    <TextBlock x:Name="CardAddress"
                                               Text="UQAL 1DVI V82P 5SLL NYPX JENP&#13;JQRF AHRV GKHM HFCR IJYI NQYK"
                                               FontFamily="Cascadia Mono"
                                               FontSize="10"
                                               FontWeight="Normal"
                                               Foreground="#000000"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <Grid Width="48"
                                      Height="36"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      BorderBrush="#28000000"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Margin="0,80,48,0">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="-0.039,0.090"
                                                             EndPoint="1.039,0.910">
                                            <GradientStop Color="#E0BBBDC0"
                                                          Offset="0.0799" />
                                            <GradientStop Color="#E0FFFFFF"
                                                          Offset="0.922" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <!--<TextBlock Text="&#xEACA;"
                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />-->
                                    <Grid Width="16"
                                          Height="16">
                                        <Border Width="7"
                                                Height="7"
                                                BorderThickness="1"
                                                BorderBrush="#1A1A1A"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                CornerRadius="2" />
                                        <Border Width="7"
                                                Height="7"
                                                BorderThickness="1"
                                                BorderBrush="#1A1A1A"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                CornerRadius="2" />
                                        <Border Width="7"
                                                Height="7"
                                                BorderThickness="1"
                                                BorderBrush="#1A1A1A"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="2" />
                                        <Grid Width="7"
                                              Height="7"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom">
                                            <Border Width="2"
                                                    Height="2"
                                                    Background="#1A1A1A"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top" />
                                            <Border Width="2"
                                                    Height="2"
                                                    Background="#1A1A1A"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" />
                                            <Border Width="2"
                                                    Height="2"
                                                    Background="#1A1A1A"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom" />
                                            <Border Width="2"
                                                    Height="2"
                                                    Background="#1A1A1A"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom" />
                                            <Border Width="2"
                                                    Height="2"
                                                    Background="#1A1A1A" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Grid HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="20,76,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!--<Border Background="White"
                                            Width="28"
                                            Height="28">
                                        <Border Width="19.968095779418945"
                                                Height="16.878997802734375"
                                                Margin="4.01,5.6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="Red" />
                                    </Border>-->
                                    <Border Width="28"
                                            Height="28">
                                        <Path Data="M16.9411 5.6001C18.0579 5.6001 18.6166 5.60019 19.1217 5.75635C19.5688 5.89458 19.9835 6.12107 20.3415 6.42236C20.7459 6.76276 21.0482 7.23215 21.652 8.17139L23.1999 10.5806C23.663 11.301 23.8948 11.6615 23.9577 12.0405C24.013 12.3747 23.9764 12.7179 23.8512 13.0327C23.7093 13.3897 23.406 13.6928 22.8005 14.2983L15.696 21.4028C15.1021 21.9967 14.8049 22.2944 14.4626 22.4058C14.1613 22.5036 13.8361 22.5036 13.5348 22.4058C13.1924 22.2945 12.8954 21.9968 12.3014 21.4028L5.19596 14.2983C4.59052 13.6929 4.28814 13.3897 4.14616 13.0327C4.02101 12.7179 3.98438 12.3747 4.03971 12.0405C4.10256 11.6615 4.33358 11.3007 4.79655 10.5806L6.34538 8.17139C6.94913 7.23221 7.25149 6.76275 7.65592 6.42236C8.01393 6.12107 8.42861 5.89456 8.87565 5.75635C9.38075 5.60019 9.93953 5.6001 11.0563 5.6001H16.9411ZM16.8112 8.30713C16.6984 8.00251 16.2677 8.00252 16.1549 8.30713L15.3757 10.4126C15.3289 10.5391 15.2287 10.6392 15.1022 10.686L12.9967 11.4653C12.6925 11.5783 12.6924 12.0088 12.9967 12.1216L15.1022 12.9009C15.2286 12.9477 15.3288 13.047 15.3757 13.1733L16.1549 15.2788C16.2677 15.5835 16.6984 15.5835 16.8112 15.2788L17.5905 13.1733C17.6373 13.0471 17.7368 12.9477 17.863 12.9009L19.9694 12.1216C20.2737 12.0087 20.2736 11.5783 19.9694 11.4653L17.863 10.686C17.7366 10.6392 17.6372 10.5389 17.5905 10.4126L16.8112 8.30713Z"
                                              Fill="#FFFFFF" />
                                    </Border>

                                    <TextBlock FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                               FontWeight="SemiBold"
                                               FontSize="22"
                                               Foreground="#FFFFFF"
                                               Grid.Column="1">
                                        <Run x:Name="CardBalance"
                                             Text="1,344" /><Run x:Name="CardBalanceFraction"
                                                                 Text=".02"
                                                                 FontSize="18" />
                                        <Run Text="GRAM"
                                             Foreground="#6DDCFF" />
                                    </TextBlock>
                                    <TextBlock x:Name="CardBalanceUsd"
                                               Text="$2,150.72"
                                               FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                               FontWeight="Bold"
                                               Foreground="#6DDCFF"
                                               Margin="4"
                                               Grid.ColumnSpan="2"
                                               Grid.Row="1" />
                                </Grid>
                                <TextBlock x:Name="CardName"
                                           Text="ALICIA TORREAUX"
                                           FontFamily="Cascadia Mono"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="24,20" />
                            </Grid>
                        </Viewbox>
                    </controls:AspectView>
                    <Grid MaxWidth="360"
                          ColumnSpacing="8"
                          Margin="24,-8,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Click="Button_Click"
                                Content="[Add Funds]"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20" />
                        <Button Click="Button_Click_1" Content="[Send]"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20"
                                Grid.Column="1" />
                    </Grid>
                    <StackPanel>
                        <controls:PopupInfo Title="[Send Money Instantly]"
                                            Subtitle="[Send Grams in any chat, just like sharing a photo.]"
                                            Glyph="&#xe905;" />
                        <controls:PopupInfo Title="[No Fees]"
                                            Subtitle="[First 5 transfers each day are free, the rest cost almost nothing.]"
                                            Glyph="&#xe905;" />
                        <controls:PopupInfo Title="[Blockchain Verified]"
                                            Subtitle="[All transactions are recorded and verifiable on a public ledger.]"
                                            Glyph="&#xe905;" />
                    </StackPanel>
                </controls:SettingsPanel>
            </ListView.Header>
        </controls:TableListView>
    </Grid>
</views:HostedPage>
