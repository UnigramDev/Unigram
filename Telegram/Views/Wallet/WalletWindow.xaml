<controls:WindowContent x:Class="Telegram.Views.Wallet.WalletWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Telegram.Views.Wallet"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:cells="using:Telegram.Controls.Cells"
                        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                        xmlns:media="using:Telegram.Controls.Media"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border Margin="0,0,0,-24"
                RenderTransformOrigin="0.5,0.5"
                Canvas.ZIndex="1">
            <Border.RenderTransform>
                <ScaleTransform ScaleY="-1" />
            </Border.RenderTransform>
            <Border.Background>
                <media:LinearGaussianBrush />
            </Border.Background>
        </Border>
        <!--
            The title bar of the other windows - logo, title, drag handle - with the mini apps'
            menu button beside it. The last column is not decoration: the window draws its own
            close button over this strip, and anything under it, the drag handle included, takes
            the pointer away from it.
        -->
        <Grid x:Name="TitlePanel"
              Height="40"
              Margin="12,0,0,0"
              Background="Transparent"
              Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TitleBarHandle"
                    Background="Transparent"
                    Grid.Column="2" />

            <HyperlinkButton x:Name="TitleBarLogo"
                             Style="{StaticResource EmptyHyperlinkButtonStyle}"
                             IsTabStop="False"
                             Margin="-10,0,4,0"
                             Width="40"
                             Height="40"
                             Grid.Column="1">
                <Grid Background="Transparent">
                    <Border x:Name="LogoBasic"
                            Width="20"
                            Height="20"
                            CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="4.44444,3.33333"
                                                 EndPoint="18.8889,16.6667"
                                                 MappingMode="Absolute">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStopCollection>
                                        <GradientStop Color="#29C3FF" />
                                        <GradientStop Offset="1"
                                                      Color="#2052CB" />
                                    </GradientStopCollection>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M4.52684 9.89446C7.44204 8.62435 9.38597 7.78702 10.3586 7.38246C13.1357 6.22737 13.7128 6.02672 14.0889 6.02009C14.1716 6.01863 14.3566 6.03913 14.4764 6.13635C14.5776 6.21844 14.6054 6.32934 14.6187 6.40717C14.632 6.485 14.6486 6.6623 14.6354 6.80083C14.485 8.38207 13.8338 12.2193 13.5025 13.9903C13.3623 14.7397 13.0863 14.991 12.8191 15.0156C12.2384 15.069 11.7974 14.6318 11.2349 14.2631C10.3548 13.6861 9.85759 13.327 9.00328 12.764C8.01596 12.1134 8.656 11.7558 9.21866 11.1714C9.36592 11.0184 11.9246 8.69115 11.9741 8.48003C11.9803 8.45362 11.986 8.3552 11.9276 8.30323C11.8691 8.25126 11.7828 8.26903 11.7205 8.28316C11.6322 8.3032 10.2262 9.23253 7.50246 11.0711C7.10337 11.3452 6.74188 11.4787 6.418 11.4717C6.06095 11.464 5.37413 11.2698 4.86355 11.1039C4.23729 10.9003 3.73956 10.7927 3.7829 10.4469C3.80548 10.2669 4.05346 10.0827 4.52684 9.89446Z"
                              Fill="#FFFFFF" />
                    </Border>

                    <controls:CustomEmojiIcon x:Name="LogoEmoji"
                                              x:Load="False"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                </Grid>
            </HyperlinkButton>

            <TextBlock x:Name="StateLabel"
                       VerticalAlignment="Center"
                       TextLineBounds="TrimToCapHeight"
                       TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{ThemeResource PageHeaderForegroundBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       IsHitTestVisible="False"
                       Margin="0,2,6,0"
                       Grid.Column="2" />

            <controls:MoreButton x:Name="MoreButton"
                                 Click="More_ContextRequested"
                                 Width="46"
                                 Height="40"
                                 Grid.Column="3">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPointerOver">#19FFFFFF</SolidColorBrush>
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPressed">#33FFFFFF</SolidColorBrush>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPointerOver">#19000000</SolidColorBrush>
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPressed">#33000000</SolidColorBrush>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="controls:MoreButton">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TitleBarButtonBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Icon.(muxc:AnimatedIcon.State)"
                                                    Value="PointerOver" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TitleBarButtonBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Icon.(muxc:AnimatedIcon.State)"
                                                    Value="Pressed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RootGrid" />

                            <muxc:AnimatedIcon x:Name="Icon"
                                               muxc:AnimatedIcon.State="Normal"
                                               Source="{TemplateBinding IconSource}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Width="20"
                                               Height="20" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </controls:MoreButton>

            <!-- The window draws its own close button now; this is the room it needs. -->
            <Border Width="46"
                    Grid.Column="4" />
        </Grid>

        <controls:TableListView x:Name="ScrollingHost"
                                ContainerContentChanging="OnContainerContentChanging"
                                ItemClick="OnItemClick"
                                IsItemClickEnabled="True"
                                SelectionMode="None"
                                ScrollViewer.CanContentRenderOutsideBounds="True"
                                Padding="0,0,0,24"
                                Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <cells:WalletTransactionCell />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Header>
                <controls:SettingsPanel IsFooter="True">
                    <controls:SettingsPanel.Transform3D>
                        <PerspectiveTransform3D Depth="800" />
                    </controls:SettingsPanel.Transform3D>
                    <controls:SettingsButton Content="[You also have funds in Walt]"
                                             IsChevronVisible="True"
                                             IsGlyphVisible="False"
                                             BorderThickness="1"
                                             CornerRadius="4"
                                             Margin="24,8,24,0" />



                    <controls:AspectView x:Name="Card"
                                         Background="#0079FF"
                                         Margin="24,0"
                                         MaxWidth="360">
                        <!-- Carries the conic gradient so it can rotate on its own
                             while the card tilts. Oversized and clipped by AttachTilt. -->
                        <Rectangle x:Name="Sheen"
                                   Visibility="Visible" />
                        <!--<Image Source="ms-appx:///Views/Wallet/Card.png"
                               VerticalAlignment="Bottom"
                               Visibility="Collapsed" />
                        <Image Source="ms-appx:///Views/Wallet/Card.png"
                               VerticalAlignment="Top"
                               Visibility="Collapsed" />-->
                        <Viewbox>
                            <!--<Grid Width="360"
                                  Height="227.333">-->
                            <Grid Width="360"
                                  Height="220">
                                <Grid HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"
                                      Opacity="0.3">
                                    <!-- box-shadow: 0px 1px 0px 0px rgba(255, 255, 255, 0.06)
                                         is applied in OnLoaded — it needs the glyph
                                         alpha mask, which markup cannot express. -->
                                    <Border x:Name="CardAddressShadow"
                                            RenderTransformOrigin="0.5,0.5"
                                            Opacity="0.6">
                                        <!--<Border.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Border.RenderTransform>-->
                                    </Border>
                                    <TextBlock x:Name="CardAddress"
                                               FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                                               FontSize="10"
                                               FontWeight="Normal"
                                               Foreground="#000000"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                                <HyperlinkButton Style="{StaticResource EmptyHyperlinkButtonStyle}"
                                                 Width="48"
                                                 Height="36"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,80,48,0">
                                    <Grid BorderBrush="#28000000"
                                          BorderThickness="1"
                                          CornerRadius="8">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="-0.039,0.090"
                                                                 EndPoint="1.039,0.910">
                                                <GradientStop Color="#E0BBBDC0"
                                                              Offset="0.0799" />
                                                <GradientStop Color="#E0FFFFFF"
                                                              Offset="0.922" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                        <!--<TextBlock Text="&#xEACA;"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />-->
                                        <Grid Width="16"
                                              Height="16">
                                            <Border Width="7"
                                                    Height="7"
                                                    BorderThickness="1"
                                                    BorderBrush="#1A1A1A"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="2" />
                                            <Border Width="7"
                                                    Height="7"
                                                    BorderThickness="1"
                                                    BorderBrush="#1A1A1A"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="2" />
                                            <Border Width="7"
                                                    Height="7"
                                                    BorderThickness="1"
                                                    BorderBrush="#1A1A1A"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    CornerRadius="2" />
                                            <Grid Width="7"
                                                  Height="7"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Bottom">
                                                <Border Width="2"
                                                        Height="2"
                                                        Background="#1A1A1A"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top" />
                                                <Border Width="2"
                                                        Height="2"
                                                        Background="#1A1A1A"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" />
                                                <Border Width="2"
                                                        Height="2"
                                                        Background="#1A1A1A"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom" />
                                                <Border Width="2"
                                                        Height="2"
                                                        Background="#1A1A1A"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom" />
                                                <Border Width="2"
                                                        Height="2"
                                                        Background="#1A1A1A" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </HyperlinkButton>
                                <Grid HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Margin="20,76,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!--<Border Background="White"
                                            Width="28"
                                            Height="28">
                                        <Border Width="19.968095779418945"
                                                Height="16.878997802734375"
                                                Margin="4.01,5.6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="Red" />
                                    </Border>-->
                                    <Border x:Name="CardBalanceIcon"
                                            Width="28"
                                            Height="28">
                                        <Path Data="M16.9411 5.6001C18.0579 5.6001 18.6166 5.60019 19.1217 5.75635C19.5688 5.89458 19.9835 6.12107 20.3415 6.42236C20.7459 6.76276 21.0482 7.23215 21.652 8.17139L23.1999 10.5806C23.663 11.301 23.8948 11.6615 23.9577 12.0405C24.013 12.3747 23.9764 12.7179 23.8512 13.0327C23.7093 13.3897 23.406 13.6928 22.8005 14.2983L15.696 21.4028C15.1021 21.9967 14.8049 22.2944 14.4626 22.4058C14.1613 22.5036 13.8361 22.5036 13.5348 22.4058C13.1924 22.2945 12.8954 21.9968 12.3014 21.4028L5.19596 14.2983C4.59052 13.6929 4.28814 13.3897 4.14616 13.0327C4.02101 12.7179 3.98438 12.3747 4.03971 12.0405C4.10256 11.6615 4.33358 11.3007 4.79655 10.5806L6.34538 8.17139C6.94913 7.23221 7.25149 6.76275 7.65592 6.42236C8.01393 6.12107 8.42861 5.89456 8.87565 5.75635C9.38075 5.60019 9.93953 5.6001 11.0563 5.6001H16.9411ZM16.8112 8.30713C16.6984 8.00251 16.2677 8.00252 16.1549 8.30713L15.3757 10.4126C15.3289 10.5391 15.2287 10.6392 15.1022 10.686L12.9967 11.4653C12.6925 11.5783 12.6924 12.0088 12.9967 12.1216L15.1022 12.9009C15.2286 12.9477 15.3288 13.047 15.3757 13.1733L16.1549 15.2788C16.2677 15.5835 16.6984 15.5835 16.8112 15.2788L17.5905 13.1733C17.6373 13.0471 17.7368 12.9477 17.863 12.9009L19.9694 12.1216C20.2737 12.0087 20.2736 11.5783 19.9694 11.4653L17.863 10.686C17.7366 10.6392 17.6372 10.5389 17.5905 10.4126L16.8112 8.30713Z"
                                              Fill="#FFFFFF" />
                                    </Border>

                                    <TextBlock x:Name="CardBalanceText"
                                               FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                               FontWeight="SemiBold"
                                               FontSize="22"
                                               Foreground="#FFFFFF"
                                               Grid.Column="1">
                                        <Run x:Name="CardBalance" /><Run x:Name="CardBalanceFraction"
                                                                         FontSize="18" />
                                        <Run x:Name="CardBalanceGram"
                                             Text="GRAM"
                                             Foreground="#6DDCFF" />
                                    </TextBlock>
                                    <TextBlock x:Name="CardBalanceUsd"
                                               FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                               FontWeight="Bold"
                                               Foreground="#6DDCFF"
                                               Margin="4"
                                               Grid.ColumnSpan="2"
                                               Grid.Row="1" />
                                </Grid>
                                <!-- What the two lines above look like before there is anything to
                                     put in them. The bars are drawn by the skeleton itself, clipped
                                     to its own geometry, so this only reserves the room. -->
                                <Border x:Name="CardBalanceSkeleton"
                                        Width="180"
                                        Height="62"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed"
                                        Margin="20,76,0,0" />

                                <TextBlock x:Name="CardName"
                                           FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                                           FontWeight="Medium"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="24,20" />
                            </Grid>
                        </Viewbox>
                    </controls:AspectView>
                    <Grid MaxWidth="360"
                          ColumnSpacing="8"
                          Margin="24,-8,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Click="Button_Click"
                                Content="[Add Funds]"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20" />
                        <Button Click="Button_Click_1"
                                Content="[Send]"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                CornerRadius="20"
                                Grid.Column="1" />
                    </Grid>
                    <!-- The empty state: what the header shows instead of history, until there
                         is any. Collapsed until the first page comes back, so it does not flash
                         on the way to a wallet that has transactions. -->
                    <StackPanel x:Name="EmptyPanel"
                                Visibility="Collapsed">
                        <controls:PopupInfo Title="[Send Money Instantly]"
                                            Subtitle="[Send Grams in any chat, just like sharing a photo.]"
                                            Glyph="&#xEB2B;" />
                        <controls:PopupInfo Title="[No Fees]"
                                            Subtitle="[First 5 transfers each day are free, the rest cost almost nothing.]"
                                            Glyph="&#xEA9D;" />
                        <controls:PopupInfo Title="[Blockchain Verified]"
                                            Subtitle="[All transactions are recorded and verifiable on a public ledger.]"
                                            Glyph="&#xEA8B;" />
                    </StackPanel>
                </controls:SettingsPanel>
            </ListView.Header>
        </controls:TableListView>
    </Grid>
</controls:WindowContent>
