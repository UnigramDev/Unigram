<controls:ModalPopup x:Class="Telegram.Views.Stories.Popups.PostStoryPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:chats="using:Telegram.Controls.Chats"
                     xmlns:drawers="using:Telegram.Controls.Drawers"
                     xmlns:messages="using:Telegram.Controls.Messages"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     FocusPrimaryButton="False"
                     IsDismissButtonVisible="True"
                     Padding="0,24,0,0">

    <controls:ModalPopup.Resources>
        <ControlTemplate x:Key="HyperlinkButtonTemplate"
                         TargetType="HyperlinkButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter />

                <TextBlock Text="&#xEAB9;"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="12"
                           Margin="2,0,0,1"
                           VerticalAlignment="Bottom"
                           Width="12"
                           Grid.Column="3" />
            </Grid>
        </ControlTemplate>
    </controls:ModalPopup.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      Padding="24,0">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{CustomResource StoryPrivacyWhoCanView}"
                           Style="{StaticResource BaseTextBlockStyle}"
                           Margin="0,0,0,4" />

                <RadioButton x:Name="Everyone"
                             Content="{CustomResource StoryPrivacyOptionEveryone}"
                             GroupName="StoryPrivacy" />

                <!-- Lined up under the option's text, past its 20 pixel glyph and 8 pixel gap. -->
                <HyperlinkButton x:Name="EveryoneList"
                                 Click="List_Click"
                                 Padding="0"
                                 Margin="28,-6,0,4"
                                 Template="{StaticResource HyperlinkButtonTemplate}">
                </HyperlinkButton>

                <RadioButton x:Name="Contacts"
                             Content="{CustomResource StoryPrivacyOptionContacts}"
                             GroupName="StoryPrivacy" />

                <HyperlinkButton x:Name="ContactsList"
                                 Click="List_Click"
                                 Padding="0"
                                 Margin="28,-6,0,4"
                                 Template="{StaticResource HyperlinkButtonTemplate}" />

                <RadioButton x:Name="CloseFriends"
                             Content="{CustomResource StoryPrivacyOptionCloseFriends}"
                             GroupName="StoryPrivacy" />

                <HyperlinkButton x:Name="CloseFriendsList"
                                 Click="List_Click"
                                 Padding="0"
                                 Margin="28,-6,0,4"
                                 Template="{StaticResource HyperlinkButtonTemplate}" />

                <RadioButton x:Name="SelectedContacts"
                             Content="{CustomResource StoryPrivacyOptionSelectedContacts}"
                             GroupName="StoryPrivacy" />

                <HyperlinkButton x:Name="SelectedContactsList"
                                 Click="List_Click"
                                 Padding="0"
                                 Margin="28,-6,0,4"
                                 Template="{StaticResource HyperlinkButtonTemplate}" />

                <CheckBox x:Name="AllowScreenshots"
                          Content="{CustomResource StoryAllowScreenshots}"
                          IsChecked="True"
                          Margin="0,16,0,0" />

                <CheckBox x:Name="Keep"
                          Content="{CustomResource StoryKeep}"
                          IsChecked="True" />

                <TextBlock x:Name="KeepInfo"
                           Style="{StaticResource InfoCaptionTextBlockStyle}" />

                <StackPanel x:Name="PeriodRoot"
                            Margin="0,16,0,0">
                    <ComboBox x:Name="Period"
                              SelectionChanged="Period_SelectionChanged"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,8" />

                    <TextBlock Text="{CustomResource StoryPeriodHint}"
                               Style="{StaticResource InfoCaptionTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The people and hashtags offered as the caption is written. -->
        <controls:OrientableListView x:Name="ListAutocomplete"
                                     Visibility="Collapsed"
                                     VerticalAlignment="Bottom"
                                     MaxHeight="240"
                                     Background="{ThemeResource AutoSuggestBoxSuggestionsListBackground}"
                                     BorderBrush="{ThemeResource AutoSuggestBoxSuggestionsListBorderBrush}"
                                     BorderThickness="0,1,0,0"
                                     ItemTemplateSelector="{StaticResource AutocompleteTemplate}"
                                     Style="{StaticResource ZoomableListViewStyle}"
                                     BackgroundSizing="OuterBorderEdge"
                                     AllowFocusOnInteraction="False"
                                     IsItemClickEnabled="True"
                                     ItemClick="Autocomplete_ItemClick"
                                     ContainerContentChanging="Autocomplete_ContainerContentChanging">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem"
                       BasedOn="{StaticResource ZoomableListViewItemStyle}">
                    <Setter Property="MinWidth"
                            Value="0" />
                    <Setter Property="Padding"
                            Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemContainerTransitions>
                <TransitionCollection />
            </GridView.ItemContainerTransitions>
        </controls:OrientableListView>

        <controls:ScrollViewerScrim ScrollingHost="{x:Bind ScrollingHost}"
                                    Background="{ThemeResource ContentDialogTopOverlaySolid}"
                                    BottomInset="0" />

        <Grid x:Name="CaptionPanel"
              Background="{ThemeResource ContentDialogBackground}"
              CornerRadius="0,0,8,8"
              Grid.Row="1">
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="EmojiFlyout">
                    <MenuFlyout.MenuFlyoutPresenterStyle>
                        <Style TargetType="MenuFlyoutPresenter">
                            <Setter Property="Padding"
                                    Value="0" />
                        </Style>
                    </MenuFlyout.MenuFlyoutPresenterStyle>
                    <controls:MenuFlyoutContent Padding="0">
                        <drawers:EmojiDrawer x:Name="EmojiPanel"
                                             ItemClick="Emoji_ItemClick"
                                             Width="300"
                                             Height="360" />
                    </controls:MenuFlyoutContent>
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:FormattedTextInputHost x:Name="CaptionInput"
                                             Kind="Caption"
                                             Tier="Popups"
                                             Loaded="CaptionInput_Loaded"
                                             Unloaded="CaptionInput_Unloaded"
                                             Submitted="CaptionInput_Submitted"
                                             ContentChanged="CaptionInput_ContentChanged"
                                             ControlledList="{x:Bind ListAutocomplete}"
                                             InputScope="Chat"
                                             CustomEmoji="{x:Bind CustomEmoji}"
                                             FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                             PlaceholderText="{CustomResource AddCaption}"
                                             LegacyStyle="{StaticResource DefaultChatTextBoxStyle}"
                                             NativeStyle="{StaticResource DefaultChatMessageTextBoxStyle}"
                                             Background="Transparent"
                                             Padding="24,0,0,0"
                                             BorderThickness="0"
                                             MinHeight="48" />

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Grid.ColumnSpan="3" />

            <messages:CustomEmojiCanvas x:Name="CustomEmoji"
                                        IsHitTestVisible="False"
                                        Margin="22,11,0,0" />

            <!-- What is left of the caption's length, once little is. -->
            <Grid x:Name="CaptionCounter"
                  Visibility="Collapsed"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,4,16,0"
                  Grid.Column="1"
                  Grid.ColumnSpan="2">
                <TextBlock x:Name="CaptionCounterLeft"
                           Foreground="{ThemeResource SystemControlDisabledChromeDisabledLowBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="CaptionCounterOver"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource DangerButtonBackground}"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Grid>

            <controls:GlyphButton x:Name="EmojiButton"
                                  Click="Emoji_Click"
                                  Glyph="&#xE76E;"
                                  AutomationProperties.Name="{CustomResource Emoji}"
                                  AllowFocusOnInteraction="False"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  CornerRadius="20"
                                  FontSize="24"
                                  Grid.Column="1" />

            <chats:ChatSendButton x:Name="Send"
                                  Click="Send_Click"
                                  AutomationProperties.Name="{CustomResource StoryPrivacyButtonPost}"
                                  ToolTipService.ToolTip="{CustomResource StoryPrivacyButtonPost}"
                                  Foreground="{ThemeResource TelegramBackgroundAccentBrush}"
                                  VerticalAlignment="Bottom"
                                  Margin="-8,0,0,0"
                                  Grid.Column="2" />
        </Grid>
    </Grid>
</controls:ModalPopup>
