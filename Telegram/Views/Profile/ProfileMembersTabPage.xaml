<local:ProfileTabPage x:Class="Telegram.Views.Profile.ProfileMembersTabPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:controls="using:Telegram.Controls"
                      xmlns:cells="using:Telegram.Controls.Cells"
                      xmlns:local="using:Telegram.Views.Profile"
                      mc:Ignorable="d"
                      ItemsSource="{x:Bind ViewModel.MembersTab.Members, Mode=OneWay}">

    <Grid>
        <controls:TableListView x:Name="ScrollingHost"
                                ItemClick="ListView_ItemClick"
                                IsItemClickEnabled="True"
                                ChoosingItemContainer="OnChoosingItemContainer"
                                ContainerContentChanging="OnContainerContentChanging"
                                SelectionMode="None">
            <ListView.Template>
                <ControlTemplate TargetType="ListView">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ItemsPresenter Header="{TemplateBinding Header}"
                                        HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                        HeaderTransitions="{TemplateBinding HeaderTransitions}"
                                        Footer="{TemplateBinding Footer}"
                                        FooterTemplate="{TemplateBinding FooterTemplate}"
                                        FooterTransitions="{TemplateBinding FooterTransitions}"
                                        Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </ListView.Template>
            <ListView.Header>
                <StackPanel>
                    <Border x:Name="Header" />

                    <controls:HeaderedControl x:Name="AddNewPanel"
                                              Visibility="Collapsed"
                                              Margin="0,2,0,2"
                                              Padding="0">
                        <controls:SettingsButton x:Name="AddNew"
                                                 Content="{CustomResource AddSubscriber}"
                                                 Click="{x:Bind ViewModel.MembersTab.Add}"
                                                 Glyph="&#xE8FA;" />
                    </controls:HeaderedControl>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <cells:ProfileCell>
                        <controls:BadgeControl VerticalAlignment="Center">
                            <controls:BadgeControl.Style>
                                <Style TargetType="controls:BadgeControl">
                                    <Setter Property="Foreground"
                                            Value="{ThemeResource SystemControlDisabledChromeDisabledLowBrush}" />
                                    <Setter Property="Background"
                                            Value="Transparent" />
                                </Style>
                            </controls:BadgeControl.Style>
                        </controls:BadgeControl>
                    </cells:ProfileCell>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Border Height="60" />
            </ListView.Footer>
        </controls:TableListView>
    </Grid>
</local:ProfileTabPage>
