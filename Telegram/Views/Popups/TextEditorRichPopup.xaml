<controls:UserControlEx x:Class="Telegram.Views.Popups.TextEditorRichPopup"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                        xmlns:common="using:Telegram.Common"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:drawers="using:Telegram.Controls.Drawers"
                        xmlns:messages="using:Telegram.Controls.Messages"
                        mc:Ignorable="d">

    <controls:UserControlEx.Resources>
        <Style TargetType="controls:GlyphToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="UncheckedForeground"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="CheckedForeground"
                    Value="{ThemeResource SystemControlHighlightBaseMediumHighBrush}" />
            <Setter Property="BorderBrush"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontFamily"
                    Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize"
                    Value="{StaticResource GlyphMediumFontSize}" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Width"
                    Value="48" />
            <Setter Property="UseSystemFocusVisuals"
                    Value="True" />
            <Setter Property="FocusVisualMargin"
                    Value="-3" />
            <Setter Property="CornerRadius"
                    Value="{StaticResource GlyphButtonCornerRadius}" />
            <Setter Property="Padding"
                    Value="{StaticResource GlyphButtonPadding}" />
            <!--<Setter Property="IsOneWay"
                    Value="False" />-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:GlyphToggleButton">
                        <Grid Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Margin="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.15" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RootGrid">
                                <Border x:Name="CheckedBackground"
                                        Background="{ThemeResource TelegramBackgroundAccentBrush}"
                                        Opacity="0" />
                                <TextBlock x:Name="ContentPresenter"
                                           Margin="{TemplateBinding Padding}"
                                           Foreground="{TemplateBinding UncheckedForeground}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{TemplateBinding Glyph}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </controls:UserControlEx.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- No Source: Initialize navigates to the same file through the editor.unigram
             virtual host, and setting both loads the whole editor twice. -->
        <muxc:WebView2 x:Name="View"
                       Grid.Row="0"
                       Grid.RowSpan="3" />

        <messages:CustomEmojiCanvas x:Name="Canvas"
                                    Grid.Row="0"
                                    Grid.RowSpan="3" />

        <Border Margin="0,0,0,-8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1"
                                     EndPoint="0,0">
                    <common:Scrim.Gradient>
                        <common:CubicBezierGradient x:Name="Scrim"
                                                    TopOpacity="0"
                                                    TopColor="{ThemeResource ContentDialogTopOverlaySolid}"
                                                    BottomColor="{ThemeResource ContentDialogTopOverlaySolid}" />
                    </common:Scrim.Gradient>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Margin="0,-8,0,0"
                Grid.Row="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <common:Scrim.Gradient>
                        <common:CubicBezierGradient TopOpacity="0"
                                                    TopColor="{ThemeResource ContentDialogTopOverlaySolid}"
                                                    BottomColor="{ThemeResource ContentDialogTopOverlaySolid}" />
                    </common:Scrim.Gradient>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid>
                <Rectangle x:Name="HistoryShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Width="80"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <Grid CornerRadius="20"
                      Height="40"
                      Width="80">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:GlyphButton x:Name="UndoButton"
                                          Click="Undo_Click"
                                          IsEnabled="False"
                                          AllowFocusOnInteraction="False"
                                          Width="40"
                                          Height="40"
                                          Glyph="&#xE7A7;"
                                          CornerRadius="20"
                                          Padding="0" />
                    <controls:GlyphButton x:Name="RedoButton"
                                          Click="Redo_Click"
                                          IsEnabled="False"
                                          AllowFocusOnInteraction="False"
                                          Width="40"
                                          Height="40"
                                          Glyph="&#xE7A6;"
                                          CornerRadius="20"
                                          Padding="0"
                                          Grid.Column="1" />
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="DocumentRoot"
              Padding="12"
              ColumnSpacing="8"
              Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Rectangle x:Name="BlockShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Width="240"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <Grid CornerRadius="20"
                      Height="40"
                      Width="240">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:GlyphButton x:Name="EmojiButton"
                                          Click="Emoji_Click"
                                          AllowFocusOnInteraction="False"
                                          Width="40"
                                          Height="40"
                                          Glyph="&#xE76E;"
                                          CornerRadius="20">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="EmojiFlyout"
                                    Placement="Top"
                                    ShowMode="Transient">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter"
                                           BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                                        <Setter Property="Padding"
                                                Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <drawers:EmojiDrawer x:Name="EmojiPanel"
                                                     ItemClick="Emoji_ItemClick"
                                                     Width="300"
                                                     Height="360" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </controls:GlyphButton>
                    <controls:GlyphToggleButton x:Name="ParagraphButton"
                                                Click="Paragraph_Click"
                                                AllowFocusOnInteraction="False"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xEB23;"
                                                CornerRadius="20"
                                                Grid.Column="1" />
                    <controls:GlyphToggleButton x:Name="QuoteButton"
                                                Click="Quote_Click"
                                                AllowFocusOnInteraction="False"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xEAC7;"
                                                CornerRadius="20"
                                                Grid.Column="2" />
                    <controls:GlyphToggleButton x:Name="ListButton"
                                                Click="List_Click"
                                                AllowFocusOnInteraction="False"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xEB09;"
                                                CornerRadius="20"
                                                Grid.Column="3" />
                    <controls:GlyphToggleButton x:Name="TableButton"
                                                Click="Table_Click"
                                                AllowFocusOnInteraction="False"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xEB08;"
                                                CornerRadius="20"
                                                Grid.Column="4" />
                    <controls:GlyphToggleButton x:Name="FormulaButton"
                                                Click="Formula_Click"
                                                AllowFocusOnInteraction="False"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xEB07;"
                                                CornerRadius="20"
                                                Grid.Column="5" />
                </Grid>
            </Grid>

            <Grid Grid.Column="3">
                <Rectangle x:Name="AttachShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Width="40"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <Border CornerRadius="20"
                        Height="40"
                        Width="40">
                    <controls:GlyphButton x:Name="AttachButton"
                                          AllowFocusOnInteraction="False"
                                          Width="40"
                                          Height="40"
                                          Glyph="&#xE9D8;"
                                          CornerRadius="20" />
                </Border>
            </Grid>

            <Grid Grid.Column="4">
                <Rectangle x:Name="SendShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Width="40"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <Border CornerRadius="20"
                        Height="40"
                        Width="40">
                    <controls:GlyphButton x:Name="SendButton"
                                          Click="Send_Click"
                                          Width="40"
                                          Height="40"
                                          Glyph="&#xEB06;"
                                          CornerRadius="20" />
                </Border>
                <!-- Premium lock: shown for free users when the message contains rich content that
                     can't be sent as a plain FormattedText (RichEditorState.HasRichContent). -->
                <Border x:Name="SendLock"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Width="18"
                        Height="18"
                        CornerRadius="9"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                    <FontIcon Glyph="&#xE72E;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="11" />
                </Border>
            </Grid>

        </Grid>

        <Grid x:Name="SelectionRoot"
              Visibility="Collapsed"
              ColumnSpacing="8"
              Padding="12"
              Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Rectangle x:Name="StyleShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Auto">
                    <Grid CornerRadius="20"
                          Height="40"
                          Width="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:GlyphToggleButton x:Name="BoldButton"
                                                    Click="Bold_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xE8DD;"
                                                    CornerRadius="20" />
                        <controls:GlyphToggleButton x:Name="ItalicButton"
                                                    Click="Italic_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xE8DB;"
                                                    CornerRadius="20"
                                                    Grid.Column="1" />
                        <controls:GlyphToggleButton x:Name="UnderlineButton"
                                                    Click="Underline_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xE8DC;"
                                                    CornerRadius="20"
                                                    Grid.Column="2" />
                        <controls:GlyphToggleButton x:Name="StrikethroughButton"
                                                    Click="Strikethrough_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xE8DE;"
                                                    CornerRadius="20"
                                                    Grid.Column="3" />
                        <controls:GlyphToggleButton x:Name="SpoilerButton"
                                                    Click="Spoiler_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xEAA1;"
                                                    CornerRadius="20"
                                                    Grid.Column="4" />
                        <controls:GlyphToggleButton x:Name="MonospaceButton"
                                                    Click="Monospace_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xE943;"
                                                    CornerRadius="20"
                                                    Grid.Column="5" />
                        <controls:GlyphToggleButton x:Name="SubscriptButton"
                                                    Click="Subscript_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xEB1B;"
                                                    CornerRadius="20"
                                                    Grid.Column="6" />
                        <controls:GlyphToggleButton x:Name="SuperscriptButton"
                                                    Click="Superscript_Click"
                                                    Width="40"
                                                    Height="40"
                                                    Glyph="&#xEB1A;"
                                                    CornerRadius="20"
                                                    Grid.Column="7" />
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1">
                <Rectangle x:Name="EntityShadow"
                           Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                           Stroke="{ThemeResource SettingsItemBorderBrush}"
                           Width="80"
                           Height="40"
                           RadiusX="20"
                           RadiusY="20" />
                <Grid CornerRadius="20"
                      Height="40"
                      Width="80">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:GlyphToggleButton x:Name="LinkButton"
                                                Click="Link_Click"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xE71B;"
                                                CornerRadius="20"
                                                Padding="0" />
                    <controls:GlyphToggleButton x:Name="DateButton"
                                                Click="Date_Click"
                                                Width="40"
                                                Height="40"
                                                Glyph="&#xE787;"
                                                CornerRadius="20"
                                                Padding="0"
                                                Grid.Column="1" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</controls:UserControlEx>
