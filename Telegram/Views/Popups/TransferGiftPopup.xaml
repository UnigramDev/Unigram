<controls:ModalPopup x:Class="Telegram.Views.Popups.TransferGiftPopup"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                        xmlns:controls="using:Telegram.Controls"
                        mc:Ignorable="d">

    <StackPanel>
        <controls:TopNavView x:Name="Currency"
                             HorizontalAlignment="Center"
                             Height="40"
                             Visibility="Collapsed">
            <controls:TopNavView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                                Padding="4,0"
                                CornerRadius="15" />
                </ItemsPanelTemplate>
            </controls:TopNavView.ItemsPanel>
            <controls:TopNavView.ItemContainerStyle>
                <Style TargetType="controls:TopNavViewItem">
                    <Setter Property="HorizontalAlignment"
                            Value="Stretch" />
                    <Setter Property="VerticalAlignment"
                            Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="UseSystemFocusVisuals"
                            Value="True" />
                    <Setter Property="FocusVisualMargin"
                            Value="-3,5" />
                    <Setter Property="CornerRadius"
                            Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="controls:TopNavViewItem">
                                <Grid x:Name="ContentBorder"
                                      Background="Transparent">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Grid.Column="1"
                                                      Margin="8,5,8,6"
                                                      TextWrapping="NoWrap"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Content="{TemplateBinding Content}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AccessibilityView="Raw"
                                                      Canvas.ZIndex="1" />
                                    <Grid x:Name="SelectionIndicatorGrid"
                                          Margin="0,4,0,4"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <Rectangle x:Name="SelectionIndicator"
                                                   Fill="{ThemeResource ControlFillColorSecondaryBrush}"
                                                   Opacity="0"
                                                   RadiusX="10"
                                                   RadiusY="10" />
                                    </Grid>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </controls:TopNavView.ItemContainerStyle>
            <controls:TopNavViewItem Content="{CustomResource Gift2BuyInStars}"
                                     FontSize="12" />
            <controls:TopNavViewItem Content="{CustomResource Gift2BuyInTON}"
                                     FontSize="12" />
        </controls:TopNavView>

        <TextBlock x:Name="CurrencyInfo"
                   TextAlignment="Center"
                   Margin="0,4,0,12"
                   Style="{StaticResource InfoCaptionTextBlockStyle}"
                   Visibility="Collapsed" />

        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Viewbox Width="64"
                     Height="64"
                     Margin="0,0,0,8">
                <controls:PatternBackground x:Name="Photo1"
                                            Width="160"
                                            Height="160"
                                            Padding="0"
                                            CornerRadius="24">
                    <controls:AnimatedImage x:Name="Animated"
                                            IsViewportAware="True"
                                            Width="120"
                                            Height="120"
                                            FrameSize="120,120" />
                </controls:PatternBackground>
            </Viewbox>
            <TextBlock Text="&#xE0E3;"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       FontSize="32"
                       VerticalAlignment="Center"
                       Grid.Column="1" />
            <controls:ProfilePicture x:Name="Photo2"
                                     Size="64"
                                     Margin="0,0,0,8"
                                     Grid.Column="2" />
        </Grid>

        <TextBlock x:Name="MessageLabel"
                   Margin="0,0,0,4"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <controls:TableView x:Name="Attributes"
                            Margin="-8,12,-8,0"
                            Visibility="Collapsed">
            <controls:TableViewItem Header="{CustomResource Gift2AttributeModel}"
                                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelText"
                               Margin="8,5,8,6"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Top" />
                    <controls:SettingsButton x:Name="ModelRarity"
                                             IsHitTestVisible="False"
                                             IsTabStop="False"
                                             Style="{StaticResource SmallButtonStyle}"
                                             VerticalAlignment="Center"
                                             FontSize="11"
                                             Padding="4,0"
                                             CornerRadius="8"
                                             BorderThickness="0"
                                             Height="16"
                                             Grid.Column="1" />
                </Grid>
            </controls:TableViewItem>
            <controls:TableViewItem Header="{CustomResource Gift2AttributeBackdrop}"
                                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackdropText"
                               Margin="8,5,8,6"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Top" />
                    <controls:SettingsButton x:Name="BackdropRarity"
                                             IsHitTestVisible="False"
                                             IsTabStop="False"
                                             Style="{StaticResource SmallButtonStyle}"
                                             VerticalAlignment="Center"
                                             FontSize="11"
                                             Padding="4,0"
                                             CornerRadius="8"
                                             BorderThickness="0"
                                             Height="16"
                                             Grid.Column="1" />
                </Grid>
            </controls:TableViewItem>
            <controls:TableViewItem Header="{CustomResource Gift2AttributeSymbol}"
                                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SymbolText"
                               Margin="8,5,8,6"
                               Style="{StaticResource BodyTextBlockStyle}"
                               VerticalAlignment="Top" />
                    <controls:SettingsButton x:Name="SymbolRarity"
                                             IsHitTestVisible="False"
                                             IsTabStop="False"
                                             Style="{StaticResource SmallButtonStyle}"
                                             VerticalAlignment="Center"
                                             FontSize="11"
                                             Padding="4,0"
                                             CornerRadius="8"
                                             BorderThickness="0"
                                             Height="16"
                                             Grid.Column="1" />
                </Grid>
            </controls:TableViewItem>
            <controls:TableViewItem x:Name="ValueRow"
                                    Header="{CustomResource GiftValue2}"
                                    Visibility="Collapsed" />
        </controls:TableView>
    </StackPanel>
</controls:ModalPopup>
