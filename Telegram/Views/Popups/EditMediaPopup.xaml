<controls:OverlayWindow x:Class="Telegram.Views.Popups.EditMediaPopup"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Telegram.Views.Popups"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:icons="using:Telegram.Assets.Icons"
                        xmlns:drawers="using:Telegram.Controls.Drawers"
                        xmlns:xaml="using:Microsoft.Graphics.Canvas.UI.Xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        mc:Ignorable="d"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Background="{x:Null}"
                        RequestedTheme="Dark"
                        PreviewKeyDown="OnPreviewKeyDown"
                        ProcessKeyboardAccelerators="OnProcessKeyboardAccelerators">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ImageCropper x:Name="Cropper"
                               Changed="Cropper_Changed"
                               ViewChanged="Cropper_ViewChanged"
                               Padding="24">
            <Grid>
                <SwapChainPanel x:Name="Video"
                                x:Load="False" />
                <controls:PencilCanvas x:Name="Canvas"
                                       StrokesChanged="Canvas_StrokesChanged"
                                       StrokeAdded="Canvas_StrokeAdded"
                                       Gesture="Canvas_Gesture"
                                       ColorPicked="Canvas_ColorPicked"
                                       ShapeRecognized="Canvas_ShapeRecognized"
                                       StrokeStarted="Canvas_StrokeStarted"
                                       IsEnabled="False" />
                <controls:PaintEntityLayer x:Name="Entities"
                                           SelectionChanged="Entities_SelectionChanged"
                                           EntityCreated="Entities_EntityCreated"
                                           EntityDeleted="Entities_EntityDeleted"
                                           HandleBrush="{ThemeResource TelegramBackgroundAccentBrush}"
                                           IsHitTestVisible="False" />
            </Grid>
        </controls:ImageCropper>

        <Grid x:Name="CropToolbar"
              Margin="12,0,12,8"
              Grid.Row="1">
            <controls:CropRotationWheel x:Name="RotationWheel"
                                        RotationStarted="RotationWheel_RotationStarted"
                                        RotationChanged="RotationWheel_RotationChanged"
                                        RotationCompleted="RotationWheel_RotationCompleted"
                                        MaxWidth="400"
                                        AutomationProperties.Name="{CustomResource AccDescrRotate}" />

            <Button x:Name="ResetCrop"
                    Click="ResetCrop_Click"
                    Content="{CustomResource Reset}"
                    Style="{StaticResource AccentTextButtonStyle}"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- The tools of the tab chosen in the bar below. -->
        <Grid x:Name="DrawToolbar"
              x:Load="False"
              Background="{ThemeResource SystemControlChromeMediumLowAcrylicElementMediumBrush}"
              CornerRadius="15"
              Padding="4,0,8,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="24,0,24,8"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:GlyphButton x:Name="Undo"
                                  Click="Undo_Click"
                                  Margin="0,0,-4,0"
                                  Glyph="&#xE7A7;" />

            <controls:GlyphButton x:Name="Redo"
                                  Click="Redo_Click"
                                  Glyph="&#xE7A6;"
                                  Margin="0,0,-4,0"
                                  Grid.Column="1" />

            <controls:GlyphButton x:Name="ColorButton"
                                  Glyph=""
                                  AutomationProperties.Name="{CustomResource PaintColor}"
                                  ToolTipService.ToolTip="{CustomResource PaintColor}"
                                  Margin="0,0,-4,0"
                                  Grid.Column="2">
                <controls:GlyphButton.Flyout>
                    <Flyout x:Name="ColorFlyout"
                            Placement="Top"
                            Opening="ColorFlyout_Opening"
                            Closed="ColorFlyout_Closed">
                        <Grid>
                            <StackPanel x:Name="PalettePanel"
                                        Orientation="Horizontal">
                                <GridView x:Name="ColorPalette"
                                          IsItemClickEnabled="True"
                                          ItemClick="ColorPalette_ItemClick"
                                          SelectionMode="Single">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid MaximumRowsOrColumns="7"
                                                           Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="SolidColorBrush">
                                            <Ellipse Fill="{x:Bind}"
                                                     Width="28"
                                                     Height="28"
                                                     Margin="4" />
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <controls:GlyphButton Click="MoreColors_Click"
                                                      Glyph="&#xE2B1;"
                                                      AutomationProperties.Name="{CustomResource PaintMoreColors}"
                                                      ToolTipService.ToolTip="{CustomResource PaintMoreColors}"
                                                      VerticalAlignment="Center" />
                            </StackPanel>

                            <controls:PaintColorPicker x:Name="CustomColorPicker"
                                                       x:Load="False"
                                                       ColorChanged="CustomColorPicker_ColorChanged"
                                                       EyedropperRequested="CustomColorPicker_EyedropperRequested"
                                                       Completed="CustomColorPicker_Completed" />
                        </Grid>
                    </Flyout>
                </controls:GlyphButton.Flyout>
            </controls:GlyphButton>

            <!-- Over the button rather than in it: GlyphButton draws only its glyph. -->
            <Grid x:Name="ColorSwatchPanel"
                  Width="24"
                  Height="24"
                  IsHitTestVisible="False"
                  Grid.Column="2">
                    <Path Data="M 23,12 A 11,11 0 0 1 18.858,20.6"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="23,12"
                                                 EndPoint="18.858,20.6">
                                <GradientStop Color="#FFEB4B4B"
                                              Offset="0" />
                                <GradientStop Color="#FFEE82EE"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 18.858,20.6 A 11,11 0 0 1 9.552,22.724"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="18.858,20.6"
                                                 EndPoint="9.552,22.724">
                                <GradientStop Color="#FFEE82EE"
                                              Offset="0" />
                                <GradientStop Color="#FF6080E4"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 9.552,22.724 A 11,11 0 0 1 2.089,16.773"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="9.552,22.724"
                                                 EndPoint="2.089,16.773">
                                <GradientStop Color="#FF6080E4"
                                              Offset="0" />
                                <GradientStop Color="#FF00FFFF"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 2.089,16.773 A 11,11 0 0 1 2.089,7.227"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="2.089,16.773"
                                                 EndPoint="2.089,7.227">
                                <GradientStop Color="#FF00FFFF"
                                              Offset="0" />
                                <GradientStop Color="#FF8FCE00"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 2.089,7.227 A 11,11 0 0 1 9.552,1.276"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="2.089,7.227"
                                                 EndPoint="9.552,1.276">
                                <GradientStop Color="#FF8FCE00"
                                              Offset="0" />
                                <GradientStop Color="#FFFFFF00"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 9.552,1.276 A 11,11 0 0 1 18.858,3.4"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="9.552,1.276"
                                                 EndPoint="18.858,3.4">
                                <GradientStop Color="#FFFFFF00"
                                              Offset="0" />
                                <GradientStop Color="#FFFFA500"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Data="M 18.858,3.4 A 11,11 0 0 1 23,12"
                          StrokeThickness="2">
                        <Path.Stroke>
                            <LinearGradientBrush MappingMode="Absolute"
                                                 StartPoint="18.858,3.4"
                                                 EndPoint="23,12">
                                <GradientStop Color="#FFFFA500"
                                              Offset="0" />
                                <GradientStop Color="#FFEB4B4B"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                <Ellipse x:Name="ColorSwatch"
                         Width="16"
                         Height="16" />
            </Grid>

            <Border x:Name="ToolSelection"
                    Background="{ThemeResource NavigationViewItemBackgroundSelected}"
                    CornerRadius="{StaticResource GlyphButtonCornerRadius}"
                    Margin="4,4,0,4"
                    IsHitTestVisible="False"
                    Grid.Column="3">
                <Border.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.25" />
                </Border.TranslationTransition>
            </Border>

            <controls:AnimatedIconToggleButton x:Name="PenTool"
                                               Click="Tool_Click"
                                               Glyph="&#xF79F;"
                                               CheckedGlyph="&#xF79F;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintPen}"
                                               ToolTipService.ToolTip="{CustomResource PaintPen}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="3">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintPen />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <controls:AnimatedIconToggleButton x:Name="ArrowTool"
                                               Click="Tool_Click"
                                               Glyph="&#xF7A0;"
                                               CheckedGlyph="&#xF7A0;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintArrow}"
                                               ToolTipService.ToolTip="{CustomResource PaintArrow}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="4">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintArrow />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <controls:AnimatedIconToggleButton x:Name="MarkerTool"
                                               Click="Tool_Click"
                                               Glyph="&#xF79A;"
                                               CheckedGlyph="&#xF79A;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintMarker}"
                                               ToolTipService.ToolTip="{CustomResource PaintMarker}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="5">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintMarker />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <controls:AnimatedIconToggleButton x:Name="NeonTool"
                                               Click="Tool_Click"
                                               Glyph="&#xF7A1;"
                                               CheckedGlyph="&#xF7A1;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintNeon}"
                                               ToolTipService.ToolTip="{CustomResource PaintNeon}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="6">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintNeon />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <controls:AnimatedIconToggleButton x:Name="BlurTool"
                                               Click="Tool_Click"
                                               Glyph="&#xF7A2;"
                                               CheckedGlyph="&#xF7A2;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintBlur}"
                                               ToolTipService.ToolTip="{CustomResource PaintBlur}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="7">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintBlur />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <controls:AnimatedIconToggleButton x:Name="EraserTool"
                                               Click="Tool_Click"
                                               Glyph="&#xE75C;"
                                               CheckedGlyph="&#xE75C;"
                                               IsOneWay="True"
                                               AutomationProperties.Name="{CustomResource PaintEraser}"
                                               ToolTipService.ToolTip="{CustomResource PaintEraser}"
                                               Margin="0,0,-4,0"
                                               Grid.Column="8">
                <controls:AnimatedIconToggleButton.Source>
                    <icons:PaintEraser />
                </controls:AnimatedIconToggleButton.Source>
            </controls:AnimatedIconToggleButton>

            <!-- In place of the brushes on the text tab. -->
            <StackPanel x:Name="TextOptions"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Grid.Column="3"
                        Grid.ColumnSpan="6">
                <controls:GlyphButton x:Name="AlignButton"
                                      Click="AlignButton_Click"
                                      Glyph="&#xEB12;"
                                      AutomationProperties.Name="{CustomResource ArticleAlignment}"
                                      ToolTipService.ToolTip="{CustomResource ArticleAlignment}"
                                      Margin="0,0,-4,0" />

                <Grid Margin="0,0,-4,0">
                    <controls:GlyphButton Click="FrameButton_Click"
                                          Glyph=""
                                          AutomationProperties.Name="{CustomResource PaintTextBackground}"
                                          ToolTipService.ToolTip="{CustomResource PaintTextBackground}" />

                    <!-- Over the button rather than in it: GlyphButton draws only its glyph. -->
                    <Grid Width="20"
                          Height="20"
                          IsHitTestVisible="False">
                        <Border x:Name="FrameFilled"
                                Background="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                CornerRadius="5">
                            <TextBlock Text="A"
                                       Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FrameTranslucent"
                                Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                CornerRadius="5"
                                Visibility="Collapsed">
                            <TextBlock Text="A"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="FrameSolid"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                BorderThickness="1.5"
                                CornerRadius="5"
                                Visibility="Collapsed">
                            <TextBlock Text="A"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="FrameNone"
                                   Text="A"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <controls:GlyphButton x:Name="FontButton"
                                      Click="FontButton_Click"
                                      FontSize="15"
                                      Width="Auto"
                                      AutomationProperties.Name="{CustomResource FontType}"
                                      ToolTipService.ToolTip="{CustomResource FontType}"
                                      Margin="0,0,-4,0" />

                <controls:GlyphButton Click="AddText_Click"
                                      Glyph="&#xE710;"
                                      AutomationProperties.Name="{CustomResource AccDescrPlaceText}"
                                      ToolTipService.ToolTip="{CustomResource AccDescrPlaceText}"
                                      Margin="0,0,-4,0" />
            </StackPanel>
        </Grid>

        <controls:PencilWeightSlider x:Name="WeightSlider"
                                     x:Load="False"
                                     ValueChanged="WeightSlider_ValueChanged"
                                     DragStarted="WeightSlider_DragStarted"
                                     DragCompleted="WeightSlider_DragCompleted"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="{CustomResource PaintSize}" />

        <Ellipse x:Name="WeightPreview"
                 x:Load="False"
                 Fill="#FFFFFFFF"
                 Stroke="#40000000"
                 StrokeThickness="1"
                 Visibility="Collapsed"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <Grid x:Name="TrimToolbar"
              x:Load="False"
              HorizontalAlignment="Center"
              Margin="24,0,24,8"
              Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:GlyphToggleButton x:Name="MuteButton"
                                        Click="MuteButton_Click"
                                        Glyph="&#xE995;"
                                        CheckedGlyph="&#xE74F;"
                                        Background="{ThemeResource SystemControlChromeMediumLowAcrylicElementMediumBrush}"
                                        CornerRadius="15"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />

            <Grid Grid.Column="1">
                <Grid x:Name="TrimThumbnails"
                      Height="40"
                      Width="296"
                      CornerRadius="4" />
                <controls:VideoRangeSlider x:Name="TrimRange"
                                           MinimumChanged="TrimRange_MinimumChanged"
                                           MaximumChanged="TrimRange_MaximumChanged"
                                           Height="40"
                                           Width="296" />
            </Grid>
        </Grid>

        <Grid x:Name="Commands"
              Background="{ThemeResource SystemControlChromeMediumLowAcrylicElementMediumBrush}"
              HorizontalAlignment="Center"
              Margin="24,0,24,24"
              CornerRadius="15"
              Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:GlyphButton Click="Cancel_Click"
                                  Glyph="&#xE711;"
                                  CornerRadius="13,4,4,13"
                                  Margin="0,0,-4,0"
                                  AutomationProperties.Name="{CustomResource Close}"
                                  ToolTipService.ToolTip="{CustomResource Close}" />

            <Rectangle Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                       Margin="4,12,4,12"
                       Width="{ThemeResource MenuFlyoutSeparatorThemeHeight}"
                       Grid.Column="1" />

            <!--<controls:GlyphButton Glyph="&#xE7A8;" IsEnabled="False" Grid.Column="2"/>-->
            <Grid x:Name="BasicToolbar"
                  Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:GlyphToggleButton x:Name="Rotate"
                                            Click="Rotate_Click"
                                            Glyph="&#xE909;"
                                            CheckedGlyph="&#xE909;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            AutomationProperties.Name="{CustomResource AccDescrRotate}"
                                            ToolTipService.ToolTip="{CustomResource AccDescrRotate}" />

                <controls:GlyphToggleButton x:Name="Flip"
                                            Click="Flip_Click"
                                            Glyph="&#xE908;"
                                            CheckedGlyph="&#xE908;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            AutomationProperties.Name="{CustomResource AccDescrFlip}"
                                            ToolTipService.ToolTip="{CustomResource AccDescrFlip}"
                                            Grid.Column="1" />

                <controls:GlyphButton x:Name="Draw"
                                      Click="Draw_Click"
                                      Glyph="&#xEE56;"
                                      AutomationProperties.Name="{CustomResource AccDescrPhotoEditor}"
                                      ToolTipService.ToolTip="{CustomResource AccDescrPhotoEditor}"
                                      Grid.Column="2" />

                <controls:GlyphToggleButton x:Name="Proportions"
                                            Click="Proportions_Click"
                                            Glyph="&#xEA89;"
                                            CheckedGlyph="&#xEA89;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            AutomationProperties.Name="{CustomResource AccDescrAspectRatio}"
                                            ToolTipService.ToolTip="{CustomResource AccDescrAspectRatio}"
                                            Grid.Column="3" />

                <controls:GlyphButton x:Name="QualityButton"
                                      x:Load="False"
                                      Click="QualityButton_Click"
                                      FontSize="13"
                                      FontWeight="Bold"
                                      Width="Auto"
                                      MinWidth="40"
                                      AutomationProperties.Name="{CustomResource AccDescrVideoQuality}"
                                      ToolTipService.ToolTip="{CustomResource AccDescrVideoQuality}"
                                      Grid.Column="4">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                            <StackPanel Width="240">
                                <Grid>
                                    <TextBlock Text="{CustomResource AccDescrVideoCompressLow}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                    <TextBlock Text="{CustomResource AccDescrVideoCompressHigh}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="QualitySlider"
                                        ValueChanged="QualitySlider_ValueChanged"
                                        Minimum="0"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        TickPlacement="Outside"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="{CustomResource AccDescrVideoQuality}" />
                                <TextBlock x:Name="QualitySize"
                                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:GlyphButton>
            </Grid>

            <StackPanel x:Name="PaintTabs"
                        x:Load="False"
                        Orientation="Horizontal"
                        Grid.Column="2">
                <controls:GlyphToggleButton x:Name="DrawTab"
                                            Click="DrawTab_Click"
                                            Glyph="&#xEE56;"
                                            CheckedGlyph="&#xEE56;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            IsOneWay="True"
                                            AutomationProperties.Name="{CustomResource PhotoEditorDraw}"
                                            ToolTipService.ToolTip="{CustomResource PhotoEditorDraw}" />

                <controls:GlyphToggleButton x:Name="StickerTab"
                                            Click="StickerTab_Click"
                                            Glyph="&#xF4AA;"
                                            CheckedGlyph="&#xF4AA;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            IsOneWay="True"
                                            AutomationProperties.Name="{CustomResource PhotoEditorSticker}"
                                            ToolTipService.ToolTip="{CustomResource PhotoEditorSticker}">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="StickerFlyout"
                                Opened="StickerFlyout_Opened"
                                Placement="Top"
                                ShowMode="Transient">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter"
                                       BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                                    <Setter Property="Padding"
                                            Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="320"
                                  Height="400">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <controls:TopNavView x:Name="PickerTabs"
                                                     SelectionChanged="PickerTabs_SelectionChanged"
                                                     HorizontalAlignment="Center"
                                                     Height="40"
                                                     Grid.Row="1">
                                    <controls:TopNavView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </controls:TopNavView.ItemsPanel>
                                    <controls:TopNavView.ItemContainerStyle>
                                        <Style TargetType="controls:TopNavViewItem">
                                            <Setter Property="Padding"
                                                    Value="8,1,8,0" />
                                            <Setter Property="BorderThickness"
                                                    Value="0,4,0,0" />
                                        </Style>
                                    </controls:TopNavView.ItemContainerStyle>
                                    <controls:TopNavViewItem Content="{CustomResource AccDescrStickers}" />
                                    <controls:TopNavViewItem Content="{CustomResource Emoji}" />
                                    <controls:TopNavViewItem Content="{CustomResource AccDescrGIFs}" />
                                </controls:TopNavView>

                                <drawers:StickerDrawer x:Name="StickerPicker"
                                                       x:Load="False"
                                                       ItemClick="StickerPicker_ItemClick" />

                                <drawers:ChatPhotoEmojiDrawer x:Name="EmojiPicker"
                                                              x:Load="False"
                                                              ItemClick="EmojiPicker_ItemClick" />

                                <drawers:AnimationDrawer x:Name="GifPicker"
                                                         x:Load="False"
                                                         ItemClick="GifPicker_ItemClick" />
                            </Grid>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:GlyphToggleButton>

                <controls:GlyphToggleButton x:Name="TextTab"
                                            Click="TextTab_Click"
                                            Glyph="&#xE8D2;"
                                            CheckedGlyph="&#xE8D2;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            IsOneWay="True"
                                            AutomationProperties.Name="{CustomResource PhotoEditorText}"
                                            ToolTipService.ToolTip="{CustomResource PhotoEditorText}" />

                <controls:GlyphToggleButton x:Name="ShapesTab"
                                            Click="ShapesTab_Click"
                                            Glyph="&#xE9E8;"
                                            CheckedGlyph="&#xE9E8;"
                                            CheckedForeground="{ThemeResource TelegramBackgroundAccentBrush}"
                                            IsOneWay="True"
                                            AutomationProperties.Name="{CustomResource PaintShapes}"
                                            ToolTipService.ToolTip="{CustomResource PaintShapes}">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout x:Name="ShapesFlyout"
                                    Opening="ShapesFlyout_Opening"
                                    Placement="Top">
                            <MenuFlyoutItem x:Name="CircleItem"
                                            Click="ShapeItem_Click"
                                            Text="{CustomResource PaintCircle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="CircleIcon"
                                              Glyph="&#xF7A4;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="RectangleItem"
                                            Click="ShapeItem_Click"
                                            Text="{CustomResource PaintRectangle}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="RectangleIcon"
                                              Glyph="&#xF7A6;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="StarItem"
                                            Click="ShapeItem_Click"
                                            Text="{CustomResource PaintStar}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="StarIcon"
                                              Glyph="&#xE734;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="BubbleItem"
                                            Click="ShapeItem_Click"
                                            Text="{CustomResource PaintBubble}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="BubbleIcon"
                                              Glyph="&#xE8BD;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ArrowItem"
                                            Click="ShapeItem_Click"
                                            Text="{CustomResource PaintArrow}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xF7A0;"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <controls:MenuFlyoutContent>
                                <controls:MenuFlyoutContent.Content>
                                    <CheckBox x:Name="ShapeFilled"
                                              Content="{CustomResource PaintShapeFilled}"
                                              Checked="ShapeFilled_Changed"
                                              Unchecked="ShapeFilled_Changed" />
                                </controls:MenuFlyoutContent.Content>
                            </controls:MenuFlyoutContent>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:GlyphToggleButton>
            </StackPanel>

            <Rectangle Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                       Margin="4,12,4,12"
                       Width="{ThemeResource MenuFlyoutSeparatorThemeHeight}"
                       Grid.Column="3" />

            <controls:GlyphButton Click="Accept_Click"
                                  Glyph="&#xE10B;"
                                  AllowFocusOnInteraction="False"
                                  Foreground="{ThemeResource TelegramBackgroundAccentBrush}"
                                  HorizontalAlignment="Right"
                                  CornerRadius="4,13,13,4"
                                  Margin="-4,0,0,0"
                                  AutomationProperties.Name="{CustomResource Done}"
                                  ToolTipService.ToolTip="{CustomResource Done}"
                                  Grid.Column="4" />

        </Grid>
    </Grid>
</controls:OverlayWindow>
