<controls:OverlayWindow x:Class="Telegram.Views.Popups.EditMediaPopup"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Telegram.Views.Popups"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:xaml="using:Microsoft.Graphics.Canvas.UI.Xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        mc:Ignorable="d"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Background="{x:Null}"
                        OverlayBrush="#CC000000"
                        RequestedTheme="Dark"
                        PreviewKeyDown="OnPreviewKeyDown"
                        ProcessKeyboardAccelerators="OnProcessKeyboardAccelerators">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:MediaEditorSurface x:Name="Surface"
                                     Grid.Row="2" />

        <!-- What applies to the whole edit, at the ends; the tabs between. -->
        <Grid Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <controls:GlyphButton Click="Cancel_Click"
                                      Glyph="&#xE711;"
                                      Width="40"
                                      Height="40"
                                      Padding="0"
                                      AutomationProperties.Name="{CustomResource Close}"
                                      ToolTipService.ToolTip="{CustomResource Close}" />

                <Rectangle Fill="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                           Margin="8,12,8,12"
                           Width="{ThemeResource MenuFlyoutSeparatorThemeHeight}" />

                <controls:GlyphButton x:Name="UndoButton"
                                      Click="Undo_Click"
                                      Glyph="&#xE7A7;"
                                      IsEnabled="False"
                                      Width="40"
                                      Height="40"
                                      Padding="0"
                                      AutomationProperties.Name="{CustomResource Undo}"
                                      ToolTipService.ToolTip="{CustomResource Undo}" />

                <controls:GlyphButton x:Name="RedoButton"
                                      Click="Redo_Click"
                                      Glyph="&#xE7A6;"
                                      IsEnabled="False"
                                      Width="40"
                                      Height="40"
                                      Padding="0"
                                      AutomationProperties.Name="{CustomResource Redo}"
                                      ToolTipService.ToolTip="{CustomResource Redo}" />
            </StackPanel>

            <controls:PaintTabs x:Name="PaintTabs"
                                CroppingChanged="PaintTabs_CroppingChanged"
                                Grid.Column="1" />

            <Button Click="Accept_Click"
                    Content="{CustomResource Done}"
                    Style="{StaticResource AccentButtonStyle}"
                    AllowFocusOnInteraction="False"
                    MinWidth="80"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Grid.Column="2" />
        </Grid>

        <!-- The open tab's options, the crop's or the drawing's, which slide past each other. -->
        <controls:CropToolbar x:Name="CropToolbar"
                              Margin="12,8,12,0"
                              Grid.Row="1" />

        <!-- Over the media too, where its size preview shows. -->
        <controls:PaintToolbar x:Name="PaintToolbar"
                               x:Load="False"
                               Margin="12,8,12,0"
                               Grid.Row="1"
                               Grid.RowSpan="2" />

        <controls:TrimToolbar x:Name="TrimToolbar"
                              x:Load="False"
                              Margin="24,0,24,8"
                              Grid.Row="3">
            <controls:TrimToolbar.Accessory>
                <controls:GlyphButton x:Name="QualityButton"
                                      Visibility="Collapsed"
                                      Click="QualityButton_Click"
                                      AutomationProperties.Name="{CustomResource AccDescrVideoQuality}"
                                      ToolTipService.ToolTip="{CustomResource AccDescrVideoQuality}"
                                      VerticalAlignment="Center">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Top">
                            <StackPanel Width="240">
                                <Grid>
                                    <TextBlock Text="{CustomResource Quality}"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}" />
                                    <TextBlock x:Name="QualityName"
                                               Style="{StaticResource InfoCaptionTextBlockStyle}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Slider x:Name="QualitySlider"
                                        ValueChanged="QualitySlider_ValueChanged"
                                        Minimum="0"
                                        StepFrequency="1"
                                        TickFrequency="1"
                                        TickPlacement="Outside"
                                        SnapsTo="StepValues"
                                        IsThumbToolTipEnabled="False"
                                        AutomationProperties.Name="{CustomResource AccDescrVideoQuality}" />
                                <TextBlock x:Name="QualitySize"
                                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:GlyphButton>
            </controls:TrimToolbar.Accessory>
        </controls:TrimToolbar>
    </Grid>
</controls:OverlayWindow>
