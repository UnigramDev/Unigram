<controls:ModalPopup x:Class="Telegram.Views.Popups.QrCodePopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:drawers="using:Telegram.Controls.Drawers"
                     xmlns:local="using:Telegram.Views.Popups"
                     Padding="0"
                     ContentMinWidth="400"
                     ContentMaxWidth="400"
                     ContentMinHeight="680"
                     ContentMaxHeight="680"
                     VerticalContentAlignment="Stretch"
                     Closing="OnClosing"
                     Opened="OnOpened"
                     Closed="OnClosed"
                     mc:Ignorable="d">

    <controls:ModalPopup.Resources>
        <ResourceDictionary>
            <!-- The foregrounds and overlays here follow the scene's theme, which is light on a pale backdrop and
                 dark otherwise. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="QrForegroundBrush"
                                     Color="#FFFFFF" />
                    <SolidColorBrush x:Key="QrSubtleForegroundBrush"
                                     Color="#A6FFFFFF" />
                    <SolidColorBrush x:Key="QrOverlayBrush"
                                     Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="QrForegroundBrush"
                                     Color="#1A1D21" />
                    <SolidColorBrush x:Key="QrSubtleForegroundBrush"
                                     Color="#8C1A1D21" />
                    <SolidColorBrush x:Key="QrOverlayBrush"
                                     Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The QR colour, matched to the backdrop; the code, its logo, the name and the free chip share it. -->
            <SolidColorBrush x:Name="InkBrush"
                             Color="#0075F1" />

            <!-- The chip's fill as the code turns free, and the text on it. -->
            <SolidColorBrush x:Key="ChipFillBrush"
                             Color="#F7FFFFFF" />
            <SolidColorBrush x:Name="ChipFillForegroundBrush"
                             Color="#0075F1" />

            <Style x:Key="QrSurfaceButtonStyle"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}" />
                <Setter Property="Foreground"
                        Value="{ThemeResource QrForegroundBrush}" />
                <Setter Property="FontFamily"
                        Value="{StaticResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize"
                        Value="20" />
                <Setter Property="CornerRadius"
                        Value="20" />
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="Width"
                        Value="40" />
                <Setter Property="Height"
                        Value="40" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="UseSystemFocusVisuals"
                        Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity"
                                                        Value="0.1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity"
                                                        Value="0.2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Opacity"
                                                        Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Overlay"
                                        Background="{ThemeResource QrOverlayBrush}"
                                        Opacity="0" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QrPickButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource QrSurfaceButtonStyle}">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="0" />
                <Setter Property="CornerRadius"
                        Value="0" />
            </Style>

            <!-- Close, share and save: the surface is the border, so hovering tints it rather than replaces it. -->
            <Style x:Key="QrSurfaceStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}" />
                <Setter Property="CornerRadius"
                        Value="20" />
                <Setter Property="Width"
                        Value="40" />
                <Setter Property="Height"
                        Value="40" />
            </Style>

            <Style x:Key="QrGlyphButtonStyle"
                   TargetType="controls:GlyphButton"
                   BasedOn="{StaticResource DefaultGlyphButtonStyle}">
                <Setter Property="Foreground"
                        Value="{ThemeResource QrForegroundBrush}" />
                <Setter Property="FontSize"
                        Value="20" />
                <Setter Property="CornerRadius"
                        Value="19" />
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Height"
                        Value="Auto" />
                <Setter Property="HorizontalAlignment"
                        Value="Stretch" />
                <Setter Property="VerticalAlignment"
                        Value="Stretch" />
            </Style>

            <Style x:Key="QrIslandButtonStyle"
                   TargetType="controls:GlyphButton"
                   BasedOn="{StaticResource QrGlyphButtonStyle}">
                <Setter Property="FontSize"
                        Value="22" />
                <Setter Property="CornerRadius"
                        Value="0" />
            </Style>

            <Style x:Key="QrChipButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource QrSurfaceButtonStyle}">
                <Setter Property="FontFamily"
                        Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize"
                        Value="12" />
                <Setter Property="CornerRadius"
                        Value="12" />
                <Setter Property="Padding"
                        Value="8,0,12,0" />
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Height"
                        Value="24" />
            </Style>

            <Style x:Key="QrPillButtonStyle"
                   TargetType="Button">
                <Setter Property="Background"
                        Value="#FFFFFF" />
                <Setter Property="Foreground"
                        Value="{StaticResource InkBrush}" />
                <Setter Property="FontSize"
                        Value="14" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="CornerRadius"
                        Value="18" />
                <Setter Property="Padding"
                        Value="20,0" />
                <Setter Property="Height"
                        Value="36" />
                <Setter Property="UseSystemFocusVisuals"
                        Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity"
                                                        Value="0.06" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Overlay.Opacity"
                                                        Value="0.12" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Overlay"
                                        Background="#000000"
                                        Opacity="0" />
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The selection is a white ring inside the swatch, so its colour shows on both sides of it. -->
            <Style x:Key="QrSwatchItemStyle"
                   TargetType="GridViewItem">
                <Setter Property="Margin"
                        Value="0" />
                <Setter Property="Padding"
                        Value="0" />
                <Setter Property="MinWidth"
                        Value="0" />
                <Setter Property="MinHeight"
                        Value="0" />
                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch" />
                <Setter Property="VerticalContentAlignment"
                        Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals"
                        Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Ellipse x:Name="Ring"
                                         Stroke="#FFFFFF"
                                         StrokeThickness="2"
                                         Width="36"
                                         Height="36"
                                         Opacity="0"
                                         IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QrGiftItemStyle"
                   TargetType="GridViewItem"
                   BasedOn="{StaticResource QrSwatchItemStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity"
                                                        Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="4" />
                                <Border x:Name="Ring"
                                        BorderBrush="#FFFFFF"
                                        BorderThickness="2"
                                        CornerRadius="18"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A picked emoji's place in the order. -->
            <DataTemplate x:Name="PickBadgeTemplate"
                          x:DataType="x:String">
                <Grid Width="16"
                      Height="16">
                    <Ellipse Fill="{ThemeResource MenuFlyoutPresenterBackground}"
                             Stroke="{ThemeResource MenuFlyoutPresenterBorderBrush}"
                             StrokeThickness="1" />
                    <TextBlock Text="{x:Bind}"
                               Foreground="{ThemeResource QrForegroundBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="QrEmojiTemplate"
                          x:DataType="controls:QrShareEmoji">
                <controls:AnimatedImage Source="{x:Bind Source}"
                                        FrameSize="64,64"
                                        DecodeFrameType="Logical"
                                        AutoPlay="True"
                                        IsViewportAware="False" />
            </DataTemplate>
        </ResourceDictionary>
    </controls:ModalPopup.Resources>

    <Grid x:Name="LayoutRoot"
          SizeChanged="OnSizeChanged"
          CornerRadius="8">
        <!-- What sharing renders: the scene and the card, without the controls. -->
        <Grid x:Name="ShareRoot">
            <controls:QrShareBackground x:Name="Scene"
                                        EmojiTemplate="{StaticResource QrEmojiTemplate}" />

            <Grid x:Name="CardRoot"
                  Width="300"
                  Height="336"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top">
                <!-- Shrinks while the sheet is open, apart from the bounces, which scale CardRoot. -->
                <Grid x:Name="CardScaler">
                    <Rectangle x:Name="CardShadow"
                               Fill="#FFFFFF"
                               RadiusX="28"
                               RadiusY="28" />
                    <Grid Background="#FFFFFF"
                          CornerRadius="28">
                        <Border x:Name="Code"
                                Background="{StaticResource InkBrush}"
                                Width="222"
                                Height="222"
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top" />

                        <controls:AnimatedImage x:Name="Logo"
                                                Source="ms-appx:///Assets/Animations/QrLogo.json"
                                                Width="32"
                                                Height="32"
                                                FrameSize="32,32"
                                                DecodeFrameType="Logical"
                                                AutoPlay="True"
                                                Margin="0,135,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top" />

                        <Viewbox x:Name="UsernameRoot"
                                 StretchDirection="DownOnly"
                                 Height="36"
                                 Margin="20,276,20,0"
                                 VerticalAlignment="Top">
                            <controls:AnimatedTextBlock x:Name="Username"
                                                        Foreground="{StaticResource InkBrush}"
                                                        TextAlignment="Center">
                                <controls:AnimatedTextBlock.TextStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily"
                                                Value="/Assets/Fonts/Nunito.ttf#Nunito" />
                                        <Setter Property="FontWeight"
                                                Value="Bold" />
                                        <Setter Property="FontSize"
                                                Value="28" />
                                    </Style>
                                </controls:AnimatedTextBlock.TextStyle>
                            </controls:AnimatedTextBlock>
                        </Viewbox>
                    </Grid>

                    <!-- Reaches past the card, for the dust a changing code throws off. -->
                    <controls:QrCodeTransition x:Name="CodeTransition"
                                               Completed="CodeTransition_Completed"
                                               Margin="-60,-100,-60,-20" />
                </Grid>
            </Grid>
        </Grid>

        <Rectangle x:Name="SheetDismiss"
                   Fill="Transparent"
                   Visibility="Collapsed"
                   Tapped="SheetDismiss_Tapped" />

        <!-- Burns down from the right as a temporary code runs out: the fill and its text are clipped away,
             leaving the same text on the button. -->
        <Grid x:Name="ChipRoot"
              Visibility="Collapsed"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Button x:Name="Chip"
                    Click="Chip_Click"
                    Style="{StaticResource QrChipButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ChipGlyph"
                               Text="&#xE8D9;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <!-- With the icon font behind the text font, for the star inside the fee's label. -->
                    <TextBlock x:Name="ChipText"
                               FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Inside the button's border, which stays visible around it, so its padding is the button's and
                 the two texts line up exactly. -->
            <Grid x:Name="ChipFill"
                  Background="{StaticResource ChipFillBrush}"
                  CornerRadius="11"
                  Margin="1"
                  Padding="8,0,12,0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D9;"
                               Foreground="{StaticResource ChipFillForegroundBrush}"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ChipFillText"
                               Foreground="{StaticResource ChipFillForegroundBrush}"
                               FontSize="12"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <controls:QrChipSparks x:Name="ChipSparks" />
        </Grid>

        <Border x:Name="CloseSurface"
                Style="{StaticResource QrSurfaceStyle}"
                Margin="0,8,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
            <controls:GlyphButton Click="Close_Click"
                                  Glyph="&#xE711;"
                                  Style="{StaticResource QrGlyphButtonStyle}"
                                  AutomationProperties.Name="{CustomResource Close}" />
        </Border>

        <Border x:Name="ShareSurface"
                Style="{StaticResource QrSurfaceStyle}"
                Margin="8,0,0,8"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom">
            <controls:GlyphButton x:Name="ShareButton"
                                  Click="Share_Click"
                                  Glyph="&#xE72D;"
                                  Style="{StaticResource QrGlyphButtonStyle}"
                                  AutomationProperties.Name="{CustomResource ShareQrCode}" />
        </Border>

        <Border x:Name="SaveSurface"
                Style="{StaticResource QrSurfaceStyle}"
                Margin="0,0,8,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <controls:GlyphButton x:Name="SaveButton"
                                  Click="Save_Click"
                                  Glyph="&#xE118;"
                                  Style="{StaticResource QrGlyphButtonStyle}"
                                  AutomationProperties.Name="{CustomResource SaveAs}" />
        </Border>

        <Grid x:Name="Island"
              Visibility="Collapsed"
              Width="120"
              Height="40"
              Margin="0,0,0,8"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom">
            <Border x:Name="IslandSurface"
                    Background="{ThemeResource MenuFlyoutPresenterBackground}"
                    BorderBrush="{ThemeResource MenuFlyoutPresenterBorderBrush}"
                    BorderThickness="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}"
                    CornerRadius="20" />
        </Grid>

        <!-- The sheet's shadow, laid out where the sheet is: it follows the morph from code, behind it. -->
        <Border x:Name="SheetShadow"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Margin="8,0,8,8"
                VerticalAlignment="Bottom" />

        <!-- The island grows into this: its clip starts on the island and opens to the whole sheet. -->
        <Grid x:Name="Sheet"
              Visibility="Collapsed"
              Margin="8,0,8,8"
              VerticalAlignment="Bottom">
            <Border Background="{ThemeResource MenuFlyoutPresenterBackground}"
                    CornerRadius="20" />

            <Grid x:Name="SheetContent">
                <GridView x:Name="ColorsList"
                          ItemClick="ColorsList_ItemClick"
                          ContainerContentChanging="ColorsList_ContainerContentChanging"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          ItemContainerStyle="{StaticResource QrSwatchItemStyle}"
                          Padding="12"
                          Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="60"
                                           ItemHeight="60" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:QrShareColorOption">
                            <!-- The rim reaches 3 past the circle. -->
                            <Grid Width="48"
                                  Height="48">
                                <Ellipse Fill="{x:Bind Fill}"
                                         Margin="3" />
                                <controls:QrGlassRim Kind="Swatch" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Grid x:Name="GiftsRoot"
                      Visibility="Collapsed">
                    <!-- One to three gifts share a single row between them. -->
                    <GridView x:Name="GiftsList"
                              ItemClick="GiftsList_ItemClick"
                              ContainerContentChanging="GiftsList_ContainerContentChanging"
                              IsItemClickEnabled="True"
                              SelectionMode="Single"
                              ItemContainerStyle="{StaticResource QrGiftItemStyle}"
                              Padding="12">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="120"
                                               ItemHeight="120" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <controls:PatternBackground CornerRadius="16">
                                        <Border Width="88" />
                                    </controls:PatternBackground>
                                    <controls:AnimatedImage Width="72"
                                                            Height="72"
                                                            FrameSize="72,72"
                                                            DecodeFrameType="Logical"
                                                            AutoPlay="False"
                                                            IsViewportAware="True" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel x:Name="GiftsEmpty"
                                Visibility="Collapsed"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <controls:AnimatedImage x:Name="GiftsEmptyAnimation"
                                                Width="100"
                                                Height="100"
                                                FrameSize="100,100"
                                                DecodeFrameType="Logical"
                                                AutoPlay="True"
                                                IsViewportAware="False" />
                        <TextBlock Text="{CustomResource QrNoGiftsTitle}"
                                   Foreground="{ThemeResource QrForegroundBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="{CustomResource QrNoGiftsInfo}"
                                   Foreground="{ThemeResource QrSubtleForegroundBrush}"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0" />
                        <Button Click="BrowseGifts_Click"
                                Content="{CustomResource QrBrowseGifts}"
                                Style="{StaticResource QrPillButtonStyle}"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="EmojiRoot"
                      Visibility="Collapsed">
                    <drawers:ShareThemeEmojiDrawer x:Name="EmojiPanel"
                                                   ItemClick="Emoji_ItemClick" />

                    <!-- Order badges on the picked emoji, laid over the list's viewport. The inner canvas is in the
                         list's content coordinates and follows its scrolling on the compositor. -->
                    <Canvas x:Name="PickBadges"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Canvas x:Name="PickBadgesContent" />
                    </Canvas>

                    <!-- The picked emoji in order, floating over the list; tapping one takes it out. -->
                    <Grid x:Name="Picks"
                          Visibility="Collapsed"
                          Margin="0,8,0,8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom">
                        <Border x:Name="PicksSurface"
                                Background="{ThemeResource MenuFlyoutPresenterBackground}"
                                BorderBrush="{ThemeResource MenuFlyoutPresenterBorderBrush}"
                                BorderThickness="{ThemeResource MenuFlyoutPresenterBorderThemeThickness}"
                                CornerRadius="22">
                            <ItemsControl x:Name="PicksList"
                                          Margin="4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="controls:QrShareEmoji">
                                        <Button Click="Pick_Click"
                                                Style="{StaticResource QrPickButtonStyle}"
                                                Height="44">
                                            <controls:AnimatedImage Source="{x:Bind Source}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    FrameSize="28,28"
                                                                    DecodeFrameType="Logical"
                                                                    AutoPlay="True"
                                                                    IsViewportAware="False" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- The sheet's rim, laid out where the sheet is but not clipped by it: it follows the morph from code,
             stroked in this brush. -->
        <Border x:Name="SheetRim"
                BorderBrush="{ThemeResource MenuFlyoutPresenterBorderBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Margin="8,0,8,8"
                VerticalAlignment="Bottom" />

        <!-- Above the sheet, so they stay in sight while it shrinks back around them. -->
        <Grid x:Name="IslandIcons"
              CornerRadius="20"
              Visibility="Collapsed"
              Width="120"
              Height="40"
              Margin="0,0,0,8"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <controls:GlyphButton Click="Colors_Click"
                                  Glyph="&#xE2B1;"
                                  Style="{StaticResource QrIslandButtonStyle}"
                                  AutomationProperties.Name="{CustomResource QrProfileColors}" />
            <controls:GlyphButton Click="Emoji_Click"
                                  Glyph="&#xE76E;"
                                  Style="{StaticResource QrIslandButtonStyle}"
                                  AutomationProperties.Name="{CustomResource Emoji}"
                                  Grid.Column="1" />
            <controls:GlyphButton Click="Gifts_Click"
                                  Glyph="&#xEAD8;"
                                  Style="{StaticResource QrIslandButtonStyle}"
                                  AutomationProperties.Name="{CustomResource ProfileGifts}"
                                  Grid.Column="2" />
        </Grid>
    </Grid>
</controls:ModalPopup>
