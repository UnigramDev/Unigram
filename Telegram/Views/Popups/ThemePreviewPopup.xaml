<controls:ContentPopup x:Class="Telegram.Views.Popups.ThemePreviewPopup"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:common="using:Telegram.Common"
                       xmlns:controls="using:Telegram.Controls"
                       xmlns:cells="using:Telegram.Controls.Cells"
                       xmlns:chats="using:Telegram.Controls.Chats"
                       xmlns:messages="using:Telegram.Controls.Messages"
                       mc:Ignorable="d"
                       PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
                       Padding="0">

    <ContentDialog.Resources>
        <common:Theme x:Name="ThemePreview" />
    </ContentDialog.Resources>

    <Grid x:Name="LayoutRoot"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <FlipView CornerRadius="0"
                  Grid.Row="1">
            <FlipViewItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid x:Name="InfoPanel"
                          Background="{ThemeResource PageSubHeaderBackgroundBrush2}"
                          Canvas.ZIndex="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ProfilePicture x:Name="Photo"
                                                     Size="36"
                                                     Margin="12,0" />

                            <StackPanel Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="0,-2,0,2"
                                        Grid.Column="1">
                                <TextBlock x:Name="Title"
                                           Foreground="{ThemeResource PageHeaderForegroundBrush}"
                                           Style="{StaticResource BaseTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock x:Name="Subtitle"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border x:Name="CallPlaceholder"
                                    Visibility="Collapsed"
                                    Width="48"
                                    Grid.Column="2" />
                        </Grid>

                        <controls:GlyphButton Glyph="&#xE717;"
                                              AutomationProperties.Name="{CustomResource Call}"
                                              ToolTipService.ToolTip="{CustomResource Call}"
                                              Margin="0,0,-4,0"
                                              Grid.Column="1" />

                        <controls:MoreButton Grid.Column="2" />
                    </Grid>
                    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          Grid.RowSpan="2">
                        <chats:ChatBackgroundControl x:Name="BackgroundControl" />
                        <StackPanel x:Name="Bubbles"
                                    Padding="0,2,0,8"
                                    VerticalAlignment="Bottom">
                            <messages:MessageBubble x:Name="Message1"
                                                    HorizontalAlignment="Left" />
                            <messages:MessageBubble x:Name="Message2"
                                                    HorizontalAlignment="Right" />
                            <messages:MessageBubble x:Name="Message3"
                                                    HorizontalAlignment="Right" />
                            <messages:MessageBubble x:Name="Message4"
                                                    HorizontalAlignment="Left" />
                            <messages:MessageBubble x:Name="Message5"
                                                    HorizontalAlignment="Left" />
                            <messages:MessageBubble x:Name="Message6"
                                                    HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </FlipViewItem>
            <FlipViewItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBox x:Name="TitleLabel"
                                 PlaceholderText="{CustomResource ThemePreview}"
                                 BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                 Style="{StaticResource NoDeleteTextBoxStyle}"
                                 IsReadOnly="True"
                                 Margin="12,8" />
                        <controls:GlyphButton x:Name="ComposeButton"
                                              Glyph="&#xE996;"
                                              FontSize="16"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,0,12,0"
                                              Width="36"
                                              Height="32" />
                    </Grid>
                    <ListView x:Name="ChatList"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              Grid.Row="1">
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat1"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat2"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat3"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat4"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat5"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat6"
                                            IsEnabled="False" />
                        </ListViewItem>
                        <ListViewItem HorizontalContentAlignment="Stretch"
                                      Padding="0">
                            <cells:ChatCell x:Name="Chat7"
                                            IsEnabled="False" />
                        </ListViewItem>
                    </ListView>
                </Grid>
            </FlipViewItem>
        </FlipView>
    </Grid>
</controls:ContentPopup>
