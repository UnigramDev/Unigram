<controls:ModalPopup x:Class="Telegram.Views.Popups.SendLocationPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="using:Telegram.Views.Popups"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:cells="using:Telegram.Controls.Cells"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d"
                     Padding="12,24,12,12"
                     Opened="OnOpened"
                     Closed="OnClosed">

    <StackPanel>
        <!-- The interactive map is inserted above the static one, under the pin. -->
        <controls:AspectView x:Name="MapPresenter"
                             CornerRadius="4"
                             Margin="12,0">
            <controls:ImageView x:Name="Map"
                                ImageOpened="Map_ImageOpened" />
            <Border x:Name="MapShimmer"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4" />

            <Ellipse x:Name="Accuracy"
                     Opacity="0.5"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{ThemeResource MessageHeaderForegroundBrush}"
                     StrokeThickness="2" />

            <Canvas x:Name="Position"
                    Width="40"
                    Height="47.691"
                    Margin="0,-36,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
                <Path Width="40"
                      Height="47.691"
                      Data="F1M20,47.691C20,47.691 0,33.847 0,20 0,8.955 8.955,0 20,0 31.044,0 40,8.955 40,20 40,33.847 20,47.691 20,47.691"
                      Fill="{ThemeResource MessageHeaderForegroundBrush}"
                      StrokeThickness="0" />
                <Path Width="14"
                      Height="14"
                      Data="F1M7,0C3.135,0 0,3.136 0,7 0,10.865 3.135,14 7,14 10.865,14 14,10.865 14,7 14,3.136 10.865,0 7,0"
                      Fill="White"
                      StrokeThickness="0"
                      Canvas.Left="13"
                      Canvas.Top="13" />
            </Canvas>

            <Button x:Name="MapButton"
                    Click="MapButton_Click"
                    Content="{CustomResource BusinessLocationMap}"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Style="{StaticResource AccentButtonStyle}" />
        </controls:AspectView>

        <Button x:Name="SelectedLocationButton"
                Click="SelectedLocation_Click"
                Visibility="Collapsed"
                Background="Transparent"
                Padding="0"
                Margin="0,6,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Style="{StaticResource EmptyButtonStyle}">
            <cells:VenueCell x:Name="SelectedLocation"
                             Glyph="&#xE1C4;"
                             Title="{CustomResource SendSelectedLocation}"
                             Address="{CustomResource Loading}"
                             SelectionStroke="{ThemeResource ContentDialogTopOverlaySolid}"
                             Margin="12,6" />
        </Button>

        <Button x:Name="CurrentLocationButton"
                Click="CurrentLocation_Click"
                Background="Transparent"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Style="{StaticResource EmptyButtonStyle}">
            <cells:VenueCell x:Name="CurrentLocation"
                             Glyph="&#xE9F0;"
                             Title="{CustomResource SendLocation}"
                             Address="{CustomResource Loading}"
                             SelectionStroke="{ThemeResource ContentDialogTopOverlaySolid}"
                             Margin="12,6" />
        </Button>
    </StackPanel>
</controls:ModalPopup>
