<controls:WindowContent x:Class="Telegram.Views.Host.RichTextWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                        xmlns:common="using:Telegram.Common"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:drawers="using:Telegram.Controls.Drawers"
                        xmlns:richEditor="using:Telegram.Controls.RichEditor"
                        xmlns:chats="using:Telegram.Controls.Chats"
                        mc:Ignorable="d">

    <controls:WindowContent.Resources>
        <Style TargetType="controls:GlyphToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="UncheckedForeground"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="CheckedForeground"
                    Value="{ThemeResource SystemControlHighlightBaseMediumHighBrush}" />
            <Setter Property="BorderBrush"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalAlignment"
                    Value="Left" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Top" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="FontFamily"
                    Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize"
                    Value="{StaticResource GlyphMediumFontSize}" />
            <Setter Property="FontWeight"
                    Value="Normal" />
            <Setter Property="Height"
                    Value="48" />
            <Setter Property="Width"
                    Value="48" />
            <Setter Property="UseSystemFocusVisuals"
                    Value="True" />
            <Setter Property="FocusVisualMargin"
                    Value="-3" />
            <Setter Property="CornerRadius"
                    Value="{StaticResource GlyphButtonCornerRadius}" />
            <Setter Property="Padding"
                    Value="{StaticResource GlyphButtonPadding}" />
            <!--<Setter Property="IsOneWay"
                    Value="False" />-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:GlyphToggleButton">
                        <Grid Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Margin="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.1" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="CheckedBackground.Opacity"
                                                    Value="0.15" />
                                        </VisualState.Setters>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TelegramBackgroundAccentBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground"
                                                                           Storyboard.TargetName="ContentPresenter">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="RootGrid">
                                <Border x:Name="CheckedBackground"
                                        Background="{ThemeResource TelegramBackgroundAccentBrush}"
                                        Opacity="0" />
                                <TextBlock x:Name="ContentPresenter"
                                           Margin="{TemplateBinding Padding}"
                                           Foreground="{TemplateBinding UncheckedForeground}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{TemplateBinding Glyph}" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  On a tool whose feature needs Premium, for a user without it, as TDesktop marks them.  -->
        <Style x:Key="ToolbarPremiumStyle"
               TargetType="TextBlock">
            <Setter Property="Text"
                    Value="&#xE9B5;" />
            <Setter Property="Foreground"
                    Value="{ThemeResource PremiumObliqueGradientBrush}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
            <Setter Property="VerticalAlignment"
                    Value="Bottom" />
            <Setter Property="Margin"
                    Value="0,0,5,6" />
            <Setter Property="IsHitTestVisible"
                    Value="False" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Setter Property="AutomationProperties.AccessibilityView"
                    Value="Raw" />
        </Style>

    </controls:WindowContent.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarrr"
              Height="40"
              Margin="12,0,0,0"
              Background="Transparent"
              Grid.Column="1"
              Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TitleBarHandle"
                    Background="Transparent"
                    Grid.Column="2" />

            <HyperlinkButton x:Name="TitleBarLogo"
                             Style="{StaticResource EmptyHyperlinkButtonStyle}"
                             IsTabStop="False"
                             Margin="-10,0,4,0"
                             Width="40"
                             Height="40"
                             Grid.Column="1">
                <Grid Background="Transparent">
                    <Border x:Name="LogoBasic"
                            Width="20"
                            Height="20"
                            CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="4.44444,3.33333"
                                                 EndPoint="18.8889,16.6667"
                                                 MappingMode="Absolute">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStopCollection>
                                        <GradientStop Color="#29C3FF" />
                                        <GradientStop Offset="1"
                                                      Color="#2052CB" />
                                    </GradientStopCollection>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M4.52684 9.89446C7.44204 8.62435 9.38597 7.78702 10.3586 7.38246C13.1357 6.22737 13.7128 6.02672 14.0889 6.02009C14.1716 6.01863 14.3566 6.03913 14.4764 6.13635C14.5776 6.21844 14.6054 6.32934 14.6187 6.40717C14.632 6.485 14.6486 6.6623 14.6354 6.80083C14.485 8.38207 13.8338 12.2193 13.5025 13.9903C13.3623 14.7397 13.0863 14.991 12.8191 15.0156C12.2384 15.069 11.7974 14.6318 11.2349 14.2631C10.3548 13.6861 9.85759 13.327 9.00328 12.764C8.01596 12.1134 8.656 11.7558 9.21866 11.1714C9.36592 11.0184 11.9246 8.69115 11.9741 8.48003C11.9803 8.45362 11.986 8.3552 11.9276 8.30323C11.8691 8.25126 11.7828 8.26903 11.7205 8.28316C11.6322 8.3032 10.2262 9.23253 7.50246 11.0711C7.10337 11.3452 6.74188 11.4787 6.418 11.4717C6.06095 11.464 5.37413 11.2698 4.86355 11.1039C4.23729 10.9003 3.73956 10.7927 3.7829 10.4469C3.80548 10.2669 4.05346 10.0827 4.52684 9.89446Z"
                              Fill="#FFFFFF" />
                    </Border>
                </Grid>
            </HyperlinkButton>

            <TextBlock x:Name="StateLabel"
                       VerticalAlignment="Center"
                       TextLineBounds="TrimToCapHeight"
                       TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{ThemeResource PageHeaderForegroundBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       IsHitTestVisible="False"
                       Margin="0,2,6,0"
                       Grid.Column="2" />
        </Grid>

        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Grid.Row="2"
                Grid.RowSpan="2" />
        <!-- Under the toolbars, which float over it: the padding is what keeps the first and
             last lines clear of them. -->
        <richEditor:RichEditorView x:Name="Editor"
                                   Padding="12,12,12,88"
                                   MaxContentWidth="720"
                                   AutomationProperties.Name="{CustomResource ArticleEditor}"
                                   Grid.Row="2"
                                   Grid.RowSpan="2" />

        <!--  Laid out as TDesktop's editor: history at the left, the tools in the middle and
              emoji at the right, all at the top; Send alone at the bottom.  -->
        <Grid x:Name="ToolbarRoot"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource TabViewBorderBrush}"
                    BorderThickness="0,1,0,1"
                    Grid.ColumnSpan="3" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:GlyphButton x:Name="UndoButton"
                                      AutomationProperties.Name="{CustomResource TextUndo}"
                                      ToolTipService.ToolTip="{CustomResource TextUndo}"
                                      Click="Undo_Click"
                                      IsEnabled="False"
                                      AllowFocusOnInteraction="False"
                                      Glyph="&#xE7A7;"
                                      CornerRadius="20" />
                <controls:GlyphButton x:Name="RedoButton"
                                      AutomationProperties.Name="{CustomResource Redo}"
                                      ToolTipService.ToolTip="{CustomResource Redo}"
                                      Click="Redo_Click"
                                      IsEnabled="False"
                                      AllowFocusOnInteraction="False"
                                      Glyph="&#xE7A6;"
                                      CornerRadius="20"
                                      Margin="-8,0,0,0"
                                      Grid.Column="1" />
            </Grid>

            <Border BorderBrush="{ThemeResource TabViewBorderBrush}"
                    BorderThickness="1,0,1,0"
                    Margin="0,8"
                    Grid.Column="1" />

            <!--  Scrolls when the window is too narrow for all of it.  -->
            <Grid HorizontalAlignment="Center"
                  Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Auto"
                              CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <controls:GlyphButton x:Name="ParagraphButton"
                                              AutomationProperties.Name="{CustomResource Formatting}"
                                              ToolTipService.ToolTip="{CustomResource Formatting}"
                                              Click="Paragraph_Click"
                                              AllowFocusOnInteraction="False"
                                              Glyph="&#xEB23;"
                                              CornerRadius="20" />
                        <controls:GlyphButton x:Name="TextStyleButton"
                                              AutomationProperties.Name="{CustomResource AccDescrIVTextStyle}"
                                              ToolTipService.ToolTip="{CustomResource AccDescrIVTextStyle}"
                                              Click="TextStyle_Click"
                                              AllowFocusOnInteraction="False"
                                              Glyph="&#xE8DD;"
                                              CornerRadius="20"
                                              Margin="-8,0,0,0" />
                        <Grid Margin="-8,0,0,0">
                            <controls:GlyphToggleButton x:Name="ListButton"
                                                        AutomationProperties.Name="{CustomResource AccDescrIVListStyle}"
                                                        ToolTipService.ToolTip="{CustomResource AccDescrIVListStyle}"
                                                        Click="List_Click"
                                                        AllowFocusOnInteraction="False"
                                                        Glyph="&#xEB09;"
                                                        CornerRadius="20" />
                            <TextBlock x:Name="ListPremium"
                                       Style="{StaticResource ToolbarPremiumStyle}" />
                        </Grid>
                        <Grid Margin="-8,0,0,0">
                            <controls:GlyphToggleButton x:Name="TableButton"
                                                        AutomationProperties.Name="{CustomResource AccDescrIVTable}"
                                                        ToolTipService.ToolTip="{CustomResource AccDescrIVTable}"
                                                        Click="Table_Click"
                                                        AllowFocusOnInteraction="False"
                                                        Glyph="&#xEB08;"
                                                        CornerRadius="20" />
                            <TextBlock x:Name="TablePremium"
                                       Style="{StaticResource ToolbarPremiumStyle}" />
                        </Grid>
                        <controls:GlyphButton x:Name="LinkButton"
                                              AutomationProperties.Name="{CustomResource CreateLink}"
                                              ToolTipService.ToolTip="{CustomResource CreateLink}"
                                              Click="Link_Click"
                                              AllowFocusOnInteraction="False"
                                              Glyph="&#xE71B;"
                                              CornerRadius="20"
                                              Margin="-8,0,0,0" />
                        <Grid Margin="-8,0,0,0">
                            <controls:GlyphButton x:Name="AttachButton"
                                                  AutomationProperties.Name="{CustomResource AccDescrAttachButton}"
                                                  ToolTipService.ToolTip="{CustomResource AccDescrAttachButton}"
                                                  Click="Attach_Click"
                                                  AllowFocusOnInteraction="False"
                                                  Glyph="&#xE9D8;"
                                                  CornerRadius="20" />
                            <TextBlock x:Name="AttachPremium"
                                       Style="{StaticResource ToolbarPremiumStyle}" />
                        </Grid>
                        <Grid Margin="-8,0,0,0">
                            <controls:GlyphButton x:Name="FormulaButton"
                                                  AutomationProperties.Name="{CustomResource AccDescrIVFormula}"
                                                  ToolTipService.ToolTip="{CustomResource AccDescrIVFormula}"
                                                  Click="Formula_Click"
                                                  AllowFocusOnInteraction="False"
                                                  Glyph="&#xEB07;"
                                                  CornerRadius="20" />
                            <TextBlock x:Name="FormulaPremium"
                                       Style="{StaticResource ToolbarPremiumStyle}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="2">
                <controls:GlyphButton x:Name="EmojiButton"
                                      AutomationProperties.Name="{CustomResource AccDescrEmojiButton}"
                                      ToolTipService.ToolTip="{CustomResource AccDescrEmojiButton}"
                                      Click="Emoji_Click"
                                      AllowFocusOnInteraction="False"
                                      Glyph="&#xE76E;"
                                      CornerRadius="20">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="EmojiFlyout"
                                Placement="Bottom"
                                ShowMode="Transient">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter"
                                       BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                                    <Setter Property="Padding"
                                            Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <drawers:EmojiDrawer x:Name="EmojiPanel"
                                                 ItemClick="Emoji_ItemClick"
                                                 Width="300"
                                                 Height="360" />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </controls:GlyphButton>
            </Grid>
        </Grid>

        <Grid HorizontalAlignment="Right"
              Margin="12"
              Grid.Row="3">
            <Rectangle x:Name="SendShadow"
                       Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                       Stroke="{ThemeResource SettingsItemBorderBrush}"
                       Width="48"
                       Height="48"
                       RadiusX="24"
                       RadiusY="24" />
            <Border CornerRadius="24"
                    Height="48"
                    Width="48">
                <controls:GlyphButton x:Name="SendButton"
                                      AutomationProperties.Name="{CustomResource Send}"
                                      ToolTipService.ToolTip="{CustomResource Send}"
                                      Click="Send_Click"
                                      Glyph="&#xEB06;"
                                      CornerRadius="20"
                                      FontSize="24" />
            </Border>
            <!--  Premium lock: shown for free users when the message contains rich content that
                  can't be sent as a plain FormattedText (PageBlockHelper.TryGetFormattedText).  -->
            <Border x:Name="SendLock"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                <FontIcon Glyph="&#xE72E;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</controls:WindowContent>
