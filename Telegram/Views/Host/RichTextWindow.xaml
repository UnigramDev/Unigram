                              Fill="#FFFFFF" />
                    </Border>
                </Grid>
            </HyperlinkButton>

            <TextBlock x:Name="StateLabel"
                       VerticalAlignment="Center"
                       TextLineBounds="TrimToCapHeight"
                       TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Assertive"
                       Foreground="{ThemeResource PageHeaderForegroundBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       IsHitTestVisible="False"
                       Margin="0,2,6,0"
                       Grid.Column="2" />
        </Grid>

        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Grid.Row="2"
                Grid.RowSpan="2" />
        <!-- Under the toolbars, which float over it: the padding is what keeps the first and
             last lines clear of them. -->
        <richEditor:RichEditorView x:Name="Editor"
                                   Padding="12,12,12,88"
                                   MaxContentWidth="720"
                                   AutomationProperties.Name="{CustomResource ArticleEditor}"
                                   Grid.Row="2"
                                   Grid.RowSpan="2" />

        <!--  Laid out as TDesktop's editor: history at the left, the tools in the middle and
              emoji at the right, all at the top; Send alone at the bottom.  -->
        <Grid x:Name="ToolbarRoot"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource TabViewBorderBrush}"
                    BorderThickness="0,1,0,1"
                    Grid.ColumnSpan="3" />

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:GlyphButton x:Name="UndoButton"
                                      AutomationProperties.Name="{CustomResource TextUndo}"
                                      ToolTipService.ToolTip="{CustomResource TextUndo}"
                                      Click="Undo_Click"
                                      IsEnabled="False"
                                      AllowFocusOnInteraction="False"
                                      Glyph="&#xE7A7;"
                                      CornerRadius="20" />
                <controls:GlyphButton x:Name="RedoButton"
                                      AutomationProperties.Name="{CustomResource Redo}"
                                      ToolTipService.ToolTip="{CustomResource Redo}"
                                      Click="Redo_Click"
                                      IsEnabled="False"
                                      AllowFocusOnInteraction="False"
                                      Glyph="&#xE7A6;"
                                      CornerRadius="20"
                                      Margin="-8,0,0,0"
                                      Grid.Column="1" />
            </Grid>

            <Border BorderBrush="{ThemeResource TabViewBorderBrush}"
                    BorderThickness="1,0,1,0"
                    Margin="0,8"
                    Grid.Column="1" />

            <!--  The commands in labelled groups as Word's ribbon has them, each expanded to its
                  buttons or folded into one that opens its menu, as the width allows: text
                  styles first. Scrolls when even every group folded does not fit, and is a
                  single tab stop with arrows moving within it.  -->
            <richEditor:RichToolbarHost Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Auto">
                    <StackPanel x:Name="GroupedBar"
                                Orientation="Horizontal"
                                Padding="0,4,0,4"
                                TabFocusNavigation="Once"
                                XYFocusKeyboardNavigation="Enabled">
                        <richEditor:RichToolbarGroup Priority="2"
                                                     Text="{CustomResource Formatting}"
                                                     Click="Paragraph_Click"
                                                     Glyph="&#xEB23;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <controls:GlyphToggleButton x:Name="GroupTextButton"
                                                                AutomationProperties.Name="{CustomResource ArticleText}"
                                                                ToolTipService.ToolTip="{CustomResource ArticleText}"
                                                                Click="GroupText_Click"
                                                                Glyph="&#xEB22;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <Grid>
                                        <controls:GlyphButton AutomationProperties.Name="{CustomResource ArticleHeading}"
                                                              ToolTipService.ToolTip="{CustomResource ArticleHeading}"
                                                              Click="GroupHeading_Click"
                                                              Glyph="&#xEB21;"
                                                              Style="{StaticResource GroupGlyphButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <controls:GlyphToggleButton x:Name="GroupQuoteButton"
                                                                AutomationProperties.Name="{CustomResource ArticleQuote}"
                                                                ToolTipService.ToolTip="{CustomResource ArticleQuote}"
                                                                Click="GroupQuote_Click"
                                                                Glyph="&#xEAC7;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupPullQuoteButton"
                                                                    AutomationProperties.Name="{CustomResource ArticlePullquote}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticlePullquote}"
                                                                    Click="GroupPullQuote_Click"
                                                                    Glyph="&#xF797;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Grid.Row="1">
                                    <controls:GlyphToggleButton x:Name="GroupCodeButton"
                                                                AutomationProperties.Name="{CustomResource ArticleCode}"
                                                                ToolTipService.ToolTip="{CustomResource ArticleCode}"
                                                                Click="GroupCode_Click"
                                                                Glyph="&#xE943;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupFooterButton"
                                                                    AutomationProperties.Name="{CustomResource ArticleFooter}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticleFooter}"
                                                                    Click="GroupFooter_Click"
                                                                    Glyph="&#xF798;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphButton AutomationProperties.Name="{CustomResource ArticleCommandDivider}"
                                                              ToolTipService.ToolTip="{CustomResource ArticleCommandDivider}"
                                                              Click="GroupDivider_Click"
                                                              Glyph="&#xF799;"
                                                              Style="{StaticResource GroupGlyphButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </richEditor:RichToolbarGroup>

                        <Rectangle Style="{StaticResource GroupSeparatorStyle}" />

                        <richEditor:RichToolbarGroup Priority="1"
                                                     Text="{CustomResource AccDescrIVTextStyle}"
                                                     Click="TextStyle_Click"
                                                     Glyph="&#xE8D2;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <controls:GlyphToggleButton x:Name="GroupBoldButton"
                                                                AutomationProperties.Name="{CustomResource Bold}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xE8DD;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <controls:GlyphToggleButton x:Name="GroupItalicButton"
                                                                AutomationProperties.Name="{CustomResource Italic}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xE8DB;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <controls:GlyphToggleButton x:Name="GroupUnderlineButton"
                                                                AutomationProperties.Name="{CustomResource Underline}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xE8DC;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <controls:GlyphToggleButton x:Name="GroupStrikethroughButton"
                                                                AutomationProperties.Name="{CustomResource Strike}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xE8DE;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <controls:GlyphToggleButton x:Name="GroupSpoilerButton"
                                                                AutomationProperties.Name="{CustomResource Spoiler}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xEAA1;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                    <controls:GlyphToggleButton x:Name="GroupMonospaceButton"
                                                                AutomationProperties.Name="{CustomResource Mono}"
                                                                Click="GroupMark_Click"
                                                                Glyph="&#xE943;"
                                                                Style="{StaticResource GroupToggleButtonStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Grid.Row="1">
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupSubscriptButton"
                                                                    AutomationProperties.Name="{CustomResource Subscript}"
                                                                    ToolTipService.ToolTip="{CustomResource Subscript}"
                                                                    Click="GroupMark_Click"
                                                                    Glyph="&#xEB1B;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupSuperscriptButton"
                                                                    AutomationProperties.Name="{CustomResource Superscript}"
                                                                    ToolTipService.ToolTip="{CustomResource Superscript}"
                                                                    Click="GroupMark_Click"
                                                                    Glyph="&#xEB1A;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupMarkedButton"
                                                                    AutomationProperties.Name="{CustomResource RichEditorMarked}"
                                                                    ToolTipService.ToolTip="{CustomResource RichEditorMarked}"
                                                                    Click="GroupMark_Click"
                                                                    Glyph="&#xF79A;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <controls:GlyphButton x:Name="GroupRegularButton"
                                                          AutomationProperties.Name="{CustomResource Regular}"
                                                          Click="GroupRegular_Click"
                                                          Glyph="&#xF79D;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </richEditor:RichToolbarGroup>

                        <Rectangle Style="{StaticResource GroupSeparatorStyle}" />

                        <richEditor:RichToolbarGroup Priority="3"
                                                     Text="{CustomResource ArticleCommandList}"
                                                     Click="List_Click"
                                                     Glyph="&#xEB09;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupNumberedButton"
                                                                    AutomationProperties.Name="{CustomResource ArticleListNumbered}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticleListNumbered}"
                                                                    Click="GroupList_Click"
                                                                    Glyph="&#xEB17;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupBulletedButton"
                                                                    AutomationProperties.Name="{CustomResource ArticleListBulleted}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticleListBulleted}"
                                                                    Click="GroupList_Click"
                                                                    Glyph="&#xEB09;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupChecklistButton"
                                                                    AutomationProperties.Name="{CustomResource ArticleListTodo}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticleListTodo}"
                                                                    Click="GroupList_Click"
                                                                    Glyph="&#xEABE;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Grid.Row="1">
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupToggleBlockButton"
                                                                    AutomationProperties.Name="{CustomResource ArticleToggleBlock}"
                                                                    ToolTipService.ToolTip="{CustomResource ArticleToggleBlock}"
                                                                    Click="GroupToggleBlock_Click"
                                                                    Glyph="&#xE0E5;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <controls:GlyphButton x:Name="GroupIndentButton"
                                                          AutomationProperties.Name="{CustomResource ArticleIndent}"
                                                          ToolTipService.ToolTip="{CustomResource ArticleIndent}"
                                                          Click="GroupIndent_Click"
                                                          Glyph="&#xF79B;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                    <controls:GlyphButton x:Name="GroupOutdentButton"
                                                          AutomationProperties.Name="{CustomResource ArticleOutdent}"
                                                          ToolTipService.ToolTip="{CustomResource ArticleOutdent}"
                                                          Click="GroupOutdent_Click"
                                                          Glyph="&#xF79C;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </richEditor:RichToolbarGroup>

                        <Rectangle Style="{StaticResource GroupSeparatorStyle}" />

                        <richEditor:RichToolbarGroup Priority="4"
                                                     Text="{CustomResource RichEditorInsert}"
                                                     Click="Insert_Click"
                                                     Glyph="&#xE9D8;">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Grid>
                                        <controls:GlyphToggleButton x:Name="GroupTableButton"
                                                                    AutomationProperties.Name="{CustomResource AccDescrIVTable}"
                                                                    ToolTipService.ToolTip="{CustomResource AccDescrIVTable}"
                                                                    Click="Table_Click"
                                                                    Glyph="&#xEB08;"
                                                                    Style="{StaticResource GroupToggleButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphButton AutomationProperties.Name="{CustomResource AccDescrAttachButton}"
                                                              ToolTipService.ToolTip="{CustomResource AccDescrAttachButton}"
                                                              Click="Attach_Click"
                                                              Glyph="&#xE9D8;"
                                                              Style="{StaticResource GroupGlyphButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                    <Grid>
                                        <controls:GlyphButton AutomationProperties.Name="{CustomResource AccDescrIVFormula}"
                                                              ToolTipService.ToolTip="{CustomResource AccDescrIVFormula}"
                                                              Click="Formula_Click"
                                                              Glyph="&#xEB07;"
                                                              Style="{StaticResource GroupGlyphButtonStyle}" />
                                        <TextBlock Visibility="{x:Bind PremiumMarksVisibility, Mode=OneWay}"
                                                   Style="{StaticResource GroupPremiumStyle}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Grid.Row="1">
                                    <controls:GlyphButton x:Name="GroupLinkButton"
                                                          AutomationProperties.Name="{CustomResource CreateLink}"
                                                          ToolTipService.ToolTip="{CustomResource CreateLink}"
                                                          Click="Link_Click"
                                                          Glyph="&#xE71B;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                    <controls:GlyphButton AutomationProperties.Name="{CustomResource RichEditorButton}"
                                                          ToolTipService.ToolTip="{CustomResource RichEditorButton}"
                                                          Click="GroupInlineButton_Click"
                                                          Glyph="&#xF79E;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                    <controls:GlyphButton AutomationProperties.Name="{CustomResource AccDescrIVInsertDate}"
                                                          ToolTipService.ToolTip="{CustomResource AccDescrIVInsertDate}"
                                                          Click="GroupDate_Click"
                                                          Glyph="&#xE787;"
                                                          Style="{StaticResource GroupGlyphButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </richEditor:RichToolbarGroup>
                    </StackPanel>
                </ScrollViewer>
            </richEditor:RichToolbarHost>

            <Grid VerticalAlignment="Center"
                  Grid.Column="2">
                <richEditor:RichToolbarGroup x:Name="EmojiButton"
                                             Text="{CustomResource Emoji}"
                                             Click="Emoji_Click"
                                             Glyph="&#xE76E;">
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout x:Name="EmojiFlyout">
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style TargetType="MenuFlyoutPresenter">
                                    <Setter Property="Padding"
                                            Value="0" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>
                            <controls:MenuFlyoutContent Padding="0">
                                <drawers:EmojiDrawer x:Name="EmojiPanel"
                                                     ItemClick="Emoji_ItemClick"
                                                     Width="300"
                                                     Height="360" />
                            </controls:MenuFlyoutContent>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </richEditor:RichToolbarGroup>
            </Grid>
        </Grid>

        <Grid HorizontalAlignment="Right"
              Margin="12"
              Grid.Row="3">
            <Rectangle x:Name="SendShadow"
                       Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                       Stroke="{ThemeResource SettingsItemBorderBrush}"
                       Width="48"
                       Height="48"
                       RadiusX="24"
                       RadiusY="24" />
            <Border CornerRadius="24"
                    Height="48"
                    Width="48">
                <controls:GlyphButton x:Name="SendButton"
                                      AutomationProperties.Name="{CustomResource Send}"
                                      ToolTipService.ToolTip="{CustomResource Send}"
                                      Click="Send_Click"
                                      ContextRequested="Send_ContextRequested"
                                      Glyph="&#xEB06;"
                                      CornerRadius="20"
                                      FontSize="24" />
            </Border>
            <!--  Premium lock: shown for free users when the message contains rich content that
                  can't be sent as a plain FormattedText (PageBlockHelper.TryGetFormattedText).  -->
            <Border x:Name="SendLock"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
                <FontIcon Glyph="&#xE72E;"
                          FontFamily="Segoe MDL2 Assets"
                          FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</controls:WindowContent>
