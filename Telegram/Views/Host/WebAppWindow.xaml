<controls:WindowContent x:Class="Telegram.Views.Host.WebAppWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Telegram.Views.Popups"
                        xmlns:controls="using:Telegram.Controls"
                        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        mc:Ignorable="d"
                        ActualThemeChanged="OnActualThemeChanged"
                        SizeChanged="OnSizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="TitlePanel"
              Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:GlyphButton x:Name="BackButton"
                                  Click="BackButton_Click"
                                  RenderTransformOrigin="0.5,0.5"
                                  Width="48"
                                  Height="40"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Glyph="&#xE72B;"
                                  Visibility="Collapsed" />

            <controls:ProfilePicture x:Name="Photo"
                                     Size="24" />

            <Border x:Name="TitleBar"
                    Background="Transparent"
                    Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           TextLineBounds="TrimToCapHeight"
                           TextWrapping="NoWrap"
                           AutomationProperties.LiveSetting="Assertive"
                           Foreground="{ThemeResource PageHeaderForegroundBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           IsHitTestVisible="False"
                           Margin="0,2,6,0" />
            </Border>

            <controls:MoreButton x:Name="MoreButton"
                                 Click="More_ContextRequested"
                                 Width="46"
                                 Height="40"
                                 Grid.Column="2">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPointerOver">#19FFFFFF</SolidColorBrush>
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPressed">#33FFFFFF</SolidColorBrush>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPointerOver">#19000000</SolidColorBrush>
                                <SolidColorBrush x:Key="TitleBarButtonBackgroundPressed">#33000000</SolidColorBrush>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <Button.Template>
                    <ControlTemplate TargetType="controls:MoreButton">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TitleBarButtonBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Icon.(muxc:AnimatedIcon.State)"
                                                    Value="PointerOver" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource TitleBarButtonBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                        <VisualState.Setters>
                                            <Setter Target="Icon.(muxc:AnimatedIcon.State)"
                                                    Value="Pressed" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RootGrid" />

                            <muxc:AnimatedIcon x:Name="Icon"
                                               muxc:AnimatedIcon.State="Normal"
                                               Source="{TemplateBinding IconSource}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Width="20"
                                               Height="20" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </controls:MoreButton>

            <!-- The window draws its own close button now; this is the room it needs. -->
            <Border Width="46"
                    Grid.Column="3" />
        </Grid>

        <Border x:Name="BackgroundPanel"
                Grid.RowSpan="2"
                Grid.Row="1" />

        <Border x:Name="PlaceholderPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="120"
                Height="120"
                Grid.RowSpan="3" />

        <controls:WebViewer x:Name="View"
                            Navigating="View_Navigating"
                            Navigated="View_Navigated"
                            EventReceived="View_EventReceived"
                            NewWindowRequested="View_NewWindowRequested"
                            ScriptDialogOpening="View_ScriptDialogOpening"
                            SizeChanged="View_SizeChanged"
                            Grid.RowSpan="2"
                            Grid.Row="1" />

        <Grid x:Name="BottomBarPanel"
              VerticalAlignment="Bottom"
              Height="96"
              Grid.Row="1">
            <Grid x:Name="SecondaryButtonPanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Height="48">
                <Button x:Name="SecondaryButton"
                        Click="SecondaryButton_Click"
                        Background="Transparent"
                        CornerRadius="0"
                        BorderThickness="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        FontWeight="SemiBold" />
                <muxc:ProgressRing x:Name="SecondaryProgress"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="MainButtonPanel"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Height="48">
                <Button x:Name="MainButton"
                        Click="MainButton_Click"
                        Background="Transparent"
                        CornerRadius="0"
                        BorderThickness="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        FontWeight="SemiBold" />
                <muxc:ProgressRing x:Name="MainProgress"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</controls:WindowContent>
