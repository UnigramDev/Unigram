<controls:ContentPopup x:Class="Telegram.Views.Grams.Popups.TonReceiptPopup"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:controls="using:Telegram.Controls"
                      mc:Ignorable="d"
                      Padding="24,0,24,24"
                      IsDismissButtonVisible="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,24,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:ProfilePicture x:Name="Photo"
                                         Size="96"
                                         Margin="0,0,0,8" />
                <controls:AnimatedImage x:Name="AnimatedPhoto"
                                        Width="120"
                                        Height="120"
                                        FrameSize="120,120"
                                        DecodeFrameType="Logical"
                                        IsViewportAware="True"
                                        LoopCount="1"
                                        Margin="0,-16,0,8" />

                <TextBlock x:Name="Title"
                           Style="{StaticResource PopupTextBlockStyle}"
                           TextAlignment="Center"
                           VerticalAlignment="Top"
                           Grid.Row="1" />

                <StackPanel HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="0,-2,0,0"
                            Grid.Row="2">
                    <TextBlock x:Name="Value"
                               Style="{StaticResource BaseTextBlockStyle}"
                               VerticalAlignment="Center">
                        <Run x:Name="Symbol" /><Run x:Name="Amount" /><Run x:Name="Decimal"
                                                                           FontSize="12" />
                        <Run Text="&#xEA7E;"
                             FontFamily="{StaticResource SymbolThemeFontFamily}"
                             FontWeight="Normal" />
                    </TextBlock>

                    <controls:BadgeControl x:Name="Refund"
                                           Text="{CustomResource StarsRefunded}"
                                           Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           CornerRadius="4"
                                           VerticalAlignment="Bottom"
                                           Margin="8,0,0,3" />
                </StackPanel>

                <TextBlock x:Name="Subtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextAlignment="Center"
                           Margin="12,0,12,8"
                           Grid.Row="3" />
            </Grid>

            <controls:TableView x:Name="TableRoot"
                                Margin="-8,12,-8,0">
                <controls:TableViewItem x:Name="Reason"
                                        Visibility="Collapsed" />
                <controls:TableViewItem x:Name="From"
                                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:ProfilePicture x:Name="FromPhoto"
                                                 Margin="8,4,0,4"
                                                 Size="24" />
                        <TextBlock Margin="8,5,4,6"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Top"
                                   Grid.Column="1">
                                <Hyperlink UnderlineStyle="None">
                                    <Run x:Name="FromTitle" />
                                </Hyperlink>
                        </TextBlock>
                    </Grid>
                </controls:TableViewItem>
                <controls:TableViewItem x:Name="GiftName"
                                        Header="{CustomResource Gift2Gift}"
                                        Visibility="Collapsed" />
                <controls:TableViewItem x:Name="FullPrice"
                                        Header="{CustomResource StarsTransactionFullPrice}"
                                        Visibility="Collapsed" />
                <controls:TableViewItem x:Name="Transaction"
                                        Header="{CustomResource StarsTransactionID}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Identifier"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   FontFamily="Consolas"
                                   TextWrapping="NoWrap"
                                   Margin="8,5,4,6"
                                   VerticalAlignment="Bottom" />

                        <TextBlock Text="&#xEAC9;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="20"
                                   Foreground="{ThemeResource AccentButtonBackground}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="4"
                                   IsHitTestVisible="False"
                                   Grid.Column="1" />

                        <Button Click="CopyLink_Click"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Opacity="0"
                                Grid.ColumnSpan="2" />
                    </Grid>
                </controls:TableViewItem>
                <controls:TableViewItem x:Name="Date"
                                        Header="{CustomResource StarsTransactionDate}" />
                <controls:TableViewItem x:Name="TonDate"
                                        Header="{CustomResource StarsTransactionTONDate}"
                                        Visibility="Collapsed" />
            </controls:TableView>
        </StackPanel>

        <Button x:Name="PurchaseCommand"
                Click="Purchase_Click"
                Content="{CustomResource OK}"
                Style="{StaticResource AccentButtonStyle}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0"
                Grid.Row="1" />
    </Grid>
</controls:ContentPopup>
