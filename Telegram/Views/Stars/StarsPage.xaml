<local:HostedPage x:Class="Telegram.Views.Stars.StarsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:revenue="using:Telegram.Controls.Cells.Revenue"
                  xmlns:local="using:Telegram.Views"
                  mc:Ignorable="d"
                  NavigationMode="Root">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SlideNavigationTransitionInfo Effect="FromRight" />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <controls:TableListView x:Name="ScrollingHost"
                                ItemsSource="{x:Bind ViewModel.Items}"
                                ItemClick="OnItemClick"
                                IsItemClickEnabled="True"
                                ContainerContentChanging="OnContainerContentChanging"
                                SelectionMode="None"
                                Padding="12,0,12,16">
            <ListView.Header>
                <controls:TableListView ItemsSource="{x:Bind ViewModel.Subscriptions}"
                                        ItemClick="OnItemClick"
                                        IsItemClickEnabled="True"
                                        ContainerContentChanging="OnContainerContentChanging"
                                        SelectionMode="None">
                    <ListView.Header>
                        <controls:SettingsPanel IsHeader="True">
                            <controls:SettingsHeadline x:Name="Headline"
                                                       Text="{CustomResource TelegramStarsInfo}"
                                                       Source="ms-appx:///Assets/Animations/YourStars.tgs"
                                                       LoopCount="1" />

                            <controls:HeaderedControl>
                                <StackPanel Background="{ThemeResource SettingsItemBackground}"
                                            BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12,4,12,8">
                                    <TextBlock TextAlignment="Center"
                                               FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                               FontWeight="SemiBold"
                                               FontSize="28">
                                        <Run Text="&#xF78E;"
                                             FontFamily="{StaticResource SymbolThemeFontFamily}"
                                             FontWeight="Normal" />
                                        <Run x:Name="Balance" /><Run x:Name="BalanceFraction"
                                                                     FontSize="24" />
                                    </TextBlock>

                                    <TextBlock Text="{CustomResource StarsYourBalance}"
                                               Style="{StaticResource InfoBodyTextBlockStyle}"
                                               TextAlignment="Center"
                                               Margin="0,-2,0,8" />

                                    <Button Click="Buy_Click"
                                            Content="{CustomResource StarsBuyMore}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" />

                                    <Button Click="Gift_Click"
                                            Content="{CustomResource TelegramStarsGift}"
                                            Style="{StaticResource AccentTextButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="32"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </controls:HeaderedControl>

                            <controls:HeaderedControl>
                                <controls:SettingsButton Click="Affiliate_Click"
                                                         Content="{CustomResource UserAffiliateProgramRowTitle}"
                                                         Description="{CustomResource UserAffiliateProgramRowText}"
                                                         Glyph="&#xE9B5;"
                                                         IsChevronVisible="True" />
                            </controls:HeaderedControl>

                            <TextBlock Text="{CustomResource StarMySubscriptions}"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       Visibility="{x:Bind ViewModel.Subscriptions.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       MaxWidth="1000"
                                       Margin="24,16,24,6"
                                       Grid.Row="5" />
                        </controls:SettingsPanel>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <revenue:StarSubscriptionCell />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Template>
                        <ControlTemplate TargetType="ListView">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <ItemsPresenter Header="{TemplateBinding Header}"
                                                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                                HeaderTransitions="{TemplateBinding HeaderTransitions}"
                                                Footer="{TemplateBinding Footer}"
                                                FooterTemplate="{TemplateBinding FooterTemplate}"
                                                FooterTransitions="{TemplateBinding FooterTransitions}"
                                                Padding="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </ListView.Template>
                    <ListView.Footer>
                        <StackPanel>
                            <Border Visibility="{x:Bind ViewModel.Subscriptions.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="12,12,12,0" />

                            <Grid Visibility="{x:Bind ViewModel.HasTransactions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MaxWidth="1000"
                                  Margin="24,16,24,2">
                                <Border Background="{ThemeResource SettingsItemBackground}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" />

                                <controls:TopNavView x:Name="Navigation"
                                                     SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=OneWay}"
                                                     SelectionChanged="Navigation_SelectionChanged"
                                                     Height="48"
                                                     Padding="8,0,8,4">
                                    <controls:TopNavView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </controls:TopNavView.ItemsPanel>
                                    <controls:TopNavViewItem Content="{CustomResource StarsTransactionsAll}" />
                                    <controls:TopNavViewItem Content="{CustomResource StarsTransactionsIncoming}" />
                                    <controls:TopNavViewItem Content="{CustomResource StarsTransactionsOutgoing}" />
                                </controls:TopNavView>
                            </Grid>
                        </StackPanel>
                    </ListView.Footer>
                </controls:TableListView>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <revenue:StarTransactionCell />
                </DataTemplate>
            </ListView.ItemTemplate>
        </controls:TableListView>
    </Grid>
</local:HostedPage>
