<controls:ModalPopup x:Class="Telegram.Views.Stars.Popups.ReceivedGiftPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:messages="using:Telegram.Controls.Messages"
                     mc:Ignorable="d"
                     Padding="0,0,0,0"
                     IsDismissButtonVisible="True"
                     PrimaryButtonClick="OnPrimaryButtonClick"
                     ButtonsLayout="Vertical">

    <Grid x:Name="ScrollingHost">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Header"
                          Margin="0,24,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:AnimatedImage x:Name="AnimatedPhoto"
                                                Width="120"
                                                Height="120"
                                                FrameSize="120,120"
                                                DecodeFrameType="Logical"
                                                IsViewportAware="True"
                                                LoopCount="1"
                                                Margin="0,-16,0,8" />

                        <TextBlock x:Name="Title"
                                   Text="{CustomResource GiftTelegramPremiumTitle}"
                                   Style="{StaticResource PopupTextBlockStyle}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="12,0"
                                   Grid.Row="1" />
                        <TextBlock x:Name="Subtitle"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextAlignment="Center"
                                   Margin="24,0,24,8"
                                   Grid.Row="3" />
                    </Grid>
                    <controls:PatternBackground x:Name="UpgradedHeader"
                                                CornerRadius="7,7,0,0"
                                                Padding="0">
                        <controls:PatternBackground.Footer>
                            <Grid>
                                <Grid x:Name="UpgradedFooter">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="UpgradedTitle"
                                               Text="{CustomResource GiftTelegramPremiumTitle}"
                                               Style="{StaticResource PopupTextBlockStyle}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="12,0" />

                                    <messages:MessageService x:Name="UpgradedPublisher"
                                                             Click="UpgradedPublisher_Click"
                                                             Background="#22000000"
                                                             CornerRadius="12"
                                                             HorizontalAlignment="Center"
                                                             Padding="8,2,8,3"
                                                             Margin="0,0,0,8"
                                                             Visibility="Collapsed"
                                                             Grid.Row="1">
                                        <TextBlock x:Name="UpgradedPublisherLabel"
                                                   Foreground="#DDFFFFFF"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextWrapping="NoWrap" />
                                    </messages:MessageService>

                                    <TextBlock x:Name="UpgradedSubtitle"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="#AAFFFFFF"
                                               TextAlignment="Center"
                                               Margin="24,0,24,8"
                                               Grid.Row="1" />

                                    <Grid x:Name="ResaleStarCountRoot"
                                          Tapped="ResaleStarCountRoot_Tapped"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Height="20"
                                          CornerRadius="10"
                                          Margin="24,0,24,8"
                                          Padding="8,0"
                                          Visibility="Collapsed"
                                          Grid.Row="1">
                                        <TextBlock x:Name="ResaleStarCount"
                                                   Foreground="#FFFFFF"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,1" />
                                    </Grid>

                                    <Grid x:Name="UpgradedMessage"
                                          ColumnSpacing="4"
                                          HorizontalAlignment="Center"
                                          Margin="24,0,24,8"
                                          Visibility="Collapsed"
                                          Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProfilePicture x:Name="UpgradedMessagePhoto"
                                                                 VerticalAlignment="Bottom"
                                                                 Size="24" />
                                        <Border Background="#28FFFFFF"
                                                CornerRadius="12,12,12,4"
                                                Padding="8,4,8,4"
                                                Grid.Column="1">
                                            <controls:FormattedTextBlock x:Name="UpgradedMessageText"
                                                                         Foreground="White"
                                                                         HyperlinkForeground="White"
                                                                         FontSize="12" />
                                        </Border>
                                    </Grid>

                                    <Grid x:Name="UpgradedButtons"
                                          ColumnSpacing="8"
                                          Margin="8,0,8,8"
                                          Visibility="Collapsed"
                                          Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:SettingsButton x:Name="TransferButton"
                                                                 Click="TransferButton_Click"
                                                                 Content="{CustomResource Gift2ActionTransfer}"
                                                                 Style="{StaticResource GlyphGridBadgeButtonStyle}"
                                                                 Glyph="&#xEAC6;" />

                                        <controls:SettingsButton x:Name="WearButton"
                                                                 Click="WearButton_Click"
                                                                 Content="{CustomResource Gift2ActionWear}"
                                                                 Style="{StaticResource GlyphGridBadgeButtonStyle}"
                                                                 Glyph="&#xEAB3;"
                                                                 Grid.Column="1" />

                                        <controls:SettingsButton x:Name="ResellButton"
                                                                 Click="ResellButton_Click"
                                                                 Content="{CustomResource Gift2ActionResell}"
                                                                 Style="{StaticResource GlyphGridBadgeButtonStyle}"
                                                                 Glyph="&#xEA68;"
                                                                 Grid.Column="2" />
                                    </Grid>
                                </Grid>

                                <Grid x:Name="WearFooter"
                                      Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid HorizontalAlignment="Center"
                                          Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="WearName"
                                                   Style="{StaticResource PopupTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" />
                                        <controls:AnimatedImage x:Name="WearIcon"
                                                                Width="24"
                                                                Height="24"
                                                                FrameSize="24,24"
                                                                DecodeFrameType="Logical"
                                                                IsViewportAware="True"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Grid.Column="1" />
                                    </Grid>
                                    <TextBlock x:Name="WearStatus"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               Foreground="#AAFFFFFF"
                                               TextAlignment="Center"
                                               Margin="24,0,24,8"
                                               Grid.Row="1" />
                                </Grid>
                            </Grid>
                        </controls:PatternBackground.Footer>
                        <Grid>
                            <controls:AnimatedImage x:Name="UpgradedAnimatedPhoto"
                                                    Width="120"
                                                    Height="120"
                                                    FrameSize="120,120"
                                                    DecodeFrameType="Logical"
                                                    IsViewportAware="True"
                                                    LoopCount="1"
                                                    Margin="0,12,0,8" />
                            <Grid x:Name="RollModels"
                                  Visibility="Collapsed">
                                <controls:AnimatedImage x:Name="RollModel0"
                                                        Width="120"
                                                        Height="120"
                                                        FrameSize="120,120"
                                                        DecodeFrameType="Logical"
                                                        IsViewportAware="True"
                                                        LoopCount="1"
                                                        Opacity="0"
                                                        Margin="0,12,0,8">
                                    <controls:AnimatedImage.RenderTransform>
                                        <CompositeTransform x:Name="RollModel0Transform"
                                                            CenterX="60"
                                                            CenterY="60" />
                                    </controls:AnimatedImage.RenderTransform>
                                    <controls:AnimatedImage.Projection>
                                        <PlaneProjection x:Name="RollModel0Projection" />
                                    </controls:AnimatedImage.Projection>
                                </controls:AnimatedImage>
                                <controls:AnimatedImage x:Name="RollModel1"
                                                        Width="120"
                                                        Height="120"
                                                        FrameSize="120,120"
                                                        DecodeFrameType="Logical"
                                                        IsViewportAware="True"
                                                        LoopCount="1"
                                                        Opacity="0"
                                                        Margin="0,12,0,8">
                                    <controls:AnimatedImage.RenderTransform>
                                        <CompositeTransform x:Name="RollModel1Transform"
                                                            CenterX="60"
                                                            CenterY="60" />
                                    </controls:AnimatedImage.RenderTransform>
                                    <controls:AnimatedImage.Projection>
                                        <PlaneProjection x:Name="RollModel1Projection" />
                                    </controls:AnimatedImage.Projection>
                                </controls:AnimatedImage>
                                <controls:AnimatedImage x:Name="RollModel2"
                                                        Width="120"
                                                        Height="120"
                                                        FrameSize="120,120"
                                                        DecodeFrameType="Logical"
                                                        IsViewportAware="True"
                                                        LoopCount="1"
                                                        Opacity="0"
                                                        Margin="0,12,0,8">
                                    <controls:AnimatedImage.RenderTransform>
                                        <CompositeTransform x:Name="RollModel2Transform"
                                                            CenterX="60"
                                                            CenterY="60" />
                                    </controls:AnimatedImage.RenderTransform>
                                    <controls:AnimatedImage.Projection>
                                        <PlaneProjection x:Name="RollModel2Projection" />
                                    </controls:AnimatedImage.Projection>
                                </controls:AnimatedImage>
                            </Grid>
                            <controls:ProfilePicture x:Name="WearPhoto"
                                                     Size="96"
                                                     Margin="0,24,0,20"
                                                     Visibility="Collapsed" />
                        </Grid>
                    </controls:PatternBackground>

                    <controls:Ribbon x:Name="Ribbon"
                                     Background="{StaticResource MessageServiceBackgroundBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Visibility="Collapsed" />

                    <Grid x:Name="DetailRoot"
                          Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="RegularRoot">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="RefundedNote"
                                       Text="{CustomResource Gift2Refunded}"
                                       Foreground="{ThemeResource DangerButtonForeground}"
                                       Style="{StaticResource InfoBodyTextBlockStyle}"
                                       TextAlignment="Center"
                                       Margin="24,8,24,0"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="SenderHiddenNote"
                                       Style="{StaticResource InfoBodyTextBlockStyle}"
                                       TextAlignment="Center"
                                       Margin="24,8,24,0"
                                       Visibility="Collapsed" />
                            <controls:TableView x:Name="TableRoot"
                                                Margin="8,8,8,0"
                                                Grid.Row="1">
                                <controls:TableViewItem x:Name="FirstSale"
                                                        Header="{CustomResource Gift2SoldOutSheetFirstSale}"
                                                        Visibility="Collapsed" />
                                <controls:TableViewItem x:Name="LastSale"
                                                        Header="{CustomResource Gift2SoldOutSheetLastSale}"
                                                        Visibility="Collapsed" />
                                <controls:TableViewItem x:Name="From"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProfilePicture x:Name="FromPhoto"
                                                                 Margin="8,4,0,4"
                                                                 Size="24" />
                                        <TextBlock Margin="8,5,4,6"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Top"
                                                   Grid.Column="1">
                                    <Hyperlink Click="From_Click"
                                               UnderlineStyle="None">
                                        <Run x:Name="FromTitle" />
                                    </Hyperlink>
                                        </TextBlock>

                                        <controls:SettingsButton x:Name="FromSendGift"
                                                                 Click="FromSendGift_Click"
                                                                 Glyph="{CustomResource Gift2ButtonSendGift}"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="8,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Visibility="Collapsed"
                                                                 Grid.Column="2" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="To"
                                                        Header="{CustomResource Gift2To}"
                                                        Padding="0"
                                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProfilePicture x:Name="ToPhoto"
                                                                 Margin="8,4,0,4"
                                                                 Size="24" />
                                        <TextBlock Margin="8,5,4,6"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Top"
                                                   Grid.Column="1">
                                    <Hyperlink Click="To_Click"
                                               UnderlineStyle="None">
                                        <Run x:Name="ToTitle" />
                                    </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="Date"
                                                        Header="{CustomResource StarsTransactionDate}" />
                                <controls:TableViewItem x:Name="StarCountRoot"
                                                        Header="{CustomResource Gift2Value}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="StarCount"
                                                   Margin="8,5,8,6"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                                   VerticalAlignment="Top" />

                                        <controls:SettingsButton x:Name="Convert"
                                                                 Click="Convert_Click"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="8,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Grid.Column="1" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="Availability"
                                                        Header="{CustomResource Gift2Availability}"
                                                        Visibility="Collapsed" />
                            </controls:TableView>
                            <Border x:Name="CaptionRoot"
                                    Background="{ThemeResource ButtonBackground}"
                                    BorderBrush="{ThemeResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,4,4"
                                    Margin="8,0,8,0"
                                    Visibility="Collapsed"
                                    Grid.Row="2">
                                <controls:FormattedTextBlock x:Name="Caption"
                                                             Margin="8,5,4,6" />
                            </Border>
                        </Grid>

                        <Grid x:Name="UpgradedRoot">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:SettingsFooter x:Name="UpgradedBlockchain"
                                                     Text="{CustomResource Gift2InBlockchain}"
                                                     IsLink="True"
                                                     Click="Blockchain_Click"
                                                     TextStyle="{StaticResource InfoBodyTextBlockStyle}"
                                                     TextAlignment="Center"
                                                     Margin="0,8,0,0"
                                                     Visibility="Collapsed"
                                                     Grid.Row="3" />
                            <controls:TableView x:Name="UpgradedTableRoot"
                                                Margin="8,8,8,0"
                                                Grid.Row="1">
                                <controls:TableViewItem x:Name="UpgradedOwnerAddress"
                                                        Header="{CustomResource Gift2HostAddress}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Visibility="Collapsed"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpgradedOwnerAddressStart"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="8,5,0,6"
                                                   VerticalAlignment="Top" />
                                        <TextBlock x:Name="UpgradedOwnerAddressEnd"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,5,8,6"
                                                   VerticalAlignment="Top"
                                                   Grid.Column="1" />

                                        <Button Click="OwnerAddress_Click"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Opacity="0"
                                                Grid.ColumnSpan="3" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="UpgradedOwner"
                                                        Header="{CustomResource Gift2Owner}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <controls:ProfilePicture x:Name="UpgradedFromPhoto"
                                                                 Margin="8,4,0,4"
                                                                 Size="24" />
                                        <TextBlock x:Name="UpgradedFromText"
                                                   Margin="8,5,4,6"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Top"
                                                   Grid.Column="1">
                                    <Hyperlink Click="Owner_Click"
                                               UnderlineStyle="None">
                                        <Run x:Name="UpgradedFromTitle" />
                                    </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem Header="{CustomResource Gift2AttributeModel}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="UpgradedModelRoll">
                                            <TextBlock x:Name="UpgradedModel"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:Name="UpgradedModelRoll1"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="UpgradedModelRoll2"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                        </Grid>

                                        <controls:SettingsButton x:Name="UpgradedModelRarity"
                                                                 Click="UpgradedModelRarity_Click"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="4,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Grid.Column="1" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem Header="{CustomResource Gift2AttributeBackdrop}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="UpgradedBackdropRoll">
                                            <TextBlock x:Name="UpgradedBackdrop"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:Name="UpgradedBackdropRoll1"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="UpgradedBackdropRoll2"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                        </Grid>

                                        <controls:SettingsButton x:Name="UpgradedBackdropRarity"
                                                                 Click="UpgradedBackdropRarity_Click"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="4,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Grid.Column="1" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem Header="{CustomResource Gift2AttributeSymbol}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="UpgradedSymbolRoll">
                                            <TextBlock x:Name="UpgradedSymbol"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock x:Name="UpgradedSymbolRoll1"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                            <TextBlock x:Name="UpgradedSymbolRoll2"
                                                       Margin="8,5,8,6"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed" />
                                        </Grid>

                                        <controls:SettingsButton x:Name="UpgradedSymbolRarity"
                                                                 Click="UpgradedSymbolRarity_Click"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="4,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Grid.Column="1" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="UpgradedValueRoot"
                                                        Header="{CustomResource GiftValue2}"
                                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpgradedValue"
                                                   Margin="8,5,8,6"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   VerticalAlignment="Top" />

                                        <controls:SettingsButton x:Name="UpgradedValueRarity"
                                                                 Click="UpgradedValueRarity_Click"
                                                                 Glyph="{CustomResource GiftValue2LearnMore}"
                                                                 Style="{StaticResource SmallButtonStyle}"
                                                                 VerticalAlignment="Center"
                                                                 FontSize="11"
                                                                 Padding="4,0"
                                                                 CornerRadius="8"
                                                                 BorderThickness="0"
                                                                 Height="16"
                                                                 Grid.Column="1" />
                                    </Grid>
                                </controls:TableViewItem>
                                <controls:TableViewItem x:Name="UpgradedQuantity"
                                                        Header="{CustomResource Gift2Quantity}" />
                            </controls:TableView>
                            <Grid x:Name="UpgradedCaptionRoot"
                                  Background="{ThemeResource ButtonBackground}"
                                  BorderBrush="{ThemeResource ButtonBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="0,0,4,4"
                                  Margin="8,0,8,0"
                                  Visibility="Collapsed"
                                  Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:FormattedTextBlock x:Name="UpgradedCaption"
                                                             VerticalAlignment="Center"
                                                             Margin="8,5,8,6" />
                                <controls:GlyphButton x:Name="UpgradedCaptionRemove"
                                                      Click="UpgradedCaptionRemove_Click"
                                                      Glyph="&#xE74D;"
                                                      Visibility="Collapsed"
                                                      Grid.Column="1" />
                            </Grid>
                        </Grid>

                        <Border Height="8"
                                Grid.Row="1" />

                        <controls:SettingsFooter x:Name="Info"
                                                 IsLink="True"
                                                 Click="Visibility_Click"
                                                 TextStyle="{StaticResource InfoBodyTextBlockStyle}"
                                                 TextAlignment="Center"
                                                 Margin="0,4,0,4"
                                                 Grid.Row="2" />
                    </Grid>
                    <Grid x:Name="UpgradeRoot"
                          Visibility="Collapsed"
                          Grid.Row="1"
                          Grid.RowSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:SettingsButton x:Name="UpgradeText1"
                                                 Content="{CustomResource Gift2UpgradeFeature1Title}"
                                                 Badge="{CustomResource GiftsFeature1Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xE76E;"
                                                 Margin="12,0,12,0"
                                                 IsHitTestVisible="False" />
                        <controls:SettingsButton x:Name="UpgradeText2"
                                                 Content="{CustomResource Gift2UpgradeFeature3Title}"
                                                 Badge="{CustomResource GiftsFeature2Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xE76E;"
                                                 Margin="12,-8,12,0"
                                                 IsHitTestVisible="False"
                                                 Grid.Row="1" />
                        <controls:SettingsButton x:Name="UpgradeText3"
                                                 Content="{CustomResource GiftsFeature3Title}"
                                                 Badge="{CustomResource GiftsFeature3Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xE76E;"
                                                 Margin="12,-8,12,0"
                                                 IsHitTestVisible="False"
                                                 Grid.Row="2" />

                        <CheckBox x:Name="KeepOriginalDetails"
                                  Content="{CustomResource Gift2AddSenderName}"
                                  Margin="24,0,0,0"
                                  Grid.Row="3" />

                        <TextBlock x:Name="UpgradeCostsInfo"
                                   Style="{StaticResource InfoBodyTextBlockStyle}"
                                   TextAlignment="Center"
                                   Margin="24,8,24,4"
                                   Visibility="Collapsed"
                                   Grid.Row="4">
                            <Hyperlink Click="UpgradeCosts_Click"
                                       UnderlineStyle="None">
                                <Run Text="{CustomResource Gift2UpgradeCostsInfo}" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Grid x:Name="WearRoot"
                          Visibility="Collapsed"
                          Grid.Row="1"
                          Grid.RowSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WearTitle"
                                   Style="{StaticResource PopupTextBlockStyle}"
                                   TextAlignment="Center"
                                   Margin="24,16,24,0" />
                        <TextBlock Text="{CustomResource Gift2WearSubtitle}"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextAlignment="Center"
                                   Margin="24,0,24,8"
                                   Grid.Row="1" />
                        <controls:SettingsButton Content="{CustomResource Gift2WearFeature1Title}"
                                                 Badge="{CustomResource Gift2WearFeature1Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xEABD;"
                                                 Margin="12,0,12,0"
                                                 IsHitTestVisible="False"
                                                 Grid.Row="2" />
                        <controls:SettingsButton Content="{CustomResource Gift2WearFeature2Title}"
                                                 Badge="{CustomResource Gift2WearFeature2Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xE2B1;"
                                                 Margin="12,-8,12,0"
                                                 IsHitTestVisible="False"
                                                 Grid.Row="3" />
                        <controls:SettingsButton Content="{CustomResource Gift2WearFeature3Title}"
                                                 Badge="{CustomResource Gift2WearFeature3Text}"
                                                 Style="{StaticResource GlyphSubbadgeBadgeButtonPopupStyle}"
                                                 Glyph="&#xEA8B;"
                                                 Margin="12,-8,12,0"
                                                 IsHitTestVisible="False"
                                                 Grid.Row="4" />
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <controls:MoreButton x:Name="MoreButton"
                             Click="More_ContextRequested"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,0,40,0"
                             CornerRadius="20"
                             RequestedTheme="Dark"
                             Visibility="Collapsed" />
    </Grid>
</controls:ModalPopup>
