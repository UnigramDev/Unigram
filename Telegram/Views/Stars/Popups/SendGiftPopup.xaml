<controls:ModalPopup x:Class="Telegram.Views.Stars.Popups.SendGiftPopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="using:Telegram.Views.Business.Popups"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:chats="using:Telegram.Controls.Chats"
                     xmlns:messages="using:Telegram.Controls.Messages"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:drawers="using:Telegram.Controls.Drawers"
                     xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
                     xmlns:service="using:Telegram.Controls.Messages.Service"
                     mc:Ignorable="d"
                     IsDismissButtonVisible="True"
                     Padding="0,24,0,0"
                     PrimaryButtonClick="OnPrimaryButtonClick"
                     ButtonsLayout="Vertical">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="LimitedRoot"
                      SizeChanged="LimitedRoot_SizeChanged"
                      Margin="24,0,24,12"
                      CornerRadius="4"
                      Visibility="Collapsed"
                      Grid.Row="1">
                    <Grid x:Name="PrevLimitRoot"
                          Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                          Padding="8,4">
                        <TextBlock x:Name="PrevLimit"
                                   Style="{StaticResource InfoBodyTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                        <TextBlock x:Name="NextLimitBelow"
                                   Style="{StaticResource InfoBodyTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Left" />
                    </Grid>
                    <Grid x:Name="NextPanel"
                          Background="{StaticResource PremiumLinearGradientBrush}"
                          Padding="8,4">
                        <TextBlock x:Name="PrevLimitAbove"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right" />
                        <TextBlock x:Name="NextLimit"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   TextAlignment="Left" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                </Grid>

                <Button x:Name="ResaleButton"
                        Click="Resale_Click"
                        HorizontalAlignment="Stretch"
                        Margin="24,0,24,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="Resale" />
                </Button>

                <Grid>
                    <chats:ChatBackgroundControl x:Name="BackgroundControl" />

                    <Grid Padding="24,4,24,12">
                        <service:MessageGiftContent x:Name="Message" />
                    </Grid>
                </Grid>

                <Grid x:Name="CaptionPanel"
                      Background="{ThemeResource ContentDialogBackground}">
                    <controls:CaptionTextBox x:Name="CaptionInput"
                                             TextChanged="OnTextChanged"
                                             InputScope="Chat"
                                             FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                             PlaceholderText="{CustomResource Gift2Message}"
                                             Style="{StaticResource DefaultChatTextBoxStyle}"
                                             Background="Transparent"
                                             Padding="24,0,0,0"
                                             BorderThickness="0"
                                             Grid.Row="1">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="EmojiFlyout"
                                    Placement="Top"
                                    ShowMode="Transient">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter"
                                           BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                                        <Setter Property="Padding"
                                                Value="0" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <drawers:EmojiDrawer x:Name="EmojiPanel"
                                                     ItemClick="Emoji_ItemClick"
                                                     Width="300"
                                                     Height="360" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </controls:CaptionTextBox>

                    <Border x:Name="CaptionBorder"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Grid.ColumnSpan="3" />

                    <messages:CustomEmojiCanvas x:Name="CustomEmoji"
                                                IsHitTestVisible="False"
                                                Margin="22,11,0,0" />

                    <controls:GlyphButton Click="Emoji_Click"
                                          Glyph="&#xE76E;"
                                          AutomationProperties.Name="{CustomResource Emoji}"
                                          AllowFocusOnInteraction="False"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          FontSize="24"
                                          Grid.Column="1" />
                </Grid>

                <TextBlock x:Name="CaptionInfo"
                           Style="{StaticResource InfoCaptionTextBlockStyle}"
                           Margin="24,8,24,24" />

                <StackPanel x:Name="UpgradeableRoot">
                    <CheckBox x:Name="Upgradeable"
                              Checked="OnTextChanged"
                              Unchecked="OnTextChanged"
                              Margin="24,8,24,0">
                        <RichTextBlock IsTextSelectionEnabled="False">
                            <Paragraph>
                                <Run x:Name="UpgradeableTextPart1" />
                                <InlineUIContainer>
                                    <controls:PremiumStarCount Width="24"
                                                               Height="24"
                                                               Margin="-4,-4,-2,-6" />
                                </InlineUIContainer>
                                <Run x:Name="UpgradeableTextPart2" />
                            </Paragraph>
                        </RichTextBlock>
                    </CheckBox>
                    <controls:SettingsFooter x:Name="UpgradeableInfo"
                                             Click="UpgradeableInfo_Click"
                                             IsLink="True"
                                             Margin="24,0,24,8" />
                </StackPanel>

                <StackPanel x:Name="HideMyNameRoot">
                    <CheckBox x:Name="HideMyName"
                              Content="{CustomResource Gift2Hide}"
                              Margin="24,8,24,0" />
                    <controls:SettingsFooter x:Name="HideMyNameInfo"
                                             Margin="24,0,24,24" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:ScrollViewerScrim ScrollingHost="{x:Bind ScrollingHost}"
                                    Background="{ThemeResource ContentDialogTopOverlaySolid}"
                                    BottomInset="0" />
    </Grid>
</controls:ModalPopup>
