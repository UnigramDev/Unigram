<controls:ModalPopup x:Class="Telegram.Views.Stars.Popups.GiftMessagePopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="using:Telegram.Controls"
                     xmlns:chats="using:Telegram.Controls.Chats"
                     xmlns:messages="using:Telegram.Controls.Messages"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:drawers="using:Telegram.Controls.Drawers"
                     xmlns:service="using:Telegram.Controls.Messages.Service"
                     mc:Ignorable="d"
                     IsDismissButtonVisible="True"
                     Padding="0,24,0,0"
                     ButtonsLayout="Vertical">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="Description"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Margin="24,0,24,12" />

                <Grid>
                    <chats:ChatBackgroundControl x:Name="BackgroundControl" />

                    <StackPanel Padding="24,8,24,12">
                        <Border Background="{ThemeResource MessageServiceBackgroundBrush}"
                                CornerRadius="12"
                                HorizontalAlignment="Center"
                                Padding="10,2,10,4">
                            <TextBlock Text="{CustomResource GiftMessagePreviewInChat}"
                                       Foreground="#FFFFFF"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <service:MessageUpgradedGiftContent x:Name="Message"
                                                            IsHitTestVisible="False" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CaptionPanel"
                      Background="{ThemeResource ContentDialogBackground}">
                    <controls:FormattedTextInputHost x:Name="CaptionInput"
                                                     Kind="Caption"
                                                     Tier="Popups"
                                                     ContentChanged="OnContentChanged"
                                                     InputScope="Chat"
                                                     FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                     LegacyStyle="{StaticResource DefaultChatTextBoxStyle}"
                                                     NativeStyle="{StaticResource DefaultChatMessageTextBoxStyle}"
                                                     Background="Transparent"
                                                     Padding="24,0,0,0"
                                                     BorderThickness="0"
                                                     Grid.Row="1">
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout x:Name="EmojiFlyout">
                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                    <Style TargetType="MenuFlyoutPresenter">
                                        <Setter Property="Padding"
                                                Value="0" />
                                    </Style>
                                </MenuFlyout.MenuFlyoutPresenterStyle>
                                <controls:MenuFlyoutContent Padding="0">
                                    <drawers:EmojiDrawer x:Name="EmojiPanel"
                                                         ItemClick="Emoji_ItemClick"
                                                         Width="300"
                                                         Height="360" />
                                </controls:MenuFlyoutContent>
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </controls:FormattedTextInputHost>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Grid.ColumnSpan="3" />

                    <messages:CustomEmojiCanvas x:Name="CustomEmoji"
                                                IsHitTestVisible="False"
                                                Margin="22,11,0,0" />

                    <controls:GlyphButton x:Name="EmojiButton"
                                          Click="Emoji_Click"
                                          Glyph="&#xE76E;"
                                          AutomationProperties.Name="{CustomResource Emoji}"
                                          AllowFocusOnInteraction="False"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          FontSize="24"
                                          Grid.Column="1" />
                </Grid>

                <CheckBox x:Name="MakePublic"
                          Content="{CustomResource GiftMessageMakeMessagePublic}"
                          IsChecked="True"
                          Margin="24,8,24,24" />
            </StackPanel>
        </ScrollViewer>

        <controls:ScrollViewerScrim ScrollingHost="{x:Bind ScrollingHost}"
                                    Background="{ThemeResource ContentDialogTopOverlaySolid}"
                                    BottomInset="0" />
    </Grid>
</controls:ModalPopup>
