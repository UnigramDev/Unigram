<local:HostedPage x:Class="Telegram.Views.Settings.SettingsStoragePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:common="using:Telegram.Common"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:cells="using:Telegram.Controls.Cells"
                  xmlns:media="using:Telegram.Controls.Media"
                  xmlns:local="using:Telegram.Views"
                  mc:Ignorable="d">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SlideNavigationTransitionInfo Effect="FromRight" />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <controls:TableListView x:Name="ScrollingHost"
                                ItemsSource="{x:Bind ViewModel.Statistics.ByChat, Mode=OneWay}"
                                ItemClick="ListView_ItemClick"
                                IsItemClickEnabled="True"
                                SelectionMode="None"
                                ContainerContentChanging="OnContainerContentChanging">
            <ListView.Header>
                <controls:SettingsPanel IsHeader="True">
                    <Grid MaxWidth="1000"
                          Margin="24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <controls:StorageChart x:Name="Chart"
                                               Items="{x:Bind ViewModel.ItemsView, Mode=OneWay}"
                                               SeparatorBrush="{ThemeResource LayerFillColorDefaultBrush}"
                                               Margin="0,16,0,16" />

                        <TextBlock x:Name="Subtitle"
                                   common:TextBlockHelper.Markdown="{CustomResource StorageUsageCalculating}"
                                   Style="{StaticResource InfoBodyTextBlockStyle}"
                                   TextAlignment="Center"
                                   Margin="12,0,12,0"
                                   MaxWidth="480"
                                   Grid.Row="1" />
                    </Grid>

                    <StackPanel Visibility="{x:Bind ViewModel.ItemsView, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <controls:HeaderedControl ItemsSource="{x:Bind ViewModel.ItemsView, Mode=OneWay}">
                            <controls:HeaderedControl.ItemTemplate>
                                <DataTemplate x:DataType="controls:StorageChartItem">
                                    <controls:FauxCheckBox Click="StorageChartItem_Checked"
                                                           Style="{StaticResource SettingsCheckBoxStyle}"
                                                           IsChecked="{x:Bind IsVisible}"
                                                           IsFaux="True">
                                        <CheckBox.Resources>
                                            <media:CheckBoxResources Color="{x:Bind Stroke}" />
                                        </CheckBox.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{x:Bind Name}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource FileSizeConverter}, ConverterParameter=allowGb}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlDisabledChromeDisabledLowBrush}"
                                                       VerticalAlignment="Bottom"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="4,0,0,0"
                                                       MaxLines="1" />
                                        </StackPanel>
                                    </controls:FauxCheckBox>
                                </DataTemplate>
                            </controls:HeaderedControl.ItemTemplate>
                        </controls:HeaderedControl>
                        <controls:HeaderedControl Footer="{CustomResource StorageUsageInfo}"
                                                  Padding="0,3,0,0">
                            <Grid Background="{ThemeResource SettingsItemBackground}"
                                  BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                  Padding="12,8">

                                <Button Click="{x:Bind ViewModel.ClearCache}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch">
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{CustomResource ClearMediaCache}" />
                                        <TextBlock x:Name="ClearSize"
                                                   Text="{x:Bind ViewModel.Statistics.Size, Mode=OneWay, Converter={StaticResource FileSizeConverter}, ConverterParameter=allowGb}"
                                                   Opacity="0.6"
                                                   Margin="4,0,0,0"
                                                   Grid.Column="1" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </controls:HeaderedControl>
                    </StackPanel>

                    <controls:HeaderedControl x:Name="KeepMediaPanel"
                                              Header="{CustomResource KeepMedia}"
                                              Footer="{CustomResource KeepMediaInfoPart}">
                        <Grid x:Name="KeepMediaTicks"
                              Background="{ThemeResource SettingsItemBackground}"
                              BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                              Padding="12,6,12,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Slider x:Name="KeepMedia"
                                    Value="{x:Bind ConvertKeepMedia(ViewModel.KeepMedia), Mode=TwoWay, BindBack=ConvertKeepMediaBack}"
                                    Maximum="3"
                                    Minimum="0"
                                    SmallChange="1"
                                    LargeChange="1"
                                    StepFrequency="1"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    IsThumbToolTipEnabled="False"
                                    Grid.Row="1" />
                        </Grid>
                    </controls:HeaderedControl>

                    <TextBlock Text="{CustomResource FilterChats}"
                               Style="{StaticResource BaseTextBlockStyle}"
                               Margin="24,16,24,6" />
                </controls:SettingsPanel>
            </ListView.Header>
            <ListView.Footer>
                <Border Height="32" />
            </ListView.Footer>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <cells:ProfileCell />
                </DataTemplate>
            </ListView.ItemTemplate>
        </controls:TableListView>
    </Grid>
</local:HostedPage>