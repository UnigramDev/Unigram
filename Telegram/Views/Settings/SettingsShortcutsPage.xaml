<local:HostedPage x:Class="Telegram.Views.Settings.SettingsShortcutsPage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:Telegram.Views"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:services="using:Telegram.Services"
                  xmlns:settings="using:Telegram.Views.Settings"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="ItemsSource"
                              Source="{x:Bind ViewModel.Items}"
                              IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <controls:TableListView x:Name="ScrollingHost"
                                ItemsSource="{x:Bind ItemsSource.View}"
                                IsItemClickEnabled="True"
                                SelectionMode="None"
                                ItemClick="OnItemClick"
                                ChoosingItemContainer="OnChoosingItemContainer"
                                PreviewKeyDown="OnPreviewKeyDown"
                                LosingFocus="OnLosingFocus">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="Margin"
                                    Value="0" />
                            <Setter Property="Padding"
                                    Value="0" />
                            <Setter Property="MinHeight"
                                    Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewHeaderItem">
                                        <ContentPresenter MaxWidth="1000" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,6" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:ShortcutInfo">
                    <Grid AutomationProperties.Name="{x:Bind settings:SettingsShortcutsPage.ConvertName(Command, Shortcut), Mode=OneWay}"
                          MinHeight="40"
                          Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center"
                                    Margin="16,0,12,0">
                            <TextBlock Text="{x:Bind services:ShortcutsService.GetLabel(Command)}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{x:Bind settings:SettingsShortcutsPage.ConvertConflict(Conflict), Mode=OneWay}"
                                       Visibility="{x:Bind settings:SettingsShortcutsPage.ConvertConflictVisibility(Conflict), Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       Style="{StaticResource InfoCaptionTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{x:Bind settings:SettingsShortcutsPage.ConvertRecording(IsRecording), Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0"
                                    Grid.Column="1">
                            <TextBlock Text="&#xF78F;"
                                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                       AutomationProperties.AccessibilityView="Raw"
                                       VerticalAlignment="Center"
                                       FontSize="16" />

                            <TextBlock Text="{CustomResource ShortcutsEditHint}"
                                       Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{CustomResource ShortcutsUnbound}"
                                   Visibility="{x:Bind settings:SettingsShortcutsPage.ConvertUnbound(IsUnbound, IsRecording), Mode=OneWay}"
                                   Style="{StaticResource DisabledBodyTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Grid.Column="1" />

                        <ItemsControl ItemsSource="{x:Bind Shortcut.Components, Mode=OneWay}"
                                      Visibility="{x:Bind settings:SettingsShortcutsPage.ConvertNotRecording(IsRecording), Mode=OneWay}"
                                      IsTabStop="False"
                                      AutomationProperties.AccessibilityView="Raw"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"
                                      Grid.Column="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1,1,1,4"
                                            CornerRadius="4"
                                            Margin="4,0,0,0"
                                            MinWidth="28"
                                            Height="28">
                                        <TextBlock Text="{x:Bind}"
                                                   TextLineBounds="Tight"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Header>
                <controls:SettingsPanel IsHeader="True">
                    <Grid HorizontalAlignment="Left"
                          Margin="24,16,24,0"
                          Width="280">
                        <TextBox x:Name="SearchField"
                                 TextChanged="SearchField_TextChanged"
                                 PlaceholderText="{CustomResource ShortcutsSearchHint}"
                                 AutomationProperties.Name="{CustomResource ShortcutsSearchHint}"
                                 PreventKeyboardDisplayOnProgrammaticFocus="True"
                                 Padding="34,5,6,6"
                                 InputScope="Search" />

                        <controls:GlyphButton Glyph="&#xE721;"
                                              FontSize="16"
                                              Width="36"
                                              Height="32"
                                              IsTabStop="False"
                                              AutomationProperties.AccessibilityView="Raw"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                    </Grid>
                </controls:SettingsPanel>
            </ListView.Header>

            <ListView.Footer>
                <controls:SettingsPanel IsFooter="True">
                    <TextBlock Text="{CustomResource ShortcutsSearchEmpty}"
                               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Foreground="{ThemeResource SystemControlDisabledChromeDisabledLowBrush}"
                               TextAlignment="Center"
                               Margin="0,24" />

                    <controls:HeaderedControl>
                        <controls:SettingsButton Content="{CustomResource ShortcutsImport}"
                                                 Glyph="&#xF794;"
                                                 Click="Import_Click" />
                        <controls:SettingsButton Content="{CustomResource ShortcutsExport}"
                                                 Glyph="&#xF793;"
                                                 Click="Export_Click" />
                        <controls:SettingsButton Content="{CustomResource ShortcutsRestoreAll}"
                                                 Foreground="{ThemeResource DangerButtonForeground}"
                                                 Glyph="&#xEA09;"
                                                 Click="ResetAll_Click" />
                    </controls:HeaderedControl>
                </controls:SettingsPanel>
            </ListView.Footer>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel AreStickyGroupHeadersEnabled="False"
                                     Margin="24,0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </controls:TableListView>
    </Grid>
</local:HostedPage>
