<controls:ContentPopup x:Class="Telegram.Views.Settings.SettingsStorageOptimizationPage"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:controls="using:Telegram.Controls"
                       mc:Ignorable="d"
                       PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
                       SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
                       Padding="0">

    <Grid>
        <controls:TableListView x:Name="ScrollingHost"
                                ChoosingItemContainer="OnChoosingItemContainer"
                                SelectionMode="None"
                                Padding="0,12,0,16">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"
                       BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="IsTabStop"
                            Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Grid Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:StorageChart x:Name="Chart"
                                           SeparatorBrush="{ThemeResource ContentDialogBackground}" />

                    <TextBlock x:Name="TitleLabel"
                               Style="{StaticResource PopupTextBlockStyle}"
                               TextAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,0,0,0"
                               Grid.Row="1" />
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="controls:StorageChartItem">
                    <controls:FauxCheckBox Click="StorageChartItem_Checked"
                                           Style="{StaticResource DefaultCheckBoxStyle}"
                                           IsChecked="{x:Bind IsVisible}"
                                           IsFaux="True"
                                           Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Bind Name}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind TotalBytes, Converter={StaticResource FileSizeConverter}, ConverterParameter=allowGb}"
                                       Style="{StaticResource InfoCaptionTextBlockStyle}"
                                       VerticalAlignment="Bottom"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="4,0,0,0"
                                       MaxLines="1" />
                        </StackPanel>
                    </controls:FauxCheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </controls:TableListView>

        <controls:ScrollViewerScrim Background="{ThemeResource PageBackgroundDarkBrush}"
                                    ScrollingHost="{x:Bind ScrollingHost}" />
    </Grid>
</controls:ContentPopup>
