<local:HostedPage x:Class="Telegram.Views.Settings.SettingsAutoDeletePage"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="using:Telegram.Views"
                  xmlns:common="using:Telegram.Common"
                  xmlns:controls="using:Telegram.Controls"
                  xmlns:settings="using:Telegram.ViewModels.Settings"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  mc:Ignorable="d"
                  ShowHeader="False">

    <Page.Transitions>
        <TransitionCollection>
            <NavigationThemeTransition>
                <SlideNavigationTransitionInfo Effect="FromRight" />
            </NavigationThemeTransition>
        </TransitionCollection>
    </Page.Transitions>

    <Grid Background="{ThemeResource SettingsPageBackground}">
        <ScrollViewer x:Name="ScrollingHost"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <controls:SettingsPanel HasTopPadding="False">
                <controls:AnimatedImage Source="ms-appx:///Assets/Animations/AutoDelete.tgs"
                                        AutoPlay="True"
                                        IsCachingEnabled="False"
                                        DecodeFrameType="Logical"
                                        FrameSize="140,140"
                                        Width="140"
                                        Height="140"
                                        LoopCount="1"
                                        Margin="0,16,0,0" />
                <controls:StickyHeader x:Name="Header"
                                       Text="{CustomResource AutoDeleteMessages}"
                                       HorizontalContentAlignment="Center"
                                       Margin="0,-36,0,0" />
                <TextBlock common:TextBlockHelper.Markdown="{CustomResource GlobalAutoDeleteInfo}"
                           Style="{StaticResource InfoBodyTextBlockStyle}"
                           TextAlignment="Center"
                           Margin="12,-16,12,0"
                           MaxWidth="480" />

                <controls:HeaderedControl Header="{CustomResource MessageLifetime}">
                    <controls:HeaderedControl ItemsSource="{x:Bind ViewModel.Items}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:HeaderedControlPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="settings:SettingsAutoDeleteItem">
                                <controls:SettingsRadioButton Content="{x:Bind Text}"
                                                              IsFaux="True"
                                                              IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                                                              Click="OnChecked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </controls:HeaderedControl>
                    <controls:SettingsButton Click="{x:Bind ViewModel.SetCustomTime}"
                                             Content="{CustomResource SetCustomTime}"
                                             Glyph="&#xE916;" />
                </controls:HeaderedControl>
            </controls:SettingsPanel>
        </ScrollViewer>

        <controls:StickyHeaderChrome Header="{x:Bind Header}" />
    </Grid>
</local:HostedPage>
