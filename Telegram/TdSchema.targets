<!--
  The MSBuild half of TdSchemaMode, shared by Telegram.Modern.csproj and Telegram.Win32.csproj.
  Both are CsWinRT flavours and both compile the Telegram.Td.Api surface from
  Telegram.Generators.Cli rather than from the Roslyn generator, so a fix to one of them has to be
  a fix to both - which is why this is a file and not a block copied twice. Telegram.csproj stays
  on the Roslyn path: .NET Native has its own projection and none of this applies to it.

  The importing project sets TdParsers and references Telegram.Generators as an analyzer; this
  file adds everything the MSBuild path needs on top of that.
-->
<Project>

  <!-- Roslyn | MSBuild - see TdSchemaMode. CsWinRT's generator never sees what SchemaGenerator
       emitted, so it files the vtable for a schema type under an unqualified key
       ("Telegram.Vector`1[Message]") that type.ToString() never produces, and the CCW is looked up
       and missed at runtime. MSBuild writes the same text to obj/ before CoreCompile so it is
       compiled as ordinary source and CsWinRT can resolve it.

       Put this back to Roslyn once CsWinRT resolves them on its own - nothing else has to change,
       and Telegram.Generators.Cli can then be deleted. -->
  <PropertyGroup>
    <TdSchemaMode Condition="'$(TdSchemaMode)' == ''">MSBuild</TdSchemaMode>
    <TdSchemaSource>$(MSBuildThisFileDirectory)..\Libraries\tdjson\td_api.tl</TdSchemaSource>
    <TdSchemaCliDir>$(MSBuildThisFileDirectory)..\Telegram.Generators.Cli\bin\$(Configuration)\net10.0</TdSchemaCliDir>
    <TdSchemaCli>$(TdSchemaCliDir)\Telegram.Generators.Cli.dll</TdSchemaCli>
    <TdSchemaEmitter>$(TdSchemaCliDir)\Telegram.Generators.dll</TdSchemaEmitter>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="TdSchemaMode" />
    <!-- Ordering only, hence ReferenceOutputAssembly=false: the app runs the built dll by path.
         Platform is removed because this is an AnyCPU tool and the app builds x64 and ARM64. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Telegram.Generators.Cli\Telegram.Generators.Cli.csproj"
                      Condition="'$(TdSchemaMode)' == 'MSBuild'"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="Platform;RuntimeIdentifier;PublishAot;SelfContained" />
  </ItemGroup>

  <!-- IntermediateOutputPath is still empty during evaluation, so the path cannot be a property
       group at file scope - the same trap ModernAppxManifest documents in Telegram.Modern.csproj.
       Getting it wrong is silent: the Exec writes to the right place, the Compile item points at
       the wrong one, and the build fails with every Telegram.Td.Api type unresolved. -->
  <Target Name="ResolveTdSchemaPath" Condition="'$(TdSchemaMode)' == 'MSBuild'">
    <PropertyGroup>
      <!-- No trailing separator: cmd reads the backslash before a closing quote as an escape, so
           a directory passed as "...\" swallows the quote and takes the next argument with it. -->
      <TdSchemaDir>$(IntermediateOutputPath)TdSchema</TdSchemaDir>
      <TdSchemaFile>$(TdSchemaDir)\TdDotNetApi.g.cs</TdSchemaFile>
      <TdSchemaStamp>$(TdSchemaDir)\schema.stamp</TdSchemaStamp>
    </PropertyGroup>
  </Target>

  <!-- Before MarkupCompilePass1, not BeforeCompile: UseUwp injects
       MarkupCompilePass1;XamlPreCompile;MarkupCompilePass2 into PrepareResourcesDependsOn, and
       PrepareResources runs a whole phase ahead of Compile. XamlPreCompile is a real csc pass over
       @(Compile) that resolves every x:Bind, so the schema has to be in @(Compile) by then - a
       BeforeCompile hook fails there first, with every Telegram.Td.Api type unresolved.

       The emitter dlls are inputs alongside the schema: the text this writes changes when
       ApiEmitter changes, and keying off td_api.tl alone left F5 compiling the previous one. -->
  <Target Name="GenerateTdSchema" BeforeTargets="MarkupCompilePass1;BeforeCompile" Condition="'$(TdSchemaMode)' == 'MSBuild'"
          DependsOnTargets="ResolveTdSchemaPath"
          Inputs="$(TdSchemaSource);$(TdSchemaCli);$(TdSchemaEmitter)" Outputs="$(TdSchemaStamp)">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TdSchemaCli)&quot; --schema &quot;$(TdSchemaSource)&quot; --out &quot;$(TdSchemaDir)&quot; --parsers $(TdParsers)" />
    <!-- The stamp is the output, not the .cs: the emitter leaves the file alone when the text is
         unchanged, so its timestamp never catches up to the inputs and the target would re-run on
         every build forever. -->
    <Touch Files="$(TdSchemaStamp)" AlwaysCreate="true" />
  </Target>

  <!-- Separate from the target above, and it has to be: an up-to-date Inputs/Outputs check skips
       the whole target, which would take the Compile item with it and fail the build with every
       Telegram.Td.Api type missing. The item also has to be added from inside a target - at
       project scope it evaluates before anything runs, when the file does not exist yet. -->
  <Target Name="IncludeTdSchema" BeforeTargets="MarkupCompilePass1;BeforeCompile" DependsOnTargets="GenerateTdSchema"
          Condition="'$(TdSchemaMode)' == 'MSBuild'">
    <Error Condition="!Exists('$(TdSchemaFile)')" Text="TdSchemaMode is MSBuild but $(TdSchemaFile) was not written." />
    <ItemGroup>
      <Compile Include="$(TdSchemaFile)" />
    </ItemGroup>
  </Target>

</Project>
