<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

Used by the packaging project, which publishes Telegram.Modern.csproj through the profile named
after the platform it is building. PublishDir has to stay under bin\modern: the default the
template ships with is bin\$(Configuration)\..., which is where Telegram.csproj puts its own
.NET Native output, and the two would write over each other.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\modern\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
