<?xml version="1.0" encoding="utf-8"?>
<!--
The WinUI 3 flavour's publish profile, separate from win-x64.pubxml because that one publishes
Telegram.Modern.csproj into bin\modern and the packaging tooling reads PublishDir from whichever
profile it is handed. Build.WinUI.ps1 passes this one by path.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\winui\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
</Project>
