<!--
  Sdk.props is imported by hand rather than through the Sdk attribute because three properties
  have to be set before it: the two output paths, so this project does not share obj\ and bin\
  with Telegram.csproj, and DefaultItemExcludes, because the default globs would otherwise
  compile Telegram.csproj's own generated output - its XamlTypeInfo.g.cs, every page's .g.cs, and
  the .NET Native ilc sources under bin\ - as if they were app source.

  This is the Win32 flavour: the same app sources, hosted in a plain desktop process through XAML
  Islands instead of the UWP app model. It differs from Telegram.Modern.csproj in four places -
  the output paths, Exe instead of WinExe with our own Program.Main, the file fork, and no MSIX
  packaging yet. notes/win32-xaml-islands.md is the plan this belongs to.
-->
<Project>

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\win32\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\win32\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The same app on UWP XAML over .NET 10, CsWinRT and NativeAOT, built beside Telegram.csproj
    rather than replacing it: UseDotNetNativeToolchain exists only in the legacy project system
    and UseUwp only in SDK-style, and neither format can produce the other's output.

    Build with Visual Studio's MSBuild, never the dotnet CLI - modern UWP XAML support is imported
    from VS's own ImportBefore/ImportAfter hooks, which the SDK's MSBuild does not have:

      "%ProgramFiles%\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\amd64\MSBuild.exe" ^
        Telegram.Modern.csproj -restore -p:Configuration=Debug -p:Platform=x64

    net10-port-todo.md at the repository root is the plan this belongs to.
  -->

  <PropertyGroup>
    <!-- Exe, and the console stays attached: this host has no splash screen and nothing else
         reports a failure to start. DisableWinExeOutputInference keeps the SDK from inferring
         WinExe back from the WinRT TFM. -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <!-- DISABLE_XAML_GENERATED_MAIN is set below, but the UWP XAML targets rewrite
         DefineConstants after this project body runs, so the generated Application.Start
         entry point survives it. Naming ours settles the ambiguity either way. -->
    <StartupObject>Telegram.Host.Program</StartupObject>
    <!-- Not UseUwp alone: UseUwpTools is what pulls in the UWP XAML compiler targets on a desktop
         output, per Microsoft.Windows.UI.Xaml.CSharp.ModernNET.ImportAfter.targets. -->
    <UseUwpTools>true</UseUwpTools>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>Telegram</RootNamespace>
    <AssemblyName>Telegram</AssemblyName>
    <DefaultLanguage>en</DefaultLanguage>
    <UseUwp>true</UseUwp>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Defaulted from the platform rather than left to the caller. A RID-less build of this
         project resolves no package assets at all - Telegram.Native, Win2D, everything
         vanishes and the compiler reports thousands of errors that look like a broken projection
         rather than a missing property.

         Telegram.Modern.csproj gets its RID from the packaging project that references it. This
         one has no packaging project, so without this Visual Studio cannot build it at all and
         every command line has to carry two extra properties. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>

    <!-- Set here rather than passed on the command line: as a global property it flows into the
         ProjectReference, and Telegram.Generators is netstandard2.0, which cannot AOT
         (NETSDK1207). Publish with SelfContained and no -p:PublishAot to get a CoreCLR layout. -->
    <!-- Release only: ILC is the whole cost of a Debug deploy, which publishes through the
         packaging project, and nothing about a debug session wants a native image. SelfContained
         in the publish profile is what makes the CoreCLR layout it falls back to work. -->
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
    <!-- PublishAot turns the trim analyzer on for every build, and it is 98% of the
         analyzer time in the compile - 765 CPU-seconds, ~16s of wall clock. Nothing is
         trimmed in a Debug build, and publish and Release still run it, so it gates
         releases rather than the inner loop. -->
    <EnableTrimAnalyzer Condition="'$(Configuration)' == 'Debug'">false</EnableTrimAnalyzer>
    <EnableAotAnalyzer Condition="'$(Configuration)' == 'Debug'">false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer Condition="'$(Configuration)' == 'Debug'">false</EnableSingleFileAnalyzer>
    <!-- 15s of a Debug build, measured with ReportAnalyzer: CA2252 alone is 7.5s and only says
         anything about preview APIs. Release still runs them, so they gate releases rather than
         the inner loop - the same trade as the three analyzers above. -->
    <EnableNETAnalyzers Condition="'$(Configuration)' == 'Debug'">false</EnableNETAnalyzers>
    <!-- Turns off the runtime's marshalling subsystem for this assembly: only blittable types may
         cross a P/Invoke, and everything else is marshalled by the LibraryImport generator in C#
         instead. The SDK turns this property into the assembly attribute.

         Safe here only because every DllImport now has a LibraryImport counterpart and both
         delegates handed to native code became function pointers. It is deliberately absent from
         Telegram.csproj: .NET Native keeps the #else branches and the runtime marshalling they
         rely on. -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <!-- The CsWinRT generators are the interesting output of this project: what they emit for
         [GeneratedBindableCustomProperty] is what classic {Binding} and ItemsPath resolve
         through once AOT has trimmed reflection away. -->
    <EmitCompilerGeneratedFiles Condition="'$(Configuration)' != 'Debug'">true</EmitCompilerGeneratedFiles>

    <!-- Debug is not AOT, so none of this is needed to run - and both cost on every keystroke, not
         just on build: the optimizer is a source generator and the warning level is what raises the
         ~1800 CsWinRT1034 diagnostics the IDE recomputes live. CsWinRTAotExportsEnabled turns
         itself off with PublishAot. -->
    <CsWinRTAotOptimizerEnabled Condition="'$(Configuration)' == 'Debug'">false</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel Condition="'$(Configuration)' == 'Debug'">0</CsWinRTAotWarningLevel>

    <!-- Properties\AssemblyInfo.cs stays with the legacy project (see the Compile Remove below);
         these carry its values over to the attributes the SDK generates in its place. -->
    <AssemblyTitle>Telegram</AssemblyTitle>
    <Product>Telegram</Product>
    <Copyright>Copyright ©  2015</Copyright>

    <!-- The .NET Native project's constants, minus the ones that were only ever about it.
         NET9_0_OR_GREATER arrives on its own and is what the source already switches on. -->
    <!-- DISABLE_XAML_GENERATED_MAIN suppresses the Main the XAML compiler emits, which calls
         Application.Start - the UWP entry point. Host\Program.cs runs instead and owns the
         message loop. -->
    <DefineConstants>$(DefineConstants);NETFX_CORE;WINDOWS_UWP;CODE_ANALYSIS;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <NoWarn>$(NoWarn);2008</NoWarn>
  </PropertyGroup>

  <!--
    Compile and Page are globbed, against Telegram.csproj's 1250 hand-listed Compile and 473 Page
    entries. The two lists agree today except for the six files below, which are on disk and not
    in the legacy project; a parity check between the glob and that list is still to be written.
  -->
  <ItemGroup>
    <Compile Remove="Common\HttpServer.cs" />
    <Compile Remove="Common\MediaHttpServer.cs" />
    <Compile Remove="Controls\SettingsCheckBox.cs" />
    <Compile Remove="Entities\SourceGenerationContext.cs" />
    <Compile Remove="Streams\DiceFileSource.cs" />
    <!-- The SDK generates these attributes itself, and two sets of them is CS0579. -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <!-- The fork. Every host-specific member lives in a *.Uwp.cs / *.Win32.cs partial beside its
         shared half, and only one of the two is ever compiled - which is what makes the contract
         a compile error rather than an interface. -->
    <Compile Remove="**\*.Uwp.cs" />
  </ItemGroup>


  <!--
    Content needs CopyToOutputDirectory here. The legacy UWP project system packaged Content
    implicitly; SDK-style does not, and without it the app starts, initialises TDLib, and then
    dies on `Cannot locate resource from 'ms-appx:///Assets/grammars.dat'` because nothing
    under Assets\ was ever laid down.

    Assets\** is auto-included by the MSIX tooling, so it is updated rather than included - and it
    sweeps in files that are source rather than payload, hence the removals below. What survives
    them is Telegram.csproj's list exactly, plus the ten high-contrast tile logos it never listed.
  -->
  <ItemGroup>
    <!-- The LottieGen inputs under Icons\ and the C# they generate (compiled, never shipped), the
         mockup art that only theme_preview_image.jpg is used from, the icon font's glyph map, and
         the shader sources beside the compiled i420.bin. -->
    <Content Remove="Assets\Icons\**" />
    <Content Remove="Assets\Mockup\**" />
    <Content Include="Assets\Mockup\theme_preview_image.jpg" />
    <Content Remove="Assets\Fonts\Telegram.json" />
    <Content Remove="Assets\i420.bat" />
    <Content Remove="Assets\i420.fxlib" />
    <Content Remove="Assets\i420.hlsl" />

    <Content Update="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\unigram-iv-editor\editor.html" Link="Assets\editor.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\libprisma\libprisma\grammars.dat" Link="Assets\grammars.dat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\MicroTeX\res\fonts\**\*.ttf" Link="res\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\i420.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit, where Telegram.Modern.csproj gets them implicitly. The MSIX props hook in
         through CustomBeforeMicrosoftCommonTargets and are what define WindowsPackageType,
         AppxPackageDir and the PRI targets; without them AppxPackage and EnableMsixTooling are
         inert properties and the build silently produces no manifest and no resources.pri.
         Versions are the ones Modern resolves to. -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250806.1" />
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
    <!-- Dropped against Telegram.csproj: Microsoft.NETCore.UniversalWindowsPlatform, System.Memory,
         System.ValueTuple, Microsoft.Bcl.HashCode, PolySharp, System.Text.Json,
         System.Threading.Channels (all in-box on net10.0, and NU1510 for the last two), and
         System.Reflection.Metadata, which nothing in the app references. -->
  </ItemGroup>

  <!--
    The two local WinRT components. A bare winmd Reference, which is what Telegram.csproj used
    for RLottie before lottie moved into Telegram.Native, is rejected here with NETSDK1130, so
    CsWinRT generates the projections instead.
    Everything in CsWinRTInputs is read for metadata; only the namespaces in CsWinRTIncludes are
    emitted - which is why Win2D's winmd is an input (both components have Win2D types in their
    signatures) while Win2D itself still comes from its own package projection.
  -->
  <PropertyGroup>
    <CsWinRTIncludes>Telegram.Native</CsWinRTIncludes>
    <!-- 3 is the loudest level: it adds the casting, ternary, switch and constructor-argument
         cases on top of the defaults. Every AOT bug in this port so far was a marshalling
         mistake that only showed up by running the feature, so noise here is worth paying for. -->
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2.3.1, not 2.2.0, for the Native AOT analyzers: collection expressions and the
         IReferenceArray cases are diagnosed at build time rather than at the call site.
         3.0.0-preview is a different branch and cannot build UWP XAML. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <CsWinRTInputs Include="..\$(Platform)\$(Configuration)\Telegram.Native\Telegram.Native.winmd" />
    <CsWinRTInputs Include="..\$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.winmd" />
    <CsWinRTInputs Include="$(NuGetPackageRoot)win2d.uwp\1.28.3\lib\uap10.0\Microsoft.Graphics.Canvas.winmd" />
  </ItemGroup>


  <!--
    Identity, and it is not optional: LifetimeService.Initialize touches ApplicationData.Current
    from App's constructor, so an unpackaged launch dies before XAML matters.

    Patched out of the one real manifest rather than kept as a copy, for the reason
    Telegram.Modern.csproj gives - 108 lines of capabilities, extensions and file associations
    would drift the first time one of them changed. A third identity, so this installs beside both
    of the others.
  -->
  <PropertyGroup>
    <AppxPackage>true</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Registered is the loose publish folder that Add-AppxPackage -Register points at; Bundle is
         the signed msixbundle. They cannot share an identity: Windows will not move an installed
         app between a registered layout and a bundle, which is the same reason Telegram.Msix.Modern
         has its own. So this is a fourth. -->
    <Win32Identity Condition="'$(Win32Identity)' == ''">Registered</Win32Identity>
    <Win32PackageIdentity Condition="'$(Win32Identity)' == 'Registered'">38833FF26BA1D.UnigramWin32</Win32PackageIdentity>
    <Win32PackageDisplayName Condition="'$(Win32Identity)' == 'Registered'">Unigram Win32</Win32PackageDisplayName>
    <Win32PackageIdentity Condition="'$(Win32Identity)' == 'Bundle'">38833FF26BA1D.UnigramWin32Bundle</Win32PackageIdentity>
    <Win32PackageDisplayName Condition="'$(Win32Identity)' == 'Bundle'">Unigram Win32 (Bundle)</Win32PackageDisplayName>
    <Win32AppxManifest>$(BaseIntermediateOutputPath)Package.Win32.appxmanifest</Win32AppxManifest>
    <!-- The one key in the repository, shared by every project that packages the app. -->
    <PackageCertificateKeyFile>..\Telegram_TemporaryKey.pfx</PackageCertificateKeyFile>
    <Win32ManifestNamespaces>&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;&lt;Namespace Prefix='uap5' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10/5' /&gt;&lt;Namespace Prefix='rescap' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities' /&gt;</Win32ManifestNamespaces>
  </PropertyGroup>

  <Target Name="PatchWin32AppxManifest"
          BeforeTargets="PrepareForBuild"
          Inputs="Package.appxmanifest;$(MSBuildThisFileFullPath)"
          Outputs="$(Win32AppxManifest)">
    <PropertyGroup>
      <_Win32ManifestFull>$([System.IO.Path]::GetFullPath('$(Win32AppxManifest)'))</_Win32ManifestFull>
      <_SourceManifestFull>$([System.IO.Path]::GetFullPath('Package.appxmanifest'))</_SourceManifestFull>
    </PropertyGroup>
    <Error Condition="'$(_Win32ManifestFull)' == '$(_SourceManifestFull)'"
           Text="Win32AppxManifest resolves to the source manifest; patching it would rewrite the shipping identity." />
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(Win32AppxManifest)" />

    <!-- Deletions first, through XSLT, because XmlPoke can only set values. Everything below is a
         rename it can do. -->
    <XslTransformation XmlInputPaths="$(Win32AppxManifest)"
                       XslInputPath="Package.Win32.xslt"
                       OutputPaths="$(Win32AppxManifest).tmp" />
    <Copy SourceFiles="$(Win32AppxManifest).tmp" DestinationFiles="$(Win32AppxManifest)" />
    <Delete Files="$(Win32AppxManifest).tmp" />

    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Identity/@Name" Value="$(Win32PackageIdentity)" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Properties/f:DisplayName" Value="$(Win32PackageDisplayName)" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/uap:VisualElements/@DisplayName" Value="$(Win32PackageDisplayName)" />

    <!-- The whole point of the patch. A packaged Win32 app is a full trust entry point rather than
         a UWP activatable class, and the two extensions that name the class have to follow it. -->
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/@EntryPoint" Value="Windows.FullTrustApplication" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/f:Extensions/uap5:Extension/@EntryPoint" Value="Windows.FullTrustApplication" />

    <!-- This flavour installs beside a Telegram the machine is actually used with, so it must not
         compete for anything the shell dispatches. XmlPoke cannot delete nodes, so the claims are
         renamed out of the way instead: a tg: link, a typed Telegram.exe or a .unigram-theme file
         still reach the shipping app. The share target survives as one extra entry in the sheet,
         which is harmless and cannot be renamed away. -->
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/f:Extensions/uap:Extension/uap:Protocol[@Name='tg']/@Name" Value="tg-win32" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/f:Extensions/uap:Extension/uap:Protocol[@Name='tonsite']/@Name" Value="tonsite-win32" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/f:Extensions/uap5:Extension/uap5:AppExecutionAlias/uap5:ExecutionAlias/@Alias" Value="TelegramWin32.exe" />
    <XmlPoke XmlInputPath="$(Win32AppxManifest)" Namespaces="$(Win32ManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/f:Extensions/uap:Extension/uap:FileTypeAssociation/uap:SupportedFileTypes/uap:FileType" Value=".unigram-theme-win32" />

  </Target>

  <ItemGroup>
    <AppxManifest Include="$(Win32AppxManifest)" />
  </ItemGroup>

  <Target Name="PatchWin32FinalManifest" AfterTargets="_GenerateAppxManifest"
          Condition="Exists('$(FinalAppxManifestName)')">
    <PropertyGroup>
      <_VCLibsName Condition="'$(Configuration)' == 'Debug'">Microsoft.VCLibs.140.00.Debug</_VCLibsName>
      <_VCLibsName Condition="'$(_VCLibsName)' == ''">Microsoft.VCLibs.140.00</_VCLibsName>
    </PropertyGroup>
    <XslTransformation XmlInputPaths="$(FinalAppxManifestName)"
                       XslInputPath="Package.Win32.Final.xslt"
                       OutputPaths="$(FinalAppxManifestName).tmp"
                       Parameters="&lt;Parameter Name='VCLibsName' Value='$(_VCLibsName)' /&gt;" />
    <Copy SourceFiles="$(FinalAppxManifestName).tmp" DestinationFiles="$(FinalAppxManifestName)" />
    <Delete Files="$(FinalAppxManifestName).tmp" />
  </Target>
  <!-- Kept in step with Telegram.csproj by hand: the generator reads TdParsers and emits parsers,
       the hand-written code reads the constants and calls them, so the two projects must agree or
       the generated file calls helpers that were compiled out.

       Changing this needs obj's generated editorconfig deleted: the value reaches the
       generator through it, and it is not rewritten when the property alone changes, so
       the next build emits one parser set against the other's constants. -->
  <PropertyGroup>
    <TdParsers>Pointer</TdParsers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TdParsers)' != 'Pointer'">
    <DefineConstants>$(DefineConstants);TD_READER_PARSER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TdParsers)' != 'Reader'">
    <DefineConstants>$(DefineConstants);TD_POINTER_PARSER</DefineConstants>
  </PropertyGroup>

  <!-- Opt-in (-p:Instrumented=true): compiles in the Profiler probes and Instrumentation.Register,
       which keeps a WeakReference per registered object for the session, so it must not reach a
       shipping build. Telegram.csproj has it on in Debug instead. -->
  <PropertyGroup Condition="'$(Instrumented)' == 'true'">
    <DefineConstants>$(DefineConstants);INSTRUMENTATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telegram.Generators\Telegram.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- DynamicCastRootGenerator runs a semantic query per cast in the app - 8.8s a build - and
         exists only so trimming cannot drop the metadata a cast needs. Debug is not trimmed, so
         what it emits there is inert. WinRTExposedTypeAnalyzer goes with it, and reports on a
         Release build instead. -->
    <ProjectReference Include="..\Telegram.Generators.WinRT\Telegram.Generators.WinRT.csproj"
                      Condition="'$(Configuration)' != 'Debug'"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="..\Libraries\tdjson\td_api.tl" />
    <CompilerVisibleProperty Include="TdParsers" />
  </ItemGroup>

  <!-- Same copy-local set as Telegram.csproj, including tdjson.pdb by name: it arrives as a copy
       local path rather than a Reference, so RAR never runs its related-file discovery and without
       this the symbols are missing from every TDLib crash. -->
  <PropertyGroup>
    <OpenSSLPlatform>-$(Platform)</OpenSSLPlatform>
  </PropertyGroup>

  <!-- The two C++/WinRT components are consumed as projections rather than ProjectReferences, so
       nothing copies their binaries the way a project reference would. They come from the same
       build output the winmds are read from, which is also why this project does not build them:
       Telegram.Native has to have been built by the solution first. Calls only adds its own two
       files; the rest of its folder is the same ffmpeg set.

       $(TelegramRoot) rather than a relative path: these paths reach the .appxrecipe
       verbatim, and Visual Studio resolves the recipe against its own working directory,
       so a relative one fails deployment with DEP1000 even though the build copied it. -->
  <ItemGroup>
    <!-- Only the components themselves. Their folders also hold the whole ffmpeg/libvlc set, but
         those come from vcpkg through Directory.Build.targets, as they do for Telegram.csproj -
         copying both is NETSDK1152, sixteen files deep. Same for Win2D, which comes from its
         package, and Telegram.Td.dll, which the shipping package does not carry at all. -->
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)$(Platform)\$(Configuration)\Telegram.Native\Telegram.Native.dll" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)$(Platform)\$(Configuration)\Telegram.Native\Telegram.Native.pri" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.dll" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.pri" />
  </ItemGroup>

  <ItemGroup>
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)Libraries\tdjson\$(Platform)\tdjson.dll" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)Libraries\tdjson\$(Platform)\tdjson.pdb" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)Libraries\tdjson\$(Platform)\libcrypto-3$(OpenSSLPlatform).dll" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)Libraries\tdjson\$(Platform)\libssl-3$(OpenSSLPlatform).dll" />
    <ReferenceCopyLocalPaths Include="$(TelegramRoot)Libraries\tdjson\$(Platform)\zlib1.dll" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
