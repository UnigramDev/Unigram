<!--
  Sdk.props is imported by hand rather than through the Sdk attribute because three properties
  have to be set before it: the two output paths, so this project does not share obj\ and bin\
  with Telegram.csproj, and DefaultItemExcludes, because the default globs would otherwise
  compile Telegram.csproj's own generated output - its XamlTypeInfo.g.cs, every page's .g.cs, and
  the .NET Native ilc sources under bin\ - as if they were app source.
-->
<Project>

  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\modern\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\modern\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!--
    The same app on UWP XAML over .NET 10, CsWinRT and NativeAOT, built beside Telegram.csproj
    rather than replacing it: UseDotNetNativeToolchain exists only in the legacy project system
    and UseUwp only in SDK-style, and neither format can produce the other's output.

    Build with Visual Studio's MSBuild, never the dotnet CLI - modern UWP XAML support is imported
    from VS's own ImportBefore/ImportAfter hooks, which the SDK's MSBuild does not have:

      "%ProgramFiles%\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\amd64\MSBuild.exe" ^
        Telegram.Modern.csproj -restore -p:Configuration=Debug -p:Platform=x64

    net10-port-todo.md at the repository root is the plan this belongs to.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <RootNamespace>Telegram</RootNamespace>
    <AssemblyName>Telegram</AssemblyName>
    <DefaultLanguage>en</DefaultLanguage>
    <UseUwp>true</UseUwp>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>

    <!-- PublishAot comes later, once it compiles and runs on CoreCLR. -->
    <PublishAot>false</PublishAot>

    <!-- Properties\AssemblyInfo.cs stays with the legacy project (see the Compile Remove below);
         these carry its values over to the attributes the SDK generates in its place. -->
    <AssemblyTitle>Unigram</AssemblyTitle>
    <Product>Unigram</Product>
    <Copyright>Copyright ©  2015</Copyright>

    <!-- The .NET Native project's constants, minus the ones that were only ever about it.
         NET9_0_OR_GREATER arrives on its own and is what the source already switches on. -->
    <DefineConstants>$(DefineConstants);NETFX_CORE;WINDOWS_UWP;CODE_ANALYSIS</DefineConstants>
    <NoWarn>$(NoWarn);2008</NoWarn>
  </PropertyGroup>

  <!--
    Compile and Page are globbed, against Telegram.csproj's 1250 hand-listed Compile and 473 Page
    entries. The two lists agree today except for the seven files below, which are on disk and not
    in the legacy project; a parity check between the glob and that list is still to be written.
  -->
  <ItemGroup>
    <Compile Remove="Common\HeapSizeCalculator.cs" />
    <Compile Remove="Common\HttpServer.cs" />
    <Compile Remove="Common\MediaHttpServer.cs" />
    <Compile Remove="Controls\SettingsCheckBox.cs" />
    <Compile Remove="Entities\SourceGenerationContext.cs" />
    <Compile Remove="Streams\DiceFileSource.cs" />
    <Compile Remove="Td\Api\ChatProjection.cs" />
    <!-- The SDK generates these attributes itself, and two sets of them is CS0579. -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- App.xaml loads this through ms-appx:/// at runtime, so it ships as loose XAML rather than
       compiled XBF. The modern default items would otherwise sweep it up as a Page. -->
  <ItemGroup>
    <Page Remove="Common\CommonStyles.xaml" />
  </ItemGroup>

  <!--
    A separate identity, so this installs beside the .NET Native build instead of replacing it -
    different package family means a separate LocalState too, so the two do not share an account.
    Patched into obj rather than kept as a second manifest: the real one is 108 lines of
    capabilities, extensions and file associations, and a copy would drift the first time one of
    them changes.
  -->
  <PropertyGroup>
    <!-- Single-project MSIX, so this project can deploy and run on its own while the port is in
         progress. Telegram.Msix still packages the shipping build; Phase 6 decides whether the
         modern one joins it there or keeps packaging itself. Without EnableMsixTooling the PRI
         targets are half-configured and fail on IntermediateExtension. -->
    <AppxPackage>true</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ModernPackageIdentity>38833FF26BA1D.UnigramNet10</ModernPackageIdentity>
    <ModernPackageDisplayName>Unigram .NET 10</ModernPackageDisplayName>
    <!-- BaseIntermediateOutputPath, not IntermediateOutputPath: the latter is still empty when
         this evaluates, which collapses the destination onto Package.appxmanifest itself and
         rewrites the source manifest in place. The guard below is there because that happened. -->
    <ModernAppxManifest>$(BaseIntermediateOutputPath)Package.appxmanifest</ModernAppxManifest>
    <ModernManifestNamespaces>&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;&lt;Namespace Prefix='uap' Uri='http://schemas.microsoft.com/appx/manifest/uap/windows10' /&gt;</ModernManifestNamespaces>
  </PropertyGroup>

  <Target Name="PatchModernAppxManifest"
          BeforeTargets="PrepareForBuild"
          Inputs="Package.appxmanifest;$(MSBuildThisFileFullPath)"
          Outputs="$(ModernAppxManifest)">
    <PropertyGroup>
      <_ModernManifestFull>$([System.IO.Path]::GetFullPath('$(ModernAppxManifest)'))</_ModernManifestFull>
      <_SourceManifestFull>$([System.IO.Path]::GetFullPath('Package.appxmanifest'))</_SourceManifestFull>
    </PropertyGroup>
    <Error Condition="'$(_ModernManifestFull)' == '$(_SourceManifestFull)'"
           Text="ModernAppxManifest resolves to the source manifest; patching it would rewrite Telegram.csproj's own identity." />
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(ModernAppxManifest)" />
    <XmlPoke XmlInputPath="$(ModernAppxManifest)" Namespaces="$(ModernManifestNamespaces)"
             Query="/f:Package/f:Identity/@Name" Value="$(ModernPackageIdentity)" />
    <XmlPoke XmlInputPath="$(ModernAppxManifest)" Namespaces="$(ModernManifestNamespaces)"
             Query="/f:Package/f:Properties/f:DisplayName" Value="$(ModernPackageDisplayName)" />
    <XmlPoke XmlInputPath="$(ModernAppxManifest)" Namespaces="$(ModernManifestNamespaces)"
             Query="/f:Package/f:Applications/f:Application/uap:VisualElements/@DisplayName" Value="$(ModernPackageDisplayName)" />
  </Target>

  <ItemGroup>
    <!-- The .resw under Strings\ need no PRIResource items: with the MSIX tooling on, the SDK
         globs them itself, and listing them as well is NETSDK1022. -->
    <AppxManifest Include="$(ModernAppxManifest)" />
  </ItemGroup>

  <!--
    Content needs CopyToOutputDirectory here. The legacy UWP project system packaged Content
    implicitly; SDK-style does not, and without it the app starts, initialises TDLib, and then
    dies on `Cannot locate resource from 'ms-appx:///Common/CommonStyles.xaml'` because nothing
    under Assets\ or Common\ was ever laid down.

    Assets\** is auto-included by the MSIX tooling, so it is updated rather than included.

    TODO: Assets\** is 360 files where Telegram.csproj lists 266 of them. Harmless while this is a
    development build, wrong for a package; reconcile before anything ships.
  -->
  <ItemGroup>
    <Content Update="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Common\CommonStyles.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\unigram-iv-editor\editor.html" Link="Assets\editor.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\libprisma\libprisma\grammars.dat" Link="Assets\grammars.dat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Libraries\MicroTeX\res\fonts\**\*.ttf" Link="res\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\i420.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Rg.DiffUtils" Version="1.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.11" />
    <PackageReference Include="Win2D.uwp" Version="1.28.3" />
    <!-- Dropped against Telegram.csproj: Microsoft.NETCore.UniversalWindowsPlatform, System.Memory,
         System.ValueTuple, Microsoft.Bcl.HashCode, PolySharp, System.Text.Json,
         System.Threading.Channels (all in-box on net10.0, and NU1510 for the last two), and
         System.Reflection.Metadata, which nothing in the app references. -->
  </ItemGroup>

  <!--
    The three local WinRT components. A bare winmd Reference, which is what Telegram.csproj uses
    for RLottie, is rejected here with NETSDK1130, so CsWinRT generates the projections instead.
    Everything in CsWinRTInputs is read for metadata; only the namespaces in CsWinRTIncludes are
    emitted - which is why Win2D's winmd is an input (both components have Win2D types in their
    signatures) while Win2D itself still comes from its own package projection.
  -->
  <PropertyGroup>
    <CsWinRTIncludes>RLottie;Telegram.Native</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <CsWinRTInputs Include="..\Libraries\rlottie\$(Platform)\RLottie.winmd" />
    <CsWinRTInputs Include="..\$(Platform)\$(Configuration)\Telegram.Native\Telegram.Native.winmd" />
    <CsWinRTInputs Include="..\$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.winmd" />
    <CsWinRTInputs Include="$(NuGetPackageRoot)win2d.uwp\1.28.3\lib\uap10.0\Microsoft.Graphics.Canvas.winmd" />
  </ItemGroup>

  <!-- Kept in step with Telegram.csproj by hand: the generator reads TdParsers and emits parsers,
       the hand-written code reads the constants and calls them, so the two projects must agree or
       the generated file calls helpers that were compiled out. -->
  <PropertyGroup>
    <TdParsers>Both</TdParsers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TdParsers)' != 'Pointer'">
    <DefineConstants>$(DefineConstants);TD_READER_PARSER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TdParsers)' != 'Reader'">
    <DefineConstants>$(DefineConstants);TD_POINTER_PARSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Telegram.Generators\Telegram.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="..\Libraries\tdjson\td_api.tl" />
    <CompilerVisibleProperty Include="TdParsers" />
  </ItemGroup>

  <!-- Same copy-local set as Telegram.csproj, including tdjson.pdb by name: it arrives as a copy
       local path rather than a Reference, so RAR never runs its related-file discovery and without
       this the symbols are missing from every TDLib crash. -->
  <PropertyGroup>
    <OpenSSLPlatform>-$(Platform)</OpenSSLPlatform>
  </PropertyGroup>

  <!-- The two C++/WinRT components are consumed as projections rather than ProjectReferences, so
       nothing copies their binaries the way a project reference would. They come from the same
       build output the winmds are read from, which is also why this project does not build them:
       Telegram.Native has to have been built by the solution first. Calls only adds its own two
       files; the rest of its folder is the same ffmpeg set. -->
  <ItemGroup>
    <!-- zlib1 and Win2D also arrive with tdjson and from the Win2D package respectively. The
         legacy build copies both copies over each other and lets the last one win; publish here
         calls that NETSDK1152, so the native folder's are the ones dropped. -->
    <ReferenceCopyLocalPaths Include="..\$(Platform)\$(Configuration)\Telegram.Native\*.dll"
                             Exclude="..\$(Platform)\$(Configuration)\Telegram.Native\zlib1.dll;..\$(Platform)\$(Configuration)\Telegram.Native\Microsoft.Graphics.Canvas.dll" />
    <ReferenceCopyLocalPaths Include="..\$(Platform)\$(Configuration)\Telegram.Native\Telegram.Native.pri" />
    <ReferenceCopyLocalPaths Include="..\$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.dll" />
    <ReferenceCopyLocalPaths Include="..\$(Platform)\$(Configuration)\Telegram.Native.Calls\Telegram.Native.Calls.pri" />
  </ItemGroup>

  <ItemGroup>
    <ReferenceCopyLocalPaths Include="..\Libraries\rlottie\$(Platform)\RLottie.dll" />
    <ReferenceCopyLocalPaths Include="..\Libraries\rlottie\$(Platform)\RLottie.pri" />
    <ReferenceCopyLocalPaths Include="..\Libraries\tdjson\$(Platform)\tdjson.dll" />
    <ReferenceCopyLocalPaths Include="..\Libraries\tdjson\$(Platform)\tdjson.pdb" />
    <ReferenceCopyLocalPaths Include="..\Libraries\tdjson\$(Platform)\libcrypto-3$(OpenSSLPlatform).dll" />
    <ReferenceCopyLocalPaths Include="..\Libraries\tdjson\$(Platform)\libssl-3$(OpenSSLPlatform).dll" />
    <ReferenceCopyLocalPaths Include="..\Libraries\tdjson\$(Platform)\zlib1.dll" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
