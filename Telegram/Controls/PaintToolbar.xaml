<Grid x:Class="Telegram.Controls.PaintToolbar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Telegram.Controls"
      xmlns:icons="using:Telegram.Assets.Icons"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="60" />
    </Grid.RowDefinitions>

    <!-- The tools of the tab chosen in the bar below. -->
    <Grid x:Name="ToolsPanel"
          Background="{ThemeResource SystemControlChromeMediumLowAcrylicElementMediumBrush}"
          CornerRadius="15"
          Padding="4,0,8,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Margin="24,0,24,8"
          Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:GlyphButton x:Name="Undo"
                              Click="Undo_Click"
                              Margin="0,0,-4,0"
                              Glyph="&#xE7A7;" />

        <controls:GlyphButton x:Name="Redo"
                              Click="Redo_Click"
                              Glyph="&#xE7A6;"
                              Margin="0,0,-4,0"
                              Grid.Column="1" />

        <controls:GlyphButton x:Name="ColorButton"
                              Glyph=""
                              AutomationProperties.Name="{CustomResource PaintColor}"
                              ToolTipService.ToolTip="{CustomResource PaintColor}"
                              Margin="0,0,-4,0"
                              Grid.Column="2">
            <controls:GlyphButton.Flyout>
                <Flyout x:Name="ColorFlyout"
                        Placement="Top"
                        Opening="ColorFlyout_Opening"
                        Closed="ColorFlyout_Closed">
                    <Grid>
                        <StackPanel x:Name="PalettePanel"
                                    Orientation="Horizontal">
                            <GridView x:Name="ColorPalette"
                                      IsItemClickEnabled="True"
                                      ItemClick="ColorPalette_ItemClick"
                                      SelectionMode="Single">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="7"
                                                       Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="SolidColorBrush">
                                        <Ellipse Fill="{x:Bind}"
                                                 Width="28"
                                                 Height="28"
                                                 Margin="4" />
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <controls:GlyphButton Click="MoreColors_Click"
                                                  Glyph="&#xE2B1;"
                                                  AutomationProperties.Name="{CustomResource PaintMoreColors}"
                                                  ToolTipService.ToolTip="{CustomResource PaintMoreColors}"
                                                  VerticalAlignment="Center" />
                        </StackPanel>

                        <controls:PaintColorPicker x:Name="CustomColorPicker"
                                                   x:Load="False"
                                                   ColorChanged="CustomColorPicker_ColorChanged"
                                                   EyedropperRequested="CustomColorPicker_EyedropperRequested"
                                                   Completed="CustomColorPicker_Completed" />
                    </Grid>
                </Flyout>
            </controls:GlyphButton.Flyout>
        </controls:GlyphButton>

        <!-- Over the button rather than in it: GlyphButton draws only its glyph. -->
        <Grid x:Name="ColorSwatchPanel"
              Width="24"
              Height="24"
              IsHitTestVisible="False"
              Grid.Column="2">
                <Path Data="M 23,12 A 11,11 0 0 1 18.858,20.6"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="23,12"
                                             EndPoint="18.858,20.6">
                            <GradientStop Color="#FFEB4B4B"
                                          Offset="0" />
                            <GradientStop Color="#FFEE82EE"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 18.858,20.6 A 11,11 0 0 1 9.552,22.724"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="18.858,20.6"
                                             EndPoint="9.552,22.724">
                            <GradientStop Color="#FFEE82EE"
                                          Offset="0" />
                            <GradientStop Color="#FF6080E4"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 9.552,22.724 A 11,11 0 0 1 2.089,16.773"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="9.552,22.724"
                                             EndPoint="2.089,16.773">
                            <GradientStop Color="#FF6080E4"
                                          Offset="0" />
                            <GradientStop Color="#FF00FFFF"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 2.089,16.773 A 11,11 0 0 1 2.089,7.227"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="2.089,16.773"
                                             EndPoint="2.089,7.227">
                            <GradientStop Color="#FF00FFFF"
                                          Offset="0" />
                            <GradientStop Color="#FF8FCE00"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 2.089,7.227 A 11,11 0 0 1 9.552,1.276"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="2.089,7.227"
                                             EndPoint="9.552,1.276">
                            <GradientStop Color="#FF8FCE00"
                                          Offset="0" />
                            <GradientStop Color="#FFFFFF00"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 9.552,1.276 A 11,11 0 0 1 18.858,3.4"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="9.552,1.276"
                                             EndPoint="18.858,3.4">
                            <GradientStop Color="#FFFFFF00"
                                          Offset="0" />
                            <GradientStop Color="#FFFFA500"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Path Data="M 18.858,3.4 A 11,11 0 0 1 23,12"
                      StrokeThickness="2">
                    <Path.Stroke>
                        <LinearGradientBrush MappingMode="Absolute"
                                             StartPoint="18.858,3.4"
                                             EndPoint="23,12">
                            <GradientStop Color="#FFFFA500"
                                          Offset="0" />
                            <GradientStop Color="#FFEB4B4B"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
            <Ellipse x:Name="ColorSwatch"
                     Width="16"
                     Height="16" />
        </Grid>

        <Border x:Name="ToolSelection"
                Background="{ThemeResource NavigationViewItemBackgroundSelected}"
                CornerRadius="{StaticResource GlyphButtonCornerRadius}"
                Margin="4,4,0,4"
                IsHitTestVisible="False"
                Grid.Column="3">
            <Border.TranslationTransition>
                <Vector3Transition Duration="0:0:0.25" />
            </Border.TranslationTransition>
        </Border>

        <controls:AnimatedIconToggleButton x:Name="PenTool"
                                           Click="Tool_Click"
                                           Glyph="&#xF79F;"
                                           CheckedGlyph="&#xF79F;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintPen}"
                                           ToolTipService.ToolTip="{CustomResource PaintPen}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="3">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintPen />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <controls:AnimatedIconToggleButton x:Name="ArrowTool"
                                           Click="Tool_Click"
                                           Glyph="&#xF7A0;"
                                           CheckedGlyph="&#xF7A0;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintArrow}"
                                           ToolTipService.ToolTip="{CustomResource PaintArrow}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="4">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintArrow />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <controls:AnimatedIconToggleButton x:Name="MarkerTool"
                                           Click="Tool_Click"
                                           Glyph="&#xF79A;"
                                           CheckedGlyph="&#xF79A;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintMarker}"
                                           ToolTipService.ToolTip="{CustomResource PaintMarker}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="5">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintMarker />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <controls:AnimatedIconToggleButton x:Name="NeonTool"
                                           Click="Tool_Click"
                                           Glyph="&#xF7A1;"
                                           CheckedGlyph="&#xF7A1;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintNeon}"
                                           ToolTipService.ToolTip="{CustomResource PaintNeon}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="6">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintNeon />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <controls:AnimatedIconToggleButton x:Name="BlurTool"
                                           Click="Tool_Click"
                                           Glyph="&#xF7A2;"
                                           CheckedGlyph="&#xF7A2;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintBlur}"
                                           ToolTipService.ToolTip="{CustomResource PaintBlur}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="7">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintBlur />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <controls:AnimatedIconToggleButton x:Name="EraserTool"
                                           Click="Tool_Click"
                                           Glyph="&#xE75C;"
                                           CheckedGlyph="&#xE75C;"
                                           IsOneWay="True"
                                           AutomationProperties.Name="{CustomResource PaintEraser}"
                                           ToolTipService.ToolTip="{CustomResource PaintEraser}"
                                           Margin="0,0,-4,0"
                                           Grid.Column="8">
            <controls:AnimatedIconToggleButton.Source>
                <icons:PaintEraser />
            </controls:AnimatedIconToggleButton.Source>
        </controls:AnimatedIconToggleButton>

        <!-- In place of the brushes on the text tab. -->
        <StackPanel x:Name="TextOptions"
                    Orientation="Horizontal"
                    Visibility="Collapsed"
                    Grid.Column="3"
                    Grid.ColumnSpan="6">
            <controls:GlyphButton x:Name="AlignButton"
                                  Click="AlignButton_Click"
                                  Glyph="&#xEB12;"
                                  AutomationProperties.Name="{CustomResource ArticleAlignment}"
                                  ToolTipService.ToolTip="{CustomResource ArticleAlignment}"
                                  Margin="0,0,-4,0" />

            <Grid Margin="0,0,-4,0">
                <controls:GlyphButton Click="FrameButton_Click"
                                      Glyph=""
                                      AutomationProperties.Name="{CustomResource PaintTextBackground}"
                                      ToolTipService.ToolTip="{CustomResource PaintTextBackground}" />

                <!-- Over the button rather than in it: GlyphButton draws only its glyph. -->
                <Grid Width="20"
                      Height="20"
                      IsHitTestVisible="False">
                    <Border x:Name="FrameFilled"
                            Background="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            CornerRadius="5">
                        <TextBlock Text="A"
                                   Foreground="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FrameTranslucent"
                            Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                            CornerRadius="5"
                            Visibility="Collapsed">
                        <TextBlock Text="A"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="FrameSolid"
                            BorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            BorderThickness="1.5"
                            CornerRadius="5"
                            Visibility="Collapsed">
                        <TextBlock Text="A"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="FrameNone"
                               Text="A"
                               FontWeight="Bold"
                               FontSize="15"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <controls:GlyphButton x:Name="FontButton"
                                  Click="FontButton_Click"
                                  FontSize="15"
                                  Width="Auto"
                                  AutomationProperties.Name="{CustomResource FontType}"
                                  ToolTipService.ToolTip="{CustomResource FontType}"
                                  Margin="0,0,-4,0" />

            <controls:GlyphButton Click="AddText_Click"
                                  Glyph="&#xE710;"
                                  AutomationProperties.Name="{CustomResource AccDescrPlaceText}"
                                  ToolTipService.ToolTip="{CustomResource AccDescrPlaceText}"
                                  Margin="0,0,-4,0" />
        </StackPanel>
    </Grid>

    <controls:PencilWeightSlider x:Name="WeightSlider"
                                 ValueChanged="WeightSlider_ValueChanged"
                                 DragStarted="WeightSlider_DragStarted"
                                 DragCompleted="WeightSlider_DragCompleted"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.Name="{CustomResource PaintSize}" />

    <Ellipse x:Name="WeightPreview"
             Fill="#FFFFFFFF"
             Stroke="#40000000"
             StrokeThickness="1"
             Visibility="Collapsed"
             IsHitTestVisible="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" />
</Grid>
