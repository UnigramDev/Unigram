<Grid x:Class="Telegram.Controls.MediaEditorSurface"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Telegram.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Opacity="0"
      IsHitTestVisible="False">

    <!-- Hidden, not collapsed, until the cropper first lays the media out: before that nothing
         is transformed, so the layers would fill the window and a frame's fill would draw at
         its full size. Collapsed, the cropper would never get the size it lays out in. -->

    <!-- A frame's fill, behind the media: it shows wherever the media does not cover the frame.
         Laid out in the cropper's coordinates, inside its padding. -->
    <Canvas x:Name="FrameBackdrop"
            x:Load="False"
            Margin="{x:Bind Cropper.Padding, Mode=OneTime}"
            IsHitTestVisible="False">
        <Rectangle x:Name="FrameFill">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop x:Name="FrameFillTop"
                                  Color="Black"
                                  Offset="0" />
                    <GradientStop x:Name="FrameFillBottom"
                                  Color="Black"
                                  Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <MatrixTransform x:Name="FrameFillTransform" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Canvas>

    <controls:ImageCropper x:Name="Cropper"
                           x:FieldModifier="public"
                           ViewChanged="Cropper_ViewChanged"
                           Padding="24">
        <Grid x:Name="MediaContent">
            <SwapChainPanel x:Name="Video"
                            x:Load="False" />
            <Grid x:Name="Layers">
                <controls:PencilCanvas x:Name="Canvas"
                                       x:FieldModifier="public"
                                       Gesture="Canvas_Gesture"
                                       ShapeRecognized="Canvas_ShapeRecognized"
                                       StrokeStarted="Canvas_StrokeStarted"
                                       IsEnabled="False" />
                <controls:PaintEntityLayer x:Name="Entities"
                                           x:FieldModifier="public"
                                           HandleBrush="{ThemeResource TelegramBackgroundAccentBrush}"
                                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </controls:ImageCropper>

    <!-- In a frame, what is drawn and placed belongs to the frame rather than to the media, so
         the layers move here, over the cropper, laid out at the frame's size. -->
    <Canvas x:Name="FrameOverlay"
            x:Load="False"
            Margin="{x:Bind Cropper.Padding, Mode=OneTime}">
        <Grid x:Name="FrameLayer">
            <Grid.RenderTransform>
                <MatrixTransform x:Name="FrameLayerTransform" />
            </Grid.RenderTransform>
        </Grid>
    </Canvas>
</Grid>
