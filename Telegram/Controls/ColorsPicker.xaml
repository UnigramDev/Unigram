<Grid x:Class="Telegram.Controls.ColorsPicker"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Telegram.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="300"
      d:DesignWidth="400">

    <Grid.RowDefinitions>
        <RowDefinition Height="48" />
        <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <controls:ColorTextBox x:Name="TextColor1"
                           ColorChanged="TextColor_ColorChanged"
                           HorizontalAlignment="Stretch"
                           Margin="12,8,0,8" />

    <RadioButton x:Name="RadioColor1"
                 Style="{StaticResource AccentRadioButtonStyle}"
                 Checked="RadioColor_Toggled"
                 Unchecked="RadioColor_Toggled"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Grid.Column="1">
        <RadioButton.Background>
            <SolidColorBrush x:Name="BrushColor1" />
        </RadioButton.Background>
    </RadioButton>

    <RadioButton x:Name="RadioColor2"
                 Style="{StaticResource AccentRadioButtonStyle}"
                 Checked="RadioColor_Toggled"
                 Unchecked="RadioColor_Toggled"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Grid.Column="2">
        <RadioButton.Background>
            <SolidColorBrush x:Name="BrushColor2" />
        </RadioButton.Background>
    </RadioButton>

    <RadioButton x:Name="RadioColor3"
                 Style="{StaticResource AccentRadioButtonStyle}"
                 Checked="RadioColor_Toggled"
                 Unchecked="RadioColor_Toggled"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Grid.Column="3">
        <RadioButton.Background>
            <SolidColorBrush x:Name="BrushColor3" />
        </RadioButton.Background>
    </RadioButton>

    <RadioButton x:Name="RadioColor4"
                 Style="{StaticResource AccentRadioButtonStyle}"
                 Checked="RadioColor_Toggled"
                 Unchecked="RadioColor_Toggled"
                 HorizontalContentAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0"
                 Grid.Column="4">
        <RadioButton.Background>
            <SolidColorBrush x:Name="BrushColor4" />
        </RadioButton.Background>
    </RadioButton>

    <controls:GlyphButton x:Name="RemoveColorButton"
                          Click="RemoveColor_Click"
                          Glyph="&#xE711;"
                          Margin="0,0,-18,0"
                          Grid.Column="4" />

    <controls:AnimatedGlyphButton x:Name="AddRemoveColorButton"
                                  Click="AddRemoveColor_Click"
                                  Margin="8,0,0,0"
                                  Grid.Column="5" />

    <controls:ColorPicker x:Name="PickerColor"
                          ColorChanged="PickerColor_ColorChanged"
                          HorizontalAlignment="Stretch"
                          Grid.Row="1"
                          Grid.ColumnSpan="6" />
</Grid>
