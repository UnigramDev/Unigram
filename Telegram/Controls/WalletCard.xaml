<UserControl x:Class="Telegram.Controls.WalletCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Telegram.Controls"
             xmlns:controls="using:Telegram.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:graphics="using:Telegram.Native.Graphics"
             mc:Ignorable="d">

    <!-- The perspective the tilt bends the card through. It has to sit on the card's own
         parent: AttachTilt puts the vanishing point over the element it is attached to, and
         reads that element's parent to do it - so this has to travel with the card rather than
         stay on whatever screen is showing it.

         In markup rather than from code because XAML owns an element's TransformMatrix and
         rewrites it on layout, which is what a PerspectiveTransform3D goes through. -->
    <Grid>
        <Grid.Transform3D>
            <PerspectiveTransform3D Depth="800" />
        </Grid.Transform3D>
        <controls:AspectView x:Name="LayoutRoot"
                             Background="Transparent">
            <!-- Carries the conic gradient so it can rotate on its own
                 while the card tilts. Oversized and clipped by AttachTilt. -->
            <Border x:Name="SheenRoot">
                <Rectangle x:Name="Sheen"
                           Visibility="Visible" />
            </Border>
            <!--<Image Source="ms-appx:///Views/Wallet/Card.png"
                   VerticalAlignment="Bottom"
                   Visibility="Collapsed" />
            <Image Source="ms-appx:///Views/Wallet/Card.png"
                   VerticalAlignment="Top"
                   Visibility="Collapsed" />-->
            <Viewbox>
                <!--<Grid Width="360"
                      Height="227.333">-->
                <Grid Width="360"
                      Height="220">
                    <Grid HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Opacity="0.3">
                        <!-- box-shadow: 0px 1px 0px 0px rgba(255, 255, 255, 0.06)
                             is applied in OnLoaded — it needs the glyph
                             alpha mask, which markup cannot express. -->
                        <Border x:Name="CardAddressShadow"
                                RenderTransformOrigin="0.5,0.5"
                                Opacity="0.6">
                            <!--<Border.RenderTransform>
                                <RotateTransform Angle="90" />
                            </Border.RenderTransform>-->
                        </Border>
                        <TextBlock x:Name="CardAddress"
                                   FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="#000000"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                    <HyperlinkButton Style="{StaticResource EmptyHyperlinkButtonStyle}"
                                     Width="48"
                                     Height="36"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,80,48,0">
                        <Grid BorderBrush="#28000000"
                              BorderThickness="1"
                              CornerRadius="8">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="-0.039,0.090"
                                                     EndPoint="1.039,0.910">
                                    <GradientStop Color="#E0BBBDC0"
                                                  Offset="0.0799" />
                                    <GradientStop Color="#E0FFFFFF"
                                                  Offset="0.922" />
                                </LinearGradientBrush>
                            </Grid.Background>
                            <!--<TextBlock Text="&#xEACA;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />-->
                            <Grid Width="16"
                                  Height="16">
                                <Border Width="7"
                                        Height="7"
                                        BorderThickness="1"
                                        BorderBrush="#1A1A1A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CornerRadius="2" />
                                <Border Width="7"
                                        Height="7"
                                        BorderThickness="1"
                                        BorderBrush="#1A1A1A"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="2" />
                                <Border Width="7"
                                        Height="7"
                                        BorderThickness="1"
                                        BorderBrush="#1A1A1A"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        CornerRadius="2" />
                                <Grid Width="7"
                                      Height="7"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Bottom">
                                    <Border Width="2"
                                            Height="2"
                                            Background="#1A1A1A"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top" />
                                    <Border Width="2"
                                            Height="2"
                                            Background="#1A1A1A"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top" />
                                    <Border Width="2"
                                            Height="2"
                                            Background="#1A1A1A"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom" />
                                    <Border Width="2"
                                            Height="2"
                                            Background="#1A1A1A"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" />
                                    <Border Width="2"
                                            Height="2"
                                            Background="#1A1A1A" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </HyperlinkButton>
                    <Grid HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="20,76,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--<Border Background="White"
                                Width="28"
                                Height="28">
                            <Border Width="19.968095779418945"
                                    Height="16.878997802734375"
                                    Margin="4.01,5.6,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="Red" />
                        </Border>-->
                        <Border x:Name="CardBalanceIcon"
                                Width="28"
                                Height="28"
                                Canvas.ZIndex="1">
                            <graphics:Scene3DPanel x:Name="Diamond"
                                                   Model="Diamond"
                                                   Palette="Ice"
                                                   PressScale="3"
                                                   IsSpinning="True"
                                                   IsInteractive="True"
                                                   FallbackText="&#xEA7E;"
                                                   FallbackFontSize="24"
                                                   FallbackFontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   FallbackForeground="#FFFFFF"
                                                   Width="40"
                                                   Height="40"
                                                   Margin="-10,-8,-2,-4" />
                        </Border>

                        <TextBlock x:Name="CardBalanceText"
                                   FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                   FontWeight="SemiBold"
                                   FontSize="22"
                                   Foreground="#FFFFFF"
                                   Grid.Column="1">
                            <Run x:Name="CardBalance" /><Run x:Name="CardBalanceFraction"
                                                             FontSize="18" />
                            <Run x:Name="CardBalanceGram"
                                 Text="GRAM"
                                 Foreground="#6DDCFF" />
                        </TextBlock>
                        <TextBlock x:Name="CardBalanceUsd"
                                   FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                                   FontWeight="Bold"
                                   Foreground="#6DDCFF"
                                   Margin="4"
                                   Grid.ColumnSpan="2"
                                   Grid.Row="1" />
                    </Grid>
                    <!-- What the two lines above look like before there is anything to
                         put in them. The bars are drawn by the skeleton itself, clipped
                         to its own geometry, so this only reserves the room. -->
                    <Border x:Name="CardBalanceSkeleton"
                            Width="180"
                            Height="62"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Margin="20,76,0,0" />

                    <TextBlock x:Name="CardName"
                               FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                               FontWeight="Medium"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="24,20" />
                </Grid>
            </Viewbox>
        </controls:AspectView>
    </Grid>
</UserControl>
