<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Telegram.Controls.Messages.Content"
                    xmlns:controls="using:Telegram.Controls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d"
                    d:DesignHeight="300"
                    d:DesignWidth="400">

    <Style TargetType="local:PollContent">
        <Setter Property="MinWidth"
                Value="220" />
        <!--  The explanation's frame, replaced by the sender's colour on incoming polls.  -->
        <Setter Property="BorderBrush"
                Value="{ThemeResource MessageHeaderBorderBrush}" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PollContent">
                    <StackPanel>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="RunningOut">
                                    <VisualState.Setters>
                                        <Setter Target="Timeout.Foreground"
                                                Value="{ThemeResource MessagePollWrongBrush}" />
                                        <Setter Target="TimeoutGlyph.Foreground"
                                                Value="{ThemeResource MessagePollWrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Default" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Media" />
                        <controls:FormattedTextBlock x:Name="Description"
                                                     TextWrapping="Wrap"
                                                     TextTrimming="CharacterEllipsis"
                                                     FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                     IsTextSelectionEnabled="True"
                                                     AutoFontSize="True"
                                                     Margin="10,4,10,0"/>

                        <!--  Framed as a link preview is, and in the same colours.  -->
                        <Grid x:Name="ExplanationRoot"
                              x:Load="False"
                              CornerRadius="4"
                              Margin="10,6,10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{TemplateBinding BorderBrush}"
                                       Opacity="0.1"
                                       Grid.ColumnSpan="2" />
                            <Rectangle Fill="{TemplateBinding BorderBrush}"
                                       HorizontalAlignment="Left"
                                       Width="3" />
                            <controls:DashPath x:Name="ExplanationDash" />

                            <Grid Padding="8,0,0,8"
                                  Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{CustomResource QuizExplanationTitle}"
                                           Foreground="{TemplateBinding BorderBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />

                                <!--  Taller than the title: the margin keeps it from setting the
                                      row's height and pushing the explanation down.  -->
                                <controls:GlyphButton x:Name="ExplanationClose"
                                                      Glyph="&#xE711;"
                                                      FontSize="12"
                                                      Foreground="{TemplateBinding BorderBrush}"
                                                      AutomationProperties.Name="{CustomResource Close}"
                                                      VerticalAlignment="Top"
                                                      Width="28"
                                                      Height="28"
                                                      Margin="0,0,0,-8"
                                                      Grid.Column="1" />

                                <controls:FormattedTextBlock x:Name="ExplanationText"
                                                             TextWrapping="Wrap"
                                                             FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                             IsTextSelectionEnabled="True"
                                                             AutoFontSize="False"
                                                             Margin="0,0,8,0"
                                                             Grid.Row="1"
                                                             Grid.ColumnSpan="2" />

                                <Border x:Name="ExplanationMedia"
                                        CornerRadius="4"
                                        Margin="0,6,8,0"
                                        Grid.Row="2"
                                        Grid.ColumnSpan="2" />
                            </Grid>
                        </Grid>

                        <Grid Margin="10,4,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top">
                                <controls:FormattedTextBlock x:Name="QuestionText"
                                                             TextWrapping="Wrap"
                                                             TextTrimming="CharacterEllipsis"
                                                             FontWeight="SemiBold"
                                                             FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                                             IsTextSelectionEnabled="False"
                                                             AutoFontSize="False" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Type"
                                               Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,0,4,4" />

                                    <controls:RecentUserHeads x:Name="RecentVoters"
                                                              BorderBrush="{ThemeResource MessageBackgroundBrush}"
                                                              ItemSize="18"
                                                              ItemOverlap="6"
                                                              Margin="0,0,0,-6" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="TimeoutLabel"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Margin="10,0,0,4"
                                        Grid.Column="1">
                                <TextBlock x:Name="Timeout"
                                           Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                           Style="{StaticResource BodyTextBlockStyle}" />

                                <TextBlock x:Name="TimeoutGlyph"
                                           Text="&#xE916;"
                                           FontSize="{StaticResource GlyphMediumFontSize}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                           TextLineBounds="Tight"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,2" />
                            </StackPanel>

                            <controls:GlyphButton x:Name="Explanation"
                                                  Glyph="&#xEA80;"
                                                  Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                                  Margin="0,-4,-10,-5"
                                                  Grid.Column="1" />
                        </Grid>

                        <StackPanel x:Name="Options" />

                        <local:PollAddContent x:Name="AddOption"
                                              x:Load="False" />

                        <TextBlock x:Name="Votes"
                                   Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                   TextAlignment="Center"
                                   Margin="0,8,0,4" />

                        <Button x:Name="Submit"
                                Style="{StaticResource ListEmptyButtonStyle}"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Margin="0,4,0,0">
                            <TextBlock Text="{CustomResource PollSubmitVotesNoCaps}"
                                       Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="8,4,8,4" />
                        </Button>

                        <!--  Leaves the focus in the option's field, which would otherwise lose
                              it on the press and take this button away before the click.  -->
                        <Button x:Name="Save"
                                x:Load="False"
                                Style="{StaticResource ListEmptyButtonStyle}"
                                AllowFocusOnInteraction="False"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Margin="0,4,0,0">
                            <TextBlock Text="{CustomResource PollButtonSave}"
                                       Foreground="{ThemeResource MessageHeaderBorderBrush}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="8,4,8,4" />
                        </Button>

                        <Button x:Name="View"
                                Style="{StaticResource ListEmptyButtonStyle}"
                                HorizontalAlignment="Center"
                                CornerRadius="4"
                                Margin="0,4,0,0">
                            <TextBlock x:Name="ViewText"
                                       Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="8,4,8,4" />
                        </Button>

                        <TextBlock x:Name="EndsIn"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource MessageSubtleForegroundBrush}"
                                   TextAlignment="Center"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,4" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
