<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="using:Telegram.Controls"
                    xmlns:local="using:Telegram.Controls.Messages.Content"
                    mc:Ignorable="d">

    <Style TargetType="local:PhotoContent">
        <Setter Property="MinWidth"
                Value="{ThemeResource TelegramMediaMinWidth}" />
        <Setter Property="MinHeight"
                Value="{ThemeResource TelegramMediaMinHeight}" />
        <Setter Property="MaxWidth"
                Value="{ThemeResource TelegramMediaMaxWidth}" />
        <Setter Property="MaxHeight"
                Value="{ThemeResource TelegramMediaMaxHeight}" />
        <Setter Property="RequestedTheme"
                Value="Dark" />
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="HorizontalContentAlignment"
                Value="Left" />
        <Setter Property="VerticalAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="FontFamily"
                Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="Height"
                Value="Auto" />
        <Setter Property="Width"
                Value="Auto" />
        <Setter Property="FontWeight"
                Value="Normal" />
        <Setter Property="FontSize"
                Value="24" />
        <Setter Property="CornerRadius"
                Value="0" />
        <Setter Property="UseSystemFocusVisuals"
                Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="FocusVisualMargin"
                Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:PhotoContent">
                    <controls:AspectView x:Name="LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background"
                                                Value="{ThemeResource SystemControlBackgroundListLowBrush}" />
                                        <Setter Target="ContentPresenter1.Foreground"
                                                Value="{ThemeResource SystemControlHighlightBaseMediumHighBrush}" />
                                        <Setter Target="ContentPresenter2.Foreground"
                                                Value="{ThemeResource SystemControlHighlightBaseMediumHighBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background"
                                                Value="{ThemeResource SystemControlBackgroundListMediumBrush}" />
                                        <Setter Target="ContentPresenter1.Foreground"
                                                Value="{ThemeResource SystemControlHighlightBaseMediumBrush}" />
                                        <Setter Target="ContentPresenter2.Foreground"
                                                Value="{ThemeResource SystemControlHighlightBaseMediumBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter1.Foreground"
                                                Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                        <Setter Target="ContentPresenter2.Foreground"
                                                Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <controls:AspectView.Background>
                            <ImageBrush x:Name="ThumbnailTexture"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </controls:AspectView.Background>
                        <Border>
                            <Border.Background>
                                <ImageBrush x:Name="Texture"
                                            AlignmentX="Center"
                                            AlignmentY="Center" />
                            </Border.Background>
                        </Border>

                        <!--<controls:AnimatedImage x:Name="Player"
                                                AutoPlay="False"
                                                FrameSize="0,0"
                                                ResizeMode="Fit"
                                                DecodeFrameType="Logical"
                                                IsCachingEnabled="False"
                                                Stretch="UniformToFill"
                                                IsHitTestVisible="False" />-->

                        <controls:AnimatedImage x:Name="Particles"
                                                x:Load="False"
                                                IsViewportAware="True"
                                                FrameSize="0,0"
                                                ResizeMode="Fill"
                                                DecodeFrameType="Logical"
                                                Stretch="UniformToFill" />

                        <Border x:Name="Overlay"
                                x:Load="False"
                                Background="{ThemeResource MessageOverlayBackgroundBrush}"
                                CornerRadius="{ThemeResource MessageOverlayCornerRadius}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Padding="6,1,6,3"
                                Margin="4">
                            <TextBlock x:Name="Subtitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                       Foreground="White"
                                       TextAlignment="Right"
                                       TextWrapping="NoWrap" />
                        </Border>

                        <Border x:Name="RootOverlay"
                                Background="#54000000"
                                CornerRadius="24"
                                Width="48"
                                Height="48"
                                Visibility="Collapsed">
                            <Grid x:Name="RootGrid">
                                <TextBlock x:Name="ContentPresenter1"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ContentPresenter2"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <controls:ProgressBarRing x:Name="ProgressBar"
                                                          x:Load="False"
                                                          Foreground="#FFFFFF"
                                                          IsHitTestVisible="False"
                                                          Width="48"
                                                          Height="48" />
                            </Grid>
                        </Border>
                        <controls:SelfDestructTimer x:Name="Timer"
                                                    x:Load="False"
                                                    Background="Transparent"
                                                    Foreground="White"
                                                    IsHitTestVisible="False" />
                    </controls:AspectView>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
