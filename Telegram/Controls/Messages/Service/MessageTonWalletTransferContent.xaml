<messages:MessageService x:Class="Telegram.Controls.Messages.Service.MessageTonWalletTransferContent"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:Telegram.Controls.Messages.Service"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:messages="using:Telegram.Controls.Messages"
                         xmlns:controls="using:Telegram.Controls"
                         xmlns:graphics="using:Telegram.Native.Graphics"
                         Click="Service_Click"
                         mc:Ignorable="d"
                         d:DesignHeight="300"
                         d:DesignWidth="400">

    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentPresenter HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                <messages:ReactionsPanel x:Name="Reactions"
                                         MaxWidth="{StaticResource MessageMaxWidth}"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center"
                                         Padding="0,4,0,0"
                                         Grid.Row="1" />
            </Grid>
        </ControlTemplate>
    </Button.Template>
    <StackPanel>
        <messages:MessageService Click="Service_Click"
                                 Margin="0,8,0,0"
                                 Padding="12,2,12,0"
                                 MaxWidth="480">
            <controls:FormattedTextBlock x:Name="Text"
                                         Foreground="#FFFFFF"
                                         TextAlignment="Center"
                                         Style="{StaticResource CaptionFormattedTextBlockStyle}"
                                         FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                         AutoFontSize="False"
                                         IsTextSelectionEnabled="False"
                                         HyperlinkStyle="None"
                                         HyperlinkForeground="#FFFFFF"
                                         HyperlinkFontWeight="SemiBold"
                                         Padding="0,0,0,4" />
        </messages:MessageService>

        <Grid x:Name="Card"
              Width="202">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{ThemeResource MessageServiceBackgroundBrush}"
                    BorderThickness="6"
                    CornerRadius="12"
                    Margin="0,4,0,0"
                    Grid.RowSpan="2" />

            <Border x:Name="CommentRoot"
                    x:Load="False"
                    Background="{ThemeResource MessageServiceBackgroundBrush}"
                    CornerRadius="0,0,12,12"
                    Margin="0,-16,0,0"
                    Padding="0,16,0,0"
                    Grid.Row="1">
                <controls:FormattedTextBlock x:Name="Comment"
                                             Foreground="#FFFFFF"
                                             IconForeground="#FFFFFF"
                                             TextAlignment="Center"
                                             HorizontalAlignment="Center"
                                             Style="{StaticResource CaptionFormattedTextBlockStyle}"
                                             FontFamily="{StaticResource EmojiThemeFontFamilyWithSymbols}"
                                             AutoFontSize="False"
                                             IsTextSelectionEnabled="False"
                                             HyperlinkStyle="None"
                                             HyperlinkForeground="#FFFFFF"
                                             HyperlinkFontWeight="SemiBold"
                                             Padding="0,0,0,4" />
            </Border>

            <Grid x:Name="Pattern"
                  Margin="4,8,4,4"
                  Padding="8,8,8,4"
                  CornerRadius="12"
                  Width="194">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <graphics:Scene3DPanel x:Name="Diamond"
                                       Model="Diamond"
                                       Palette="Cool"
                                       PressScale="3"
                                       PressScaleOrigin="0.5,0.1"
                                       IsSpinning="True"
                                       IsInteractive="True"
                                       FallbackText="&#xEA7E;"
                                       FallbackFontSize="24"
                                       FallbackFontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FallbackForeground="#FFFFFF"
                                       Width="36"
                                       Height="36"
                                       Canvas.ZIndex="1" />

                <TextBlock x:Name="Amount"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Style="{StaticResource BaseTextBlockStyle}"
                           FontFamily="ms-appx:///Assets/Fonts/Nunito.ttf#Nunito"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Grid.Row="1">
                    <Run x:Name="AmountInteger" /><Run x:Name="AmountFraction"
                                                       FontSize="14" />
                    <Run Text="GRAM"
                         Foreground="#6DDCFF" />
                </TextBlock>

                <TextBlock x:Name="Domain"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#6DDCFF"
                           FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                           FontSize="12"
                           Grid.Row="2" />
                <Grid Opacity="0.3"
                      Margin="0,4"
                      Grid.Row="3">
                    <Border x:Name="AddressShadow" />
                    <TextBlock x:Name="Address"
                               Foreground="#000000"
                               FontFamily="{ThemeResource EmojiThemeFontFamilyWithMonospace}"
                               FontSize="10"
                               HorizontalAlignment="Center" />
                </Grid>
            </Grid>

            <controls:Ribbon x:Name="Ribbon"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,6,2,0">
                <controls:Ribbon.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop x:Name="RibbonTop"
                                      Offset="0" />
                        <GradientStop x:Name="RibbonBottom"
                                      Offset="1" />
                    </LinearGradientBrush>
                </controls:Ribbon.Background>
            </controls:Ribbon>

            <!-- Where the clock is drawn while the transfer is being sent: over the ribbon, which
                 it turns into once it has been. Its own element because the ribbon's child visual
                 is its text. -->
            <Border x:Name="ClockHost"
                    Width="64"
                    Height="64"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,2,0" />
        </Grid>
    </StackPanel>
</messages:MessageService>
