<UserControl x:Class="Telegram.Controls.Chats.ChatThemeDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Telegram.Views.Popups"
             xmlns:cells="using:Telegram.Controls.Cells"
             xmlns:common="using:Telegram.Common"
             xmlns:controls="using:Telegram.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="{CustomResource SelectTheme}"
                   Style="{StaticResource BaseTextBlockStyle}"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />

        <controls:GlyphButton x:Name="Close"
                              HorizontalAlignment="Right"
                              Click="Close_Click"
                              Glyph="&#xE711;" />

        <ListView x:Name="ScrollingHost"
                  ChoosingItemContainer="OnChoosingItemContainer"
                  ContainerContentChanging="OnContainerContentChanging"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  Padding="12,0,10,0"
                  Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <cells:ChatThemeCell Width="87" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="controls:MultipleListViewItem">
                    <Setter Property="Padding"
                            Value="0" />
                    <Setter Property="CornerRadius"
                            Value="4" />
                    <Setter Property="Margin"
                            Value="0,0,4,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.Footer>
                <Border Width="8" />
            </ListView.Footer>
        </ListView>

        <Button x:Name="ApplyButton"
                Click="Apply_Click"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                MinWidth="180"
                Grid.Row="2" />

        <Button x:Name="WallpaperButton"
                Click="Wallpaper_Click"
                Style="{StaticResource AccentTextButtonStyle}"
                HorizontalAlignment="Center"
                Height="32"
                Grid.Row="2" />

        <Button x:Name="RemoveButton"
                Click="Remove_Click"
                Content="{CustomResource RestToDefaultBackground}"
                Style="{StaticResource DangerTextButtonStyle}"
                HorizontalAlignment="Center"
                Height="32"
                Margin="0,0,0,8"
                Grid.Row="3" />
    </Grid>
</UserControl>
