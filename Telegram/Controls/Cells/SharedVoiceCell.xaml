<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Telegram.Controls.Cells"
                    xmlns:controls="using:Telegram.Controls"
                    xmlns:native="using:Telegram.Native.Controls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">

    <Style TargetType="local:SharedVoiceCell">
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SharedVoiceCell">
                    <Grid Padding="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:FileButton x:Name="Button"
                                             VerticalAlignment="Top"
                                             Grid.RowSpan="2" />
                        <TextBlock x:Name="Title"
                                   Foreground="{ThemeResource MessageForegroundBrush}"
                                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BaseTextBlockStyle}"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,0"
                                   Grid.Column="1" />
                        <TextBlock x:Name="Subtitle"
                                   Style="{StaticResource DisabledCaptionTextBlockStyle}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Top"
                                   Margin="8,0,0,0"
                                   Grid.Column="1"
                                   Grid.Row="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
