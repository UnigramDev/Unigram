<native:GridEx x:Class="Telegram.Controls.Cells.SharedVoiceCell"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Telegram.Controls.Cells"
               xmlns:controls="using:Telegram.Controls"
               xmlns:native="using:Telegram.Native.Controls"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               mc:Ignorable="d"
               d:DesignHeight="300"
               d:DesignWidth="400"
               Padding="12,6">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border x:Name="ButtonRoot"
            Width="48"
            Height="48"
            CornerRadius="24"
            VerticalAlignment="Top">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource MessageMediaBackgroundBrush}" />
            </Style>
        </Border.Style>
        <controls:FileButton x:Name="Button"
                             Click="Button_Click"
                             Style="{StaticResource InlineFileButtonStyle}" />
    </Border>
    <StackPanel x:Name="TextRoot"
                Margin="8,0,0,2"
                VerticalAlignment="Center"
                Grid.Column="1">
        <TextBlock x:Name="Title"
                   Foreground="{ThemeResource MessageForegroundBrush}"
                   FontFamily="{ThemeResource EmojiThemeFontFamily}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   Style="{StaticResource BaseTextBlockStyle}" />
        <TextBlock x:Name="Subtitle"
                   Style="{StaticResource DisabledCaptionTextBlockStyle}"
                   Typography.NumeralAlignment="Tabular" />
    </StackPanel>
</native:GridEx>
