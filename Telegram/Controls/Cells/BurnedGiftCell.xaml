<UserControl x:Class="Telegram.Controls.Cells.BurnedGiftCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Telegram.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400"
             Width="64"
             Height="64">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto"
                           MinHeight="4" />
        </Grid.RowDefinitions>
        <Border Background="{ThemeResource SettingsItemBackground}"
                BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Grid.RowSpan="2" />
        <controls:PatternBackground x:Name="Pattern"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Grid.RowSpan="2">
            <Border Width="42" />
        </controls:PatternBackground>

        <controls:AnimatedImage x:Name="Animated"
                                Width="42"
                                Height="42"
                                FrameSize="42,42"
                                DecodeFrameType="Logical"
                                AutoPlay="True"
                                LoopCount="1"
                                Margin="4,12,4,4"
                                VerticalAlignment="Top" />

        <Viewbox HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Width="48">
            <controls:Ribbon x:Name="Ribbon"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,-1,-1,0">
                <controls:Ribbon.Background>
                    <LinearGradientBrush x:Name="RibbonGradient"
                                         StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop x:Name="RibbonTop"
                                      Color="#6ED2FF"
                                      Offset="0" />
                        <GradientStop x:Name="RibbonBottom"
                                      Color="#35A5FC"
                                      Offset="1" />
                    </LinearGradientBrush>
                </controls:Ribbon.Background>
            </controls:Ribbon>
        </Viewbox>
    </Grid>
</UserControl>
