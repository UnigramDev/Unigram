<ResourceDictionary  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:controls="using:Telegram.Controls"
               xmlns:local="using:Telegram.Controls.Cells"
               mc:Ignorable="d">

    <Style TargetType="local:SharedAudioCell">
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SharedAudioCell">
                    <Grid Padding="12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <controls:FileButton x:Name="Button"
                                             VerticalAlignment="Top"
                                             Grid.RowSpan="2" />
                        <Grid x:Name="DownloadRoot"
                              Width="24"
                              Height="24"
                              CornerRadius="12"
                              Margin="0,0,-6,-4"
                              BorderThickness="2"
                              BorderBrush="{ThemeResource MessageBackgroundBrush}"
                              Background="{ThemeResource MessageMediaBackgroundBrush}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              UseLayoutRounding="False"
                              Grid.RowSpan="2">
                            <controls:FileButton x:Name="Download"
                                                 IsSmall="True"
                                                 Style="{StaticResource StreamFileButtonStyle}" />
                        </Grid>

                        <Grid HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="8,0,0,0"
                              Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Title"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BaseTextBlockStyle}" />
                            <TextBlock x:Name="TitleTrim"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BaseTextBlockStyle}"
                                       Grid.Column="1" />
                        </Grid>
                        <TextBlock x:Name="Subtitle"
                                   Style="{StaticResource DisabledCaptionTextBlockStyle}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Top"
                                   Margin="8,0,0,0"
                                   Grid.Column="1"
                                   Grid.Row="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
