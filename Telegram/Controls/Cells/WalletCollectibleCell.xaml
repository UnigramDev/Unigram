<UserControl x:Class="Telegram.Controls.Cells.WalletCollectibleCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Telegram.Controls"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="120">

    <Grid>
        <Border Background="{ThemeResource SettingsItemBackground}"
                BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                BorderThickness="1"
                CornerRadius="4" />

        <controls:PatternBackground x:Name="Pattern"
                                    BorderBrush="{ThemeResource SettingsItemBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
            <Border Width="88" />
        </controls:PatternBackground>

        <controls:AnimatedImage x:Name="Animated"
                                Width="88"
                                Height="88"
                                FrameSize="88,88"
                                DecodeFrameType="Logical"
                                AutoPlay="False"
                                IsViewportAware="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

        <!-- Where the gift goes back to while it is out of the cell: its outline, in the colour of
             the backdrop's symbols. -->
        <Border x:Name="OutlineRoot"
                Width="88"
                Height="88"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        <!-- An NFT that is not a gift cannot go on the card: its picture fills the cell inside the
             border, and the name stands in for a picture it does not have. -->
        <Grid x:Name="PlainRoot"
              x:Load="False">
            <controls:ImageView x:Name="Photo"
                                Stretch="UniformToFill"
                                CornerRadius="3"
                                Margin="1" />
            <TextBlock x:Name="Title"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       Style="{StaticResource InfoCaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="8" />
        </Grid>

        <controls:Ribbon x:Name="Ribbon"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-1,-1,0">
            <controls:Ribbon.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,1">
                    <GradientStop x:Name="RibbonTop"
                                  Offset="0" />
                    <GradientStop x:Name="RibbonBottom"
                                  Offset="1" />
                </LinearGradientBrush>
            </controls:Ribbon.Background>
        </controls:Ribbon>
    </Grid>
</UserControl>
