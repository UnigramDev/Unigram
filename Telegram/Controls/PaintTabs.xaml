<Grid x:Class="Telegram.Controls.PaintTabs"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="using:Telegram.Controls"
            xmlns:drawers="using:Telegram.Controls.Drawers"
            xmlns:widgets="using:Telegram.Controls.Stories.Widgets"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d">

    <Grid.Resources>
        <!-- A tab: its icon and its name, brighter and heavier while it is the one open. -->
        <Style x:Key="EditorTabStyle"
               TargetType="controls:GlyphToggleButton">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="UncheckedForeground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="CheckedForeground"
                    Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding"
                    Value="12,0,12,0" />
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Width"
                    Value="Auto" />
            <Setter Property="CornerRadius"
                    Value="4" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="UseSystemFocusVisuals"
                    Value="True" />
            <Setter Property="FocusVisualMargin"
                    Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:GlyphToggleButton">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.15" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UncheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="CheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UncheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="CheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UncheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="CheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background"
                                                                           Storyboard.TargetName="RootGrid">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="UncheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="CheckedContent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel x:Name="UncheckedContent"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Glyph}"
                                           Foreground="{TemplateBinding UncheckedForeground}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding UncheckedForeground}"
                                                  FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                                  FontSize="14"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Laid out in every state, under the other: a tab is as wide as its
                                 heavier name, so choosing one moves no tab, nor the indicator. -->
                            <StackPanel x:Name="CheckedContent"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Opacity="0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding CheckedGlyph}"
                                           Foreground="{TemplateBinding CheckedForeground}"
                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding CheckedForeground}"
                                                  FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                                  FontWeight="SemiBold"
                                                  FontSize="14"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <StackPanel x:Name="TabsPanel"
                Orientation="Horizontal"
                Spacing="4"
                SizeChanged="TabsPanel_SizeChanged">
        <controls:GlyphToggleButton x:Name="CropTab"
                                    Click="CropTab_Click"
                                    Glyph="&#xF7AB;"
                                    CheckedGlyph="&#xF7AB;"
                                    Content="{CustomResource StoryCrop}"
                                    Style="{StaticResource EditorTabStyle}" />

        <controls:GlyphToggleButton x:Name="DrawTab"
                                    Click="DrawTab_Click"
                                    Glyph="&#xF7AC;"
                                    CheckedGlyph="&#xF7AC;"
                                    Content="{CustomResource PhotoEditorDraw}"
                                    Style="{StaticResource EditorTabStyle}" />

        <controls:GlyphToggleButton x:Name="TextTab"
                                    Click="TextTab_Click"
                                    Glyph="&#xF7AD;"
                                    CheckedGlyph="&#xF7AD;"
                                    Content="{CustomResource PhotoEditorText}"
                                    Style="{StaticResource EditorTabStyle}" />

        <controls:GlyphToggleButton x:Name="StickerTab"
                                    Click="StickerTab_Click"
                                    Glyph="&#xF7AE;"
                                    CheckedGlyph="&#xF7AE;"
                                    Content="{CustomResource StickersName}"
                                    Style="{StaticResource EditorTabStyle}">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="StickerFlyout"
                        Opened="StickerFlyout_Opened"
                        Placement="Bottom"
                        ShowMode="Transient">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter"
                               BasedOn="{StaticResource CommandFlyoutPresenterStyle}">
                            <Setter Property="Padding"
                                    Value="0" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <Grid Width="320"
                          Height="400">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:TopNavView x:Name="PickerTabs"
                                             SelectionChanged="PickerTabs_SelectionChanged"
                                             HorizontalAlignment="Center"
                                             Height="40"
                                             Grid.Row="1">
                            <controls:TopNavView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </controls:TopNavView.ItemsPanel>
                            <controls:TopNavView.ItemContainerStyle>
                                <Style TargetType="controls:TopNavViewItem">
                                    <Setter Property="Padding"
                                            Value="8,1,8,0" />
                                    <Setter Property="BorderThickness"
                                            Value="0,4,0,0" />
                                </Style>
                            </controls:TopNavView.ItemContainerStyle>
                            <controls:TopNavViewItem Content="{CustomResource AccDescrStickers}" />
                            <controls:TopNavViewItem Content="{CustomResource Emoji}" />
                            <controls:TopNavViewItem Content="{CustomResource AccDescrGIFs}" />
                        </controls:TopNavView>

                        <drawers:StickerDrawer x:Name="StickerPicker"
                                               x:Load="False"
                                               ItemClick="StickerPicker_ItemClick">
                            <drawers:StickerDrawer.Header>
                                <!-- The story widgets, which only the story editor shows. -->
                                <controls:WrapPanel x:Name="WidgetsPanel"
                                                    Visibility="Collapsed"
                                                    Orientation="Horizontal"
                                                    HorizontalContentAlignment="Center"
                                                    Margin="6,4,6,0">
                                    <Button x:Name="LinkWidget"
                                            Click="LinkWidget_Click"
                                            Height="40"
                                            Padding="8,4,8,4"
                                            Margin="4"
                                            AutomationProperties.Name="{CustomResource StoryWidgetLink}"
                                            ToolTipService.ToolTip="{CustomResource StoryWidgetLink}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock x:Name="LinkWidgetText"
                                                       FontFamily="Bahnschrift"
                                                       FontStretch="Condensed"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       TextLineBounds="Tight"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="LinkWidgetLock"
                                                       Text="&#xE9DD;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="12"
                                                       Visibility="Collapsed"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LocationWidget"
                                            Click="LocationWidget_Click"
                                            Height="40"
                                            Padding="8,4,8,4"
                                            Margin="4"
                                            AutomationProperties.Name="{CustomResource StoryWidgetLocation}"
                                            ToolTipService.ToolTip="{CustomResource StoryWidgetLocation}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE1C4;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock x:Name="LocationWidgetText"
                                                       FontFamily="Bahnschrift"
                                                       FontStretch="Condensed"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       TextLineBounds="Tight"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="WeatherWidget"
                                            Click="WeatherWidget_Click"
                                            Height="40"
                                            Padding="8,4,8,4"
                                            Margin="4">
                                        <StackPanel x:Name="WeatherWidgetContent"
                                                    SizeChanged="WeatherWidgetContent_SizeChanged"
                                                    Orientation="Horizontal">
                                            <controls:AnimatedImage x:Name="WeatherWidgetEmoji"
                                                                    AutoPlay="True"
                                                                    FrameSize="20,20"
                                                                    DecodeFrameType="Logical"
                                                                    Width="20"
                                                                    Height="20"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,4,0" />
                                            <TextBlock x:Name="WeatherWidgetText"
                                                       FontFamily="Bahnschrift"
                                                       FontStretch="Condensed"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       TextLineBounds="Tight"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PhotoWidget"
                                            Click="PhotoWidget_Click"
                                            Height="40"
                                            Padding="8,4,8,4"
                                            Margin="4"
                                            AutomationProperties.Name="{CustomResource StoryWidgetPhoto}"
                                            ToolTipService.ToolTip="{CustomResource StoryWidgetPhoto}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEB9F;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontSize="20"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0" />
                                            <TextBlock x:Name="PhotoWidgetText"
                                                       FontFamily="Bahnschrift"
                                                       FontStretch="Condensed"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       TextLineBounds="Tight"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ReactionWidget"
                                            Click="ReactionWidget_Click"
                                            Height="40"
                                            Padding="8,6,8,6"
                                            Margin="4"
                                            AutomationProperties.Name="{CustomResource Reactions}"
                                            ToolTipService.ToolTip="{CustomResource Reactions}">
                                        <widgets:StoryReactionWidget x:Name="ReactionWidgetPreview"
                                                                     Width="24"
                                                                     Height="24"
                                                                     Margin="0,0,0,2" />
                                    </Button>
                                </controls:WrapPanel>
                            </drawers:StickerDrawer.Header>
                        </drawers:StickerDrawer>

                        <drawers:ChatPhotoEmojiDrawer x:Name="EmojiPicker"
                                                      x:Load="False"
                                                      ItemClick="EmojiPicker_ItemClick" />

                        <drawers:AnimationDrawer x:Name="GifPicker"
                                                 x:Load="False"
                                                 ItemClick="GifPicker_ItemClick" />
                    </Grid>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </controls:GlyphToggleButton>

        <controls:GlyphToggleButton x:Name="ShapesTab"
                                    Click="ShapesTab_Click"
                                    Glyph="&#xF7AF;"
                                    CheckedGlyph="&#xF7AF;"
                                    Content="{CustomResource PaintShapes}"
                                    Style="{StaticResource EditorTabStyle}">
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="ShapesFlyout"
                            Opening="ShapesFlyout_Opening"
                            Placement="Bottom">
                    <MenuFlyoutItem x:Name="CircleItem"
                                    Click="ShapeItem_Click"
                                    Text="{CustomResource PaintCircle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon x:Name="CircleIcon"
                                      Glyph="&#xF7A4;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="RectangleItem"
                                    Click="ShapeItem_Click"
                                    Text="{CustomResource PaintRectangle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon x:Name="RectangleIcon"
                                      Glyph="&#xF7A6;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="StarItem"
                                    Click="ShapeItem_Click"
                                    Text="{CustomResource PaintStar}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon x:Name="StarIcon"
                                      Glyph="&#xE734;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="BubbleItem"
                                    Click="ShapeItem_Click"
                                    Text="{CustomResource PaintBubble}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon x:Name="BubbleIcon"
                                      Glyph="&#xE8BD;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="ArrowItem"
                                    Click="ShapeItem_Click"
                                    Text="{CustomResource PaintArrow}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xF7A0;"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <controls:MenuFlyoutContent>
                        <controls:MenuFlyoutContent.Content>
                            <CheckBox x:Name="ShapeFilled"
                                      Content="{CustomResource PaintShapeFilled}"
                                      Checked="ShapeFilled_Changed"
                                      Unchecked="ShapeFilled_Changed" />
                        </controls:MenuFlyoutContent.Content>
                    </controls:MenuFlyoutContent>
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
        </controls:GlyphToggleButton>
    </StackPanel>

    <!-- Under the open tab, moved there by the code. -->
    <Border x:Name="Indicator"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Width="16"
            Height="3"
            CornerRadius="1.5"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False" />
</Grid>
