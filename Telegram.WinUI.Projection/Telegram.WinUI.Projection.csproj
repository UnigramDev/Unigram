<!--
  The Windows App SDK, WebView2 and Win2D ship projections generated by CsWinRT 2, which CsWinRT 3 cannot
  load. This regenerates all of them as one CsWinRT 3 reference projection: the build emits only a
  reference assembly and a forwarder, and the app's own build generates the implementation from the
  .winmd files this project hands it.

  Microsoft.WinUI is the name the WinUI package's own projection has, kept so nothing that resolves it by
  name has to change.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Telegram.WinUI.Projection.props" />

  <PropertyGroup>
    <TargetFramework>$(TelegramWinUITargetFramework)</TargetFramework>
    <WindowsSdkPackageVersion>$(TelegramWindowsSdkPackageVersion)</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>Microsoft.WinUI</AssemblyName>
    <CsWinRTGenerateReferenceProjection>true</CsWinRTGenerateReferenceProjection>
    <!-- Generated code; the list is the one CsWinRT's own projections suppress. -->
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS1591;CS0219;CS0628;CS0660;CA2257</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(TelegramCsWinRTVersion)" />
  </ItemGroup>

  <!-- From CsWinRT's src/Projections/WinAppSDK/WinAppSDK.csproj (staging/3.0), less its exclusion of the
       WebView2 control, which projects and runs with WinAppSDK 2.6.5. The Windows.UI.Xaml attributes are
       ones the WinUI metadata references by mistake instead of their Microsoft.UI.Xaml counterparts. -->
  <PropertyGroup>
    <CsWinRTFilters>
      -exclude Windows
      -include Microsoft
      -include Windows.UI.Xaml.StyleTypedPropertyAttribute
      -include Windows.UI.Xaml.TemplatePartAttribute
      -include Windows.UI.Xaml.TemplateVisualStateAttribute
      -include Windows.UI.Xaml.Markup.FullXamlMetadataProviderAttribute
      -include Windows.UI.Xaml.Markup.MarkupExtensionReturnTypeAttribute
      -include Windows.UI.Xaml.Media.Animation.ConditionallyIndependentlyAnimatableAttribute
      -include Windows.UI.Xaml.Media.Animation.IndependentlyAnimatableAttribute
      -addition_exclude Windows.UI.Xaml.Media.Animation
    </CsWinRTFilters>
  </PropertyGroup>

  <ItemGroup>
    <CsWinRTInputs Include="@(TelegramProjectionWinMD)" />
  </ItemGroup>

</Project>
