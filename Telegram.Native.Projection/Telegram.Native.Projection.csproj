<!--
  The projection of the three local WinRT components. CsWinRT 3 projects a component from a library, not
  from the app that uses it: the app compiles against this reference assembly, and its merged projection
  step generates the implementation, as it does for Telegram.WinUI.Projection.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Telegram.WinUI.Projection\Telegram.WinUI.Projection.props" />

  <PropertyGroup>
    <TargetFramework>$(TelegramWinUITargetFramework)</TargetFramework>
    <WindowsSdkPackageVersion>$(TelegramWindowsSdkPackageVersion)</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <CsWinRTGenerateReferenceProjection>true</CsWinRTGenerateReferenceProjection>
    <CsWinRTIncludes>Telegram.Native</CsWinRTIncludes>
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS1591;CS0219;CS0628;CS0660;CA2257</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(TelegramCsWinRTVersion)" />
    <ProjectReference Include="..\Telegram.WinUI.Projection\Telegram.WinUI.Projection.csproj" />
    <ProjectReference Include="..\Telegram.Native\Telegram.Native.vcxproj" Private="false" />
    <ProjectReference Include="..\Telegram.Native.Calls\Telegram.Native.Calls.vcxproj" Private="false" />
    <ProjectReference Include="..\Telegram.Native.Widgets\Telegram.Native.Widgets.vcxproj" Private="false" />
  </ItemGroup>

  <!-- Metadata only, so the generator can resolve the Windows App SDK and Win2D types the components'
       signatures use; the default excludes keep them out of this projection. -->
  <ItemGroup>
    <CsWinRTInputs Include="@(TelegramProjectionWinMD)" />
  </ItemGroup>

</Project>
