<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The app has this on and shares NotifyIcon and Passkeys with this project. Without it here,
         interop that only works under runtime marshalling compiles clean and throws when the Win32
         flavour calls it. -->
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Win32Resource>Resources.res</Win32Resource>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BridgeApplicationContext.cs" />
    <Compile Include="Extensions.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="NotifyIcon.cs" />
    <!-- The icon itself is the app's, and this project draws the same one for the UWP
         flavour. NotifyIcon.cs beside this is only the half that needs the stub's own
         message loop. -->
    <Compile Include="..\Telegram\Common\NotifyIcon.Win32.cs" Link="NotifyIcon.Shared.cs" />
    <!-- webauthn.dll is called from here for the UWP flavour and from the app itself for the
         Win32 one, so the wrapper lives with the app and this project links it. -->
    <Compile Include="..\Telegram\Common\WebAuthn.Win32.cs" Link="WebAuthn.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" />
  </ItemGroup>

</Project>
