<?xml version="1.0" encoding="utf-8"?>
<!--
  The .NET Native host: same Suite.cs as the other two, on the toolchain the app actually ships.

  A legacy UWP project rather than a target framework of Telegram.Benchmarks, because this project
  format cannot multi-target and the SDK-style one cannot reach UseDotNetNativeToolchain. It also
  resolves System.Text.Json's netstandard2.0 asset, which is the one the app really runs and is not
  the same code as the net10.0 asset the other two hosts get.

  Build with MSBuild, not the dotnet CLI:
    msbuild Telegram.Benchmarks.NetNative.csproj /p:Configuration=Release /p:Platform=x64 /restore
-->
<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7B1E4C3A-6D52-4F18-9A7C-2E0B5D913F84}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <RootNamespace>Telegram.Benchmarks</RootNamespace>
    <AssemblyName>Telegram.Benchmarks.NetNative</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <ProjectTypeGuids>{A5A43C5B-DE2A-4C0C-9213-0A381AF9435A};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <LangVersion>14.0</LangVersion>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <ProjectPriIndexName>Telegram.Benchmarks.NetNative</ProjectPriIndexName>
    <Nullable>enable</Nullable>
    <TdPointerParser>true</TdPointerParser>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS8618;CS8601;CS8603;CS8604;CS8625;2008</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG;NETFX_CORE;WINDOWS_UWP;UWP;LEGACY_UWP</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseDotNetNativeToolchain>false</UseDotNetNativeToolchain>
  </PropertyGroup>

  <!-- The configuration that matters: this is what the app ships. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP;UWP;LEGACY_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>

  <!-- After the configuration blocks, which set DefineConstants outright. The property is what the
       generator reads, the constant is what the hand-written code reads; the app pairs them the
       same way. -->
  <PropertyGroup Condition="'$(TdPointerParser)' == 'true'">
    <DefineConstants>$(DefineConstants);TD_POINTER_PARSER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform">
      <Version>6.2.14</Version>
    </PackageReference>
    <PackageReference Include="System.Text.Json">
      <Version>10.0.10</Version>
    </PackageReference>
    <PackageReference Include="System.Memory">
      <Version>4.6.3</Version>
    </PackageReference>
  </ItemGroup>

  <!-- Same generator, same schema, same sources as the other two hosts. -->
  <ItemGroup>
    <ProjectReference Include="..\Telegram.Generators\Telegram.Generators.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Project>{b273f18c-527e-44e0-9f1c-1d6c5f932824}</Project>
      <Name>Telegram.Generators</Name>
    </ProjectReference>
    <AdditionalFiles Include="..\Libraries\tdjson\td_api.tl" />
    <CompilerVisibleProperty Include="TdPointerParser" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Telegram\Td\ClientJson.cs" Link="Linked\ClientJson.cs" />
    <Compile Include="..\Telegram\Common\ArrayPoolBufferWriter.cs" Link="Linked\ArrayPoolBufferWriter.cs" />
    <Compile Include="..\Telegram.Benchmarks\AltParsers.g.cs" Link="Linked\AltParsers.g.cs" />
    <Compile Include="..\Telegram.Benchmarks\Bridge.cs" Link="Linked\Bridge.cs" />
    <Compile Include="..\Telegram.Benchmarks\Corpus.cs" Link="Linked\Corpus.cs" />
    <Compile Include="..\Telegram.Benchmarks\Harness.cs" Link="Linked\Harness.cs" />
    <Compile Include="..\Telegram.Benchmarks\NativeTd.cs" Link="Linked\NativeTd.cs" />
    <Compile Include="..\Telegram.Benchmarks\Suite.cs" Link="Linked\Suite.cs" />
    <Compile Include="..\Telegram.Benchmarks\Validation.cs" Link="Linked\Validation.cs" />
    <Compile Include="..\Telegram\Td\TdJsonReader.cs" Link="Linked\TdJsonReader.cs" />
    <Compile Include="..\Telegram\Td\PtrClientJson.cs" Link="Linked\PtrClientJson.cs" />
    <Compile Include="..\Telegram.Benchmarks\Json\PointerParsers.cs" Link="Linked\PointerParsers.cs" />
    <Compile Include="..\Telegram.Benchmarks\Support.cs" Link="Linked\Support.cs" />
    <Compile Include="..\Telegram.Benchmarks\Uwp\UwpHost.cs" Link="Linked\UwpHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Telegram.Benchmarks\Corpus\synthetic.jsonl">
      <Link>Corpus\synthetic.jsonl</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Telegram.Benchmarks\Corpus\synthetic-escapes.jsonl">
      <Link>Corpus\synthetic-escapes.jsonl</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Telegram.Benchmarks\Fixtures\message.json">
      <Link>Fixtures\message.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Telegram.Benchmarks\Fixtures\localFile.json">
      <Link>Fixtures\localFile.json</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Assets\**" />
    <Content Include="..\Libraries\tdjson\x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
